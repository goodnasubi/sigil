module std.os.clock
  targets server
  trust base

// Linux x86-64 の OS 壁時計の最小境界（ADR 0037 段階 6-6a）。
// clock_gettime(CLOCK_REALTIME) で Unix 秒を取得する。
pub fn os_clock_realtime_seconds() -> Result<Int, Int>
  intent "clock_gettime(CLOCK_REALTIME = 0) を発行し、Unix 秒を取得する。失敗時は負の errno を Err で返す"
  requires none
  ensures none
  effects clock
  unchecked "16 バイトの timespec 領域（8 バイトの tv_sec と 8 バイトの tv_nsec）を確保し、clock_gettime(0, ts) だけを発行する。戻る前に確保領域を解放し、失敗時は負の戻り値を Err として返す"
{
  let ts = raw.alloc(16, 8);
  raw.set(ts, 0, 16);
  let r = raw.syscall(228, 0, raw.addr_to_int(ts), 0, 0, 0, 0);
  if r != 0 {
    raw.free(ts, 16, 8);
    return Err(r);
  }
  let sec = raw.load_i64(ts);
  raw.free(ts, 16, 8);
  return Ok(sec);
}

// Unix 秒を取得する最小壁時計入口（ADR 0037 段階 6-6a）。
// 取得失敗および範囲外（0..=253402300799）は None を返し、推測値や 0 で成功させない。
pub fn unix_seconds() -> Option<Int>
  intent "OS 壁時計から Unix 秒を取得し、有効範囲内の場合のみ Some で返す"
  requires none
  ensures none
  effects clock
{
  match os_clock_realtime_seconds() {
    Ok(sec) => {
      if sec >= 0 && sec <= 253402300799 {
        return Some(sec);
      }
      return None;
    }
    Err(_) => {
      return None;
    }
  }
}

// I/O スケジューラと公開 API が共有する実時間の時計取得。
// スケジューラ内部の効果は従来どおり。アプリの clock 効果は公開 API の名前空間表で検査する。
pub fn monotonic_nanos() -> Option<Int>
  intent "clock_gettime(CLOCK_MONOTONIC = 1) の時刻を整数ナノ秒で返す。取得失敗または Int の範囲外は None"
  requires none
  ensures none
  effects none
  unchecked "16 バイトの timespec 領域を確保して clock_gettime(1, ts) を発行する。成功時だけ 2 語を読み、どちらの経路でも領域を解放する"
{
  let ts = raw.alloc(16, 8);
  let addr = raw.addr_to_int(ts);
  let r = raw.syscall(228, 1, addr, 0, 0, 0, 0);
  if r != 0 {
    raw.free(ts, 16, 8);
    return None;
  }
  let sec = raw.load_i64(ts);
  let nanos = raw.load_i64(raw.int_to_addr(addr + 8));
  raw.free(ts, 16, 8);
  if sec < 0 || sec > 9223372036 || nanos < 0 || nanos >= 1000000000 {
    return None;
  }
  let whole = sec * 1000000000;
  if nanos > 9223372036854775807 - whole {
    return None;
  }
  return Some(whole + nanos);
}
