module std.os.alloc
  targets server
  trust base

// Sigil 製の確保器（ADR 0025 決定 3、補足 A-4・A-5・B-1）。ネイティブの `raw.alloc` / `raw.free` の実体。
// 評価器の `raw.alloc` / `raw.free` は組み込みのまま（補足 A-2）で、ここは呼ばない。
//
// - 小ブロック（size <= 2048 かつ align <= 16）: サイズクラス 16〜2048（16 << k、k = 0..7）。
//   ブロックは頭 16B + クラスの大きさで、4096B のページを mmap して切り分ける。
// - 大ブロック（それ以外）: 直接 mmap。align <= 16 は base + 16、align > 16 は base + align を返す。
//   align > 16 は ret-32 に base、ret-24 に map_len を置く（B-1）。
// - 頭（ret-16）: magic|class の語と size の語。class は 0..7 が小ブロック、8 が align <= 16 の大ブロック、
//   9 が align > 16 の大ブロック。解放済みの小ブロックは FREED|class。
// - 状態のページ（STATE）: 0..63 に各クラスの空きリストの先頭、64 に表の番地、72 に表の長さ、80 に表の容量、88 に索引の番地、96 に索引の大きさ（2 の冪。語の値は項目の番号 + 1、0 は空き）。
// - 表: 1 項目 16B（鍵, 印）。印 -1 は生きた大ブロック（鍵は返却番地）、0..7 はスラブのページ（鍵はページの先頭、
//   印はクラス）。解放時に番地を表で引いてから頭を読むので、解放済みの大ブロックや確保器の外の番地の頭を読まない
//   （SIGSEGV に頼らない。A-4）。
// - 異常停止はすべて exit_group(70)（A-4）。検査は状態の書き換えより前に終える。
// - 排他（ADR 0030 決定 6、PR 5-2b）: 公開の入口（`alloc`・`free`・`live_blocks`）は、状態のページの最後の語（4088）に置いた
//   ロックの語を `atomic_cas_i64` で取り、`atomic_store_i64` で放して、内側の `*_locked` を囲む。ロックは 1 本で、競合時は `futex` で眠り、
//   解放時に待機者を起こす（PR 5-2e）。ロックの語は状態のページの中にあるので、
//   状態のページを作る最初の呼び出しだけは排他の外で起こる。**最初の呼び出しは、最初のスレッドを作るより前に行う**（前提。5-2c の
//   スレッドの作成が、作る前に確保器を一度呼ぶ）。`halt()`（`exit_group(70)`）はプロセス全体を終えるので、ロックを放さなくてよい。

global MAGIC: Int = 0x5349474C414C0000
global FREED: Int = 0x5349474C46520000
global CLASS_LARGE: Int = 8
global CLASS_LARGE_ALIGNED: Int = 9
global MAX_SIZE: Int = 0x400000000000
global mut STATE: Addr = raw.addr_null()
global mut LIVE: Int = 0
global LOCK_AT: Int = 4088

fn halt()
  intent "異常停止する（exit_group(70)）"
  requires none
  ensures none
  effects none
  unchecked "exit_group(70) を発行し、戻らない（ADR 0025 補足 A-4）"
{
  raw.syscall(231, 70, 0, 0, 0, 0, 0);
}

fn round_page(n: Int) -> Int
  intent "n を 4096 の倍数に切り上げる"
  requires none
  ensures none
  effects none
{
  return (n + 4095) / 4096 * 4096;
}

fn valid_align(align: Int) -> Bool
  intent "align が 2 の冪かつ 1 以上 4096 以下か"
  requires none
  ensures none
  effects none
{
  return align >= 1 && align <= 4096 && (align & (align - 1)) == 0;
}

fn class_of(size: Int) -> Int
  intent "size（1..=2048）が入る最小のサイズクラスの番号"
  requires none
  ensures none
  effects none
{
  let mut k = 0;
  while (16 << k) < size {
    k = k + 1;
  }
  return k;
}

fn map(len: Int) -> Int
  intent "len バイト（4096 の倍数）を mmap し、先頭の番地を返す。失敗は異常停止"
  requires none
  ensures none
  effects none
  unchecked "mmap を PROT_READ|PROT_WRITE、MAP_PRIVATE|MAP_ANONYMOUS で発行する（補足 A-3・B-6）"
{
  let r = raw.syscall(9, 0, len, 3, 34, -1, 0);
  if r >= -4095 && r <= -1 {
    halt();
    return 0;
  }
  return r;
}

fn unmap(base: Int, len: Int)
  intent "mmap で得た範囲を munmap する。失敗は異常停止"
  requires none
  ensures none
  effects none
  unchecked "base と len は map で得た範囲と完全に一致する（補足 A-3）"
{
  let r = raw.syscall(11, base, len, 0, 0, 0, 0);
  if r != 0 {
    halt();
  }
}

fn state() -> Addr
  intent "状態のページを返す（初回に mmap する）"
  requires none
  ensures none
  effects none
  unchecked "確保器の排他の下で呼ばれ（公開の入口がロックを取る。ADR 0030 決定 6）、中断点を持たない。大域 STATE を読み書きするため、同じ引数でも初回かどうかで動作が変わる"
{
  if raw.addr_to_int(STATE) == 0 {
    STATE = raw.int_to_addr(map(4096));
  }
  return STATE;
}

fn bucket_home(key: Int, size: Int) -> Int
  intent "鍵の番地が索引（大きさ size）の中で始まる位置。ページの番地（4096 の倍数）も大ブロックの番地も散らす"
  requires none
  ensures none
  effects none
{
  let x = key / 4096 % 1000003;
  return (x * 1009 + key % 4096 / 16) % size;
}

fn index_put(idx: Addr, size: Int, key: Int, val: Int)
  intent "索引に（項目の番号 + 1）を入れる。空きの位置を線形に探す（索引は項目の数の 2 倍以上あり、空きが必ずある）"
  requires none
  ensures none
  effects none
  unchecked "idx は size 個の語で、size >= 2 * 項目の数（補足 A-5）"
{
  let mut h = bucket_home(key, size);
  while raw.load_i64(raw.offset(idx, 8 * h)) != 0 {
    h = (h + 1) % size;
  }
  raw.store_i64(raw.offset(idx, 8 * h), val);
}

fn index_slot(idx: Addr, size: Int, key: Int, val: Int) -> Int
  intent "索引で、鍵 key から始めて値 val の位置を返す（ないときは -1）"
  requires none
  ensures none
  effects none
  unchecked "idx は size 個の語（補足 A-5）"
{
  let mut h = bucket_home(key, size);
  let mut probes = 0;
  while probes < size {
    let v = raw.load_i64(raw.offset(idx, 8 * h));
    if v == val {
      return h;
    }
    if v == 0 {
      return -1;
    }
    h = (h + 1) % size;
    probes = probes + 1;
  }
  return -1;
}

fn tbl_find(key: Int, large: Bool) -> Int
  intent "表で鍵を引き、項目の番号を返す（ないときは -1）。large なら印 -1 の項目、でなければ印 0..7 の項目だけを見る。索引で引くので、項目の数によらず速い"
  requires none
  ensures none
  effects none
  unchecked "表と索引は状態のページが指す生きた mmap の範囲で、項目の数までは書き込み済み（補足 A-5）"
{
  let st = state();
  let n = raw.load_i64(raw.offset(st, 72));
  if n == 0 {
    return -1;
  }
  let t = raw.load_addr(raw.offset(st, 64));
  let idx = raw.load_addr(raw.offset(st, 88));
  let size = raw.load_i64(raw.offset(st, 96));
  let mut h = bucket_home(key, size);
  let mut probes = 0;
  while probes < size {
    let v = raw.load_i64(raw.offset(idx, 8 * h));
    if v == 0 {
      return -1;
    }
    let i = v - 1;
    let e = raw.offset(t, 16 * i);
    if raw.load_i64(e) == key {
      let tag = raw.load_i64(raw.offset(e, 8));
      if (large && tag == -1) || (!large && tag >= 0) {
        return i;
      }
    }
    h = (h + 1) % size;
    probes = probes + 1;
  }
  return -1;
}

fn tbl_add(key: Int, tag: Int)
  intent "表に項目を足す（満杯なら倍の大きさに作り直す。索引も項目の 2 倍の大きさに作り直す）"
  requires none
  ensures none
  effects none
  unchecked "表と索引の作り直しは新しい mmap に写してから古い範囲を munmap する（補足 A-5）"
{
  let st = state();
  let mut t = raw.load_addr(raw.offset(st, 64));
  let n = raw.load_i64(raw.offset(st, 72));
  let cap = raw.load_i64(raw.offset(st, 80));
  if n == cap {
    let mut ncap = 256;
    if cap > 0 {
      ncap = cap * 2;
    }
    let nt = raw.int_to_addr(map(ncap * 16));
    if cap > 0 {
      raw.copy(nt, t, n * 16);
      unmap(raw.addr_to_int(t), cap * 16);
    }
    t = nt;
    raw.store_addr(raw.offset(st, 64), t);
    raw.store_i64(raw.offset(st, 80), ncap);
    // 索引は項目の数の 2 倍（2 の冪）。作り直して、既存の項目を入れ直す。
    let oldidx = raw.load_addr(raw.offset(st, 88));
    let oldsize = raw.load_i64(raw.offset(st, 96));
    let size = ncap * 2;
    let idx = raw.int_to_addr(map(size * 8));
    let mut j = 0;
    while j < n {
      let kj = raw.load_i64(raw.offset(t, 16 * j));
      index_put(idx, size, kj, j + 1);
      j = j + 1;
    }
    if oldsize > 0 {
      unmap(raw.addr_to_int(oldidx), oldsize * 8);
    }
    raw.store_addr(raw.offset(st, 88), idx);
    raw.store_i64(raw.offset(st, 96), size);
  }
  let e = raw.offset(t, 16 * n);
  raw.store_i64(e, key);
  raw.store_i64(raw.offset(e, 8), tag);
  let size = raw.load_i64(raw.offset(st, 96));
  let idx = raw.load_addr(raw.offset(st, 88));
  index_put(idx, size, key, n + 1);
  raw.store_i64(raw.offset(st, 72), n + 1);
}

fn tbl_remove(i: Int)
  intent "表の i 番の項目を、最後の項目で埋めて除く（索引も直す）"
  requires none
  ensures none
  effects none
  unchecked "i は tbl_find が返した有効な番号（補足 A-5）"
{
  let st = state();
  let t = raw.load_addr(raw.offset(st, 64));
  let n = raw.load_i64(raw.offset(st, 72));
  let idx = raw.load_addr(raw.offset(st, 88));
  let size = raw.load_i64(raw.offset(st, 96));
  let ki = raw.load_i64(raw.offset(t, 16 * i));
  // 1. 索引から i 番の位置を消し、後ろの項目を前へ詰める（開番地法の削除）。
  let s = index_slot(idx, size, ki, i + 1);
  if s < 0 {
    halt();
    return;
  }
  raw.store_i64(raw.offset(idx, 8 * s), 0);
  let mut hole = s;
  let mut j = (s + 1) % size;
  while raw.load_i64(raw.offset(idx, 8 * j)) != 0 {
    let vj = raw.load_i64(raw.offset(idx, 8 * j));
    let kj = raw.load_i64(raw.offset(t, 16 * (vj - 1)));
    let home = bucket_home(kj, size);
    let dist_home = (j + size - home) % size;
    let dist_hole = (j + size - hole) % size;
    if dist_home >= dist_hole {
      raw.store_i64(raw.offset(idx, 8 * hole), vj);
      raw.store_i64(raw.offset(idx, 8 * j), 0);
      hole = j;
    }
    j = (j + 1) % size;
  }
  // 2. 最後の項目を i 番へ移し、索引の指す先を直す。
  let last = n - 1;
  if i != last {
    let kl = raw.load_i64(raw.offset(t, 16 * last));
    let sl = index_slot(idx, size, kl, n);
    if sl < 0 {
      halt();
      return;
    }
    raw.store_i64(raw.offset(idx, 8 * sl), i + 1);
    let e = raw.offset(t, 16 * i);
    raw.store_i64(e, kl);
    raw.store_i64(raw.offset(e, 8), raw.load_i64(raw.offset(t, 16 * last + 8)));
  }
  raw.store_i64(raw.offset(st, 72), n - 1);
}

fn refill(k: Int)
  intent "クラス k のスラブのページを 1 枚 mmap し、ブロックを空きリストに積む"
  requires none
  ensures none
  effects none
  unchecked "確保器の排他の下で呼ばれ（公開の入口がロックを取る。ADR 0030 決定 6）、中断点を持たない。ページは表に印 k で登録し、返さない"
{
  let st = state();
  let bs = (16 << k) + 16;
  let page = map(4096);
  tbl_add(page, k);
  let slot = raw.offset(st, 8 * k);
  let mut i = 4096 / bs - 1;
  while i >= 0 {
    let h = raw.int_to_addr(page + i * bs);
    raw.store_i64(h, FREED + k);
    let user = raw.offset(h, 16);
    raw.store_addr(user, raw.load_addr(slot));
    raw.store_addr(slot, user);
    i = i - 1;
  }
}

fn small_alloc(size: Int) -> Addr
  intent "小ブロックを空きリストから取る"
  requires none
  ensures none
  effects none
  unchecked "確保器の排他の下で呼ばれ（公開の入口がロックを取る。ADR 0030 決定 6）、中断点を持たない。大域 LIVE を書き換えるため非決定的"
{
  let k = class_of(size);
  let st = state();
  let slot = raw.offset(st, 8 * k);
  if raw.addr_to_int(raw.load_addr(slot)) == 0 {
    refill(k);
  }
  let b = raw.load_addr(slot);
  let h = raw.offset(b, -16);
  if raw.load_i64(h) != FREED + k {
    halt();
    return raw.addr_null();
  }
  raw.store_addr(slot, raw.load_addr(b));
  raw.store_i64(h, MAGIC + k);
  raw.store_i64(raw.offset(h, 8), size);
  LIVE = LIVE + 1;
  return b;
}

fn large_alloc(size: Int, align: Int) -> Addr
  intent "大ブロックを直接 mmap する（補足 B-1）"
  requires none
  ensures none
  effects none
  unchecked "確保器の排他の下で呼ばれ（公開の入口がロックを取る。ADR 0030 決定 6）、中断点を持たない。大域 LIVE を書き換えるため非決定的"
{
  let mut ret = 0;
  if align <= 16 {
    let len = round_page(16 + size);
    let base = map(len);
    ret = base + 16;
    let h = raw.int_to_addr(base);
    raw.store_i64(h, MAGIC + CLASS_LARGE);
    raw.store_i64(raw.offset(h, 8), size);
  } else {
    let len = round_page(align + 16 + size);
    let base = map(len);
    ret = (base + 16 + align - 1) / align * align;
    let m = raw.int_to_addr(ret - 32);
    raw.store_i64(m, base);
    raw.store_i64(raw.offset(m, 8), len);
    raw.store_i64(raw.offset(m, 16), MAGIC + CLASS_LARGE_ALIGNED);
    raw.store_i64(raw.offset(m, 24), size);
  }
  tbl_add(ret, -1);
  LIVE = LIVE + 1;
  return raw.int_to_addr(ret);
}

fn alloc_locked(size: Int, align: Int) -> Addr
  intent "size バイト・align 境界の領域を確保する（排他の下で呼ぶ本体）"
  requires none
  ensures none
  effects none
  unchecked "確保器の排他の下で呼ばれ（公開の入口がロックを取る。ADR 0030 決定 6）、中断点を持たない。大域の状態を書き換えるため、同じ引数でも返る番地は呼び出しの履歴による"
{
  if size <= 0 || size > MAX_SIZE {
    halt();
    return raw.addr_null();
  }
  if !valid_align(align) {
    halt();
    return raw.addr_null();
  }
  if align <= 16 && size <= 2048 {
    return small_alloc(size);
  }
  return large_alloc(size, align);
}

fn large_free(a: Int, size: Int, i: Int)
  intent "表の i 番に登録された大ブロックを返す（補足 B-1）"
  requires none
  ensures none
  effects none
  unchecked "a は表に印 -1 で登録された生きた大ブロックで、頭は読める。整列の大ブロックの {base, len} は a % 32 == 0 を確かめてから読む（補足 A-5）"
{
  let h = raw.int_to_addr(a - 16);
  let w = raw.load_i64(h);
  if raw.load_i64(raw.offset(h, 8)) != size {
    halt();
    return;
  }
  let mut base = 0;
  let mut len = 0;
  if w == MAGIC + CLASS_LARGE {
    base = a - 16;
    len = round_page(16 + size);
  } else if w == MAGIC + CLASS_LARGE_ALIGNED {
    // 整列の大ブロックは a が 32 の倍数で a - base >= 32。頭を読む前に確かめ、
    // class 8 の塊（a % 4096 == 16）を 9 と偽った頭で塊の外 a - 32 を読まない。
    if a % 32 != 0 {
      halt();
      return;
    }
    base = raw.load_i64(raw.int_to_addr(a - 32));
    len = raw.load_i64(raw.int_to_addr(a - 24));
    let d = a - base;
    // 正しい塊では d == align で、map_len = round_up(align + 16 + size)（補足 B-1）。等式で確かめる。
    if d < 32 || d > 4096 || len != round_page(d + 16 + size) {
      halt();
      return;
    }
  } else {
    halt();
    return;
  }
  if base % 4096 != 0 {
    halt();
    return;
  }
  tbl_remove(i);
  unmap(base, len);
  LIVE = LIVE - 1;
}

fn small_free(a: Int, size: Int)
  intent "小ブロックを空きリストに戻す"
  requires none
  ensures none
  effects none
  unchecked "a はスラブのページの中のブロックの先頭 + 16 であることを表で確かめてから頭を読む（補足 A-5）"
{
  if a < 16 {
    halt();
    return;
  }
  let off = (a - 16) % 4096;
  let page = a - 16 - off;
  let j = tbl_find(page, false);
  if j < 0 {
    halt();
    return;
  }
  let st = state();
  let t = raw.load_addr(raw.offset(st, 64));
  let k = raw.load_i64(raw.offset(raw.offset(t, 16 * j), 8));
  let bs = (16 << k) + 16;
  if off % bs != 0 || off / bs >= 4096 / bs {
    halt();
    return;
  }
  let h = raw.int_to_addr(a - 16);
  let w = raw.load_i64(h);
  if w == FREED + k {
    halt();
    return;
  }
  if w != MAGIC + k || raw.load_i64(raw.offset(h, 8)) != size {
    halt();
    return;
  }
  raw.store_i64(h, FREED + k);
  let slot = raw.offset(st, 8 * k);
  raw.store_addr(raw.int_to_addr(a), raw.load_addr(slot));
  raw.store_addr(slot, raw.int_to_addr(a));
  LIVE = LIVE - 1;
}

fn free_locked(a: Addr, size: Int, align: Int)
  intent "alloc で得た領域を返す（排他の下で呼ぶ本体）"
  requires none
  ensures none
  effects none
  unchecked "確保器の排他の下で呼ばれ（公開の入口がロックを取る。ADR 0030 決定 6）、中断点を持たない。align は範囲と 2 の冪だけを検査し、確保時の align とは突き合わせない（補足 A-4・B-1）"
{
  let ai = raw.addr_to_int(a);
  if ai == 0 || size <= 0 || size > MAX_SIZE {
    halt();
    return;
  }
  if !valid_align(align) {
    halt();
    return;
  }
  let i = tbl_find(ai, true);
  if i >= 0 {
    large_free(ai, size, i);
    return;
  }
  small_free(ai, size);
}

fn lock_addr() -> Addr
  intent "ロックの語の番地（状態のページの最後の語）"
  requires none
  ensures none
  effects none
  unchecked "状態のページは state() が返す 4096 バイトの領域で、LOCK_AT（4088）の語は他の用途に使わない。state() の初回だけは排他の外で起こる（最初の呼び出しはスレッドを作る前。ADR 0030 決定 6）"
{
  return raw.offset(state(), LOCK_AT);
}

fn lock()
  intent "確保器のロックを取る（futex で待つ。逐次一貫の比較交換）"
  requires none
  ensures none
  effects none
  unchecked "lock_addr() の語は 8 バイト整列で、0（空き）か 1（取得済み）だけが入る。取ったら必ず unlock() で放す（halt() で終える経路を除く）。同じスレッドでの再入は待ち続けて戻らない（入口は alloc・free・live_blocks だけで、内側から呼ばない）"
{
  let l = lock_addr();
  while raw.atomic_cas_i64(l, 0, 1) != 0 {
    raw.syscall(202, raw.addr_to_int(l), 128, 1, 0, 0, 0);
  }
}

fn unlock()
  intent "確保器のロックを放す"
  requires none
  ensures none
  effects none
  unchecked "lock() で取ったスレッドだけが呼ぶ。lock_addr() の語は 8 バイト整列で、書くのは 0（空き）だけ"
{
  let l = lock_addr();
  raw.atomic_store_i64(l, 0);
  raw.syscall(202, raw.addr_to_int(l), 129, 1, 0, 0, 0);
}

pub fn alloc(size: Int, align: Int) -> Addr
  intent "size バイト・align 境界の領域を確保する（ネイティブの raw.alloc の実体）。排他の下で行う"
  requires none
  ensures none
  effects none
  unchecked "ロックを取って alloc_locked を呼び、放してから戻す。最初の呼び出しはスレッドを作る前に行う（ADR 0030 決定 6）。大域の状態を書き換えるため、同じ引数でも返る番地は呼び出しの履歴による"
{
  state();
  lock();
  let r = alloc_locked(size, align);
  unlock();
  return r;
}

pub fn free(a: Addr, size: Int, align: Int)
  intent "alloc で得た領域を返す（ネイティブの raw.free の実体）。排他の下で行う"
  requires none
  ensures none
  effects none
  unchecked "ロックを取って free_locked を呼び、放してから戻す。align は範囲と 2 の冪だけを検査し、確保時の align とは突き合わせない（補足 A-4・B-1）"
{
  state();
  lock();
  free_locked(a, size, align);
  unlock();
}

pub fn live_blocks() -> Int
  intent "生きているブロックの数（SIGIL_RT_LIVE の sigil_blocks=）。排他の下で読む"
  requires none
  ensures none
  effects none
  unchecked "状態のページがまだ無ければ（一度も確保していない）LIVE は 0 のままなので、ロックを取らずに LIVE を返す（状態のページを作らない）。あれば lock() で守って LIVE を読む。大域 LIVE を読むため非決定的"
{
  if raw.addr_to_int(STATE) == 0 {
    return LIVE;
  }
  lock();
  let n = LIVE;
  unlock();
  return n;
}
