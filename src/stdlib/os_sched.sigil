fn mutex_lock()
  intent "共有の状態と FIFO を futex の排他で守る"
  requires none
  ensures none
  effects none
  unchecked "SCHED はワーカー作成前に初期化済み。語は 8 バイト整列、再入しない。futex は下位 32 ビットを使う"
{
  let s = sched();
  let a = raw.int_to_addr(s + 8 * S_MUTEX);
  if raw.atomic_cas_i64(a, 0, 1) == 0 { return; }
  while raw.atomic_swap_i64(a, 2) != 0 {
    raw.syscall(202, raw.addr_to_int(a), 128, 2, 0, 0, 0);
  }
}

fn mutex_unlock()
  intent "排他を放して待ち手を起こす"
  requires none
  ensures none
  effects none
  unchecked "このワーカーが mutex_lock で取得済み"
{
  let a = raw.int_to_addr(SCHED + 8 * S_MUTEX);
  if raw.atomic_swap_i64(a, 0) == 2 {
    raw.syscall(202, raw.addr_to_int(a), 129, 1, 0, 0, 0);
  }
}

fn notify()
  intent "状態の変化を待つワーカーを起こす（世代番号で通知の取りこぼしを防ぐ）"
  requires none
  ensures none
  effects none
  unchecked "SCHED の排他を取得済み。世代番号は 32 ビットで循環する"
{
  let a = raw.int_to_addr(SCHED + 8 * S_EVENT);
  let next = (raw.atomic_load_i64(a) + 1) & 4294967295;
  raw.atomic_store_i64(a, next);
  raw.syscall(202, raw.addr_to_int(a), 129, 2147483647, 0, 0, 0);
}

fn wait_event(s: Int)
  intent "世代を読んで排他を放し、変化まで futex で眠る。戻る前に排他を取り直す"
  requires none
  ensures none
  effects none
  unchecked "SCHED の排他を取得済み。比較と待機は futex が不可分に行い、割り込み・偽の起床では呼び出し側が条件を再確認する"
{
  let a = raw.int_to_addr(s + 8 * S_EVENT);
  let version = raw.atomic_load_i64(a);
  mutex_unlock();
  raw.syscall(202, raw.addr_to_int(a), 128, version, 0, 0, 0);
  mutex_lock();
}

fn wait_io(s: Int)
  intent "実時間モード: 世代を読んでから完了を調べ、起こすものがなければ排他を放して futex で眠る（読んだ後に届いた完了は世代が変わるので取りこぼさない）"
  requires none
  ensures none
  effects none
  unchecked "SCHED の排他を取得済み。比較と待機は futex が不可分に行い、割り込み・偽の起床では呼び出し側が条件を再確認する"
{
  let a = raw.int_to_addr(s + 8 * S_EVENT);
  let version = raw.atomic_load_i64(a);
  io_poll_locked(s);
  if ld(s, S_RHEAD) != 0 { return; }
  // この確認が期限の完了を消費して S_TIMER_AT を 0 にしたかもしれない（arm_timer は消費の前に「登録済み」と見て省いた）。
  // 眠りが残るなら、眠る前に必ず登録し直す。世代は登録の前に読んであるので、これ以後に届く通知は取りこぼさない。
  arm_timer(s);
  mutex_unlock();
  raw.syscall(202, raw.addr_to_int(a), 128, version, 0, 0, 0);
  mutex_lock();
}

pub fn step_end()
  intent "枠の保存・破棄・指紋の計算が終わってから、他のワーカーへの受け渡しを許す"
  requires none
  ensures none
  effects none
{
  mutex_lock();
  let s = sched();
  let t = ld(s, S_CUR);
  if t != 0 && ld(t, T_ACTIVE) != 0 {
    st(t, T_ACTIVE, 0);
    st(s, S_ACTIVE, ld(s, S_ACTIVE) - 1);
  }
  st(s, S_CUR, 0);
  notify();
  mutex_unlock();
}

pub fn stopped() -> Int
  intent "停止の符号、または正常完了なら -1 を返す。実行中は 0"
  requires none
  ensures none
  effects none
{
  mutex_lock();
  let s = sched();
  let mut outcome = ld(s, S_STOP);
  if outcome == 0 && ld(s, S_RDONE) != 0 { outcome = 0 - 1; }
  mutex_unlock();
  return outcome;
}

pub fn fail(code: Int)
  intent "最初の停止を記録し、ワーカー全員に知らせる。失敗した枠は生成コードが破棄済み"
  requires none
  ensures none
  effects none
{
  mutex_lock();
  let s = sched();
  if ld(s, S_STOP) == 0 { st(s, S_STOP, code); }
  let t = ld(s, S_CUR);
  if t != 0 {
    st(t, T_STATE, ST_DONE);
    st(t, T_FRAME, 0);
  }
  notify();
  mutex_unlock();
}

fn worker_count() -> Int
  intent "sched_getaffinity の利用可能 CPU 数を既定とする。SIGIL_WORKERS の正の整数で上書きでき、1 は決定的モード"
  requires none
  ensures none
  effects none
  unchecked "sched_getaffinity は確保したビット集合だけに書く。EINVAL の間は容量を倍にし、その他の失敗なら 1。環境変数の頭は get が返した String"
{
  let name = rec(2);
  // 小端の ASCII: SIGIL_WO と RKERS（終端は get に渡す長さで決まる）。
  st(name, 0, 5717143033221695827);
  st(name, 1, 357862558546);
  let value = get(raw.int_to_addr(name), 13);
  rec_free(name, 2);
  let mut override = 0;
  if raw.addr_to_int(value) != 0 {
    let data = raw.load_addr(value);
    let len = raw.load_i64(raw.offset(value, 8));
    let mut i = 0;
    let mut valid = len > 0;
    while i < len && valid {
      let c = raw.load_u8(raw.offset(data, i));
      if c < 48 || c > 57 || override > (2147483647 - (c - 48)) / 10 {
        valid = false;
      } else { override = override * 10 + c - 48; }
      i = i + 1;
    }
    free(value);
    if valid && override > 0 { return override; }
  }
  let mut bytes = 128;
  while true {
    let mask = rec(bytes / 8);
    let r = raw.syscall(204, 0, bytes, mask, 0, 0, 0);
    let mut count = 0;
    if r > 0 {
      let mut i = 0;
      while i < r {
        let mut bits = raw.load_u8(raw.int_to_addr(mask + i));
        while bits != 0 { count = count + (bits & 1); bits = bits >> 1; }
        i = i + 1;
      }
    }
    rec_free(mask, bytes / 8);
    if count > 0 { return count; }
    if r != 0 - 22 { return 1; }
    bytes = bytes * 2;
  }
  return 1;
}

pub fn workers_start()
  intent "主スレッドを含めて指定数のワーカーを起こす。作成失敗は exit_group(70)"
  requires none
  ensures none
  effects none
  unchecked "ルートタスクを積んだ後、他のワーカーを作る前に主スレッドだけが呼ぶ。領域は各 256MiB 固定（仮想領域）。上限は OS の資源制限、指定は最大 2147483647"
{
  let s = sched();
  let count = worker_count();
  st(s, S_WORKERS, count);
  let handles = rec(count);
  st(s, S_HANDLES, handles);
  let mut i = 1;
  while i < count {
    let h = spawn(raw.addr_null());
    if raw.addr_to_int(h) == 0 { raw.syscall(231, 70, 0, 0, 0, 0, 0); }
    st(handles, i, raw.addr_to_int(h));
    i = i + 1;
  }
}

pub fn workers_join()
  intent "全ワーカーが実行の輪を離れてからハンドルを回収する。共有状態の解放はこの後だけ"
  requires none
  ensures none
  effects none
  unchecked "handles は workers_start が確保した配列。各ハンドルを一度だけ join し、全員の終了後に配列を返す"
{
  let s = sched();
  let count = ld(s, S_WORKERS);
  let handles = ld(s, S_HANDLES);
  let mut i = 1;
  while i < count { join(raw.int_to_addr(ld(handles, i))); i = i + 1; }
  rec_free(handles, count);
}
