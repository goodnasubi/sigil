fn p256_const_pm2() -> Bytes
  intent "指数 p - 2 の 32 バイト"
  requires none
  ensures result.byte_len() == 32
  effects none
{

  let mut out = Bytes.with_capacity(32);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(1);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(253);
  return out;
}

fn p256_const_nm2() -> Bytes
  intent "指数 n - 2 の 32 バイト"
  requires none
  ensures result.byte_len() == 32
  effects none
{

  let mut out = Bytes.with_capacity(32);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(0);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(255);
  out.push(188);
  out.push(230);
  out.push(250);
  out.push(173);
  out.push(167);
  out.push(23);
  out.push(158);
  out.push(132);
  out.push(243);
  out.push(185);
  out.push(202);
  out.push(194);
  out.push(252);
  out.push(99);
  out.push(37);
  out.push(79);
  return out;
}

fn p256_fp_pow(base: &Secret, e: &Bytes) -> Secret
  intent "公開の固定指数でべき乗する（左から右）"
  requires none
  ensures none
  effects none
{

  let mut acc = p256_const_one_p();
  let mut i = 0;
  while i < 256 {
    let byte = e.get(i >> 3).map(|b| b + 0).unwrap_or(0);
    let bit = (byte >> (7 - (i & 7))) & 1;
    acc = p256_fp_mul(&acc, &acc);
    let times = p256_fp_mul(&acc, &base);
    acc = p256_fe_select(&times, &acc, bit);
    i = i + 1;
  }
  return acc;
}

fn p256_fn_pow(base: &Secret, e: &Bytes) -> Secret
  intent "公開の固定指数でべき乗する（左から右）"
  requires none
  ensures none
  effects none
{

  let mut acc = p256_const_one_n();
  let mut i = 0;
  while i < 256 {
    let byte = e.get(i >> 3).map(|b| b + 0).unwrap_or(0);
    let bit = (byte >> (7 - (i & 7))) & 1;
    acc = p256_fn_mul(&acc, &acc);
    let times = p256_fn_mul(&acc, &base);
    acc = p256_fe_select(&times, &acc, bit);
    i = i + 1;
  }
  return acc;
}

struct P256Point {
  x: Secret,
  y: Secret,
  z: Secret,
}

fn p256_pt_add(p: &P256Point, q: &P256Point) -> P256Point
  intent "完全な射影加算（Renes-Costello-Batina、a = -3）"
  requires none
  ensures none
  effects none
{

  let bm = p256_const_b();
  let mut t0 = p256_fp_mul(&p.x, &q.x);
  let mut t1 = p256_fp_mul(&p.y, &q.y);
  let mut t2 = p256_fp_mul(&p.z, &q.z);
  let mut t3 = p256_fp_add(&p.x, &p.y);
  let mut t4 = p256_fp_add(&q.x, &q.y);
  t3 = p256_fp_mul(&t3, &t4);
  t4 = p256_fp_add(&t0, &t1);
  t3 = p256_fp_sub(&t3, &t4);
  t4 = p256_fp_add(&p.y, &p.z);
  let mut x3 = p256_fp_add(&q.y, &q.z);
  t4 = p256_fp_mul(&t4, &x3);
  x3 = p256_fp_add(&t1, &t2);
  t4 = p256_fp_sub(&t4, &x3);
  x3 = p256_fp_add(&p.x, &p.z);
  let mut y3 = p256_fp_add(&q.x, &q.z);
  x3 = p256_fp_mul(&x3, &y3);
  y3 = p256_fp_add(&t0, &t2);
  y3 = p256_fp_sub(&x3, &y3);
  let mut z3 = p256_fp_mul(&bm, &t2);
  x3 = p256_fp_sub(&y3, &z3);
  z3 = p256_fp_add(&x3, &x3);
  x3 = p256_fp_add(&x3, &z3);
  z3 = p256_fp_sub(&t1, &x3);
  x3 = p256_fp_add(&t1, &x3);
  y3 = p256_fp_mul(&bm, &y3);
  t1 = p256_fp_add(&t2, &t2);
  t2 = p256_fp_add(&t1, &t2);
  y3 = p256_fp_sub(&y3, &t2);
  y3 = p256_fp_sub(&y3, &t0);
  t1 = p256_fp_add(&y3, &y3);
  y3 = p256_fp_add(&t1, &y3);
  t1 = p256_fp_add(&t0, &t0);
  t0 = p256_fp_add(&t1, &t0);
  t0 = p256_fp_sub(&t0, &t2);
  t1 = p256_fp_mul(&t4, &y3);
  t2 = p256_fp_mul(&t0, &y3);
  y3 = p256_fp_mul(&x3, &z3);
  y3 = p256_fp_add(&y3, &t2);
  x3 = p256_fp_mul(&t3, &x3);
  x3 = p256_fp_sub(&x3, &t1);
  z3 = p256_fp_mul(&t4, &z3);
  t1 = p256_fp_mul(&t3, &t0);
  z3 = p256_fp_add(&z3, &t1);
  return P256Point { x: x3, y: y3, z: z3 };
}

fn p256_pt_dbl(p: &P256Point) -> P256Point
  intent "完全な射影倍算（Renes-Costello-Batina、a = -3）"
  requires none
  ensures none
  effects none
{

  let bm = p256_const_b();
  let mut t0 = p256_fp_mul(&p.x, &p.x);
  let mut t1 = p256_fp_mul(&p.y, &p.y);
  let mut t2 = p256_fp_mul(&p.z, &p.z);
  let mut t3 = p256_fp_mul(&p.x, &p.y);
  t3 = p256_fp_add(&t3, &t3);
  let mut z3 = p256_fp_mul(&p.x, &p.z);
  z3 = p256_fp_add(&z3, &z3);
  let mut y3 = p256_fp_mul(&bm, &t2);
  y3 = p256_fp_sub(&y3, &z3);
  let mut x3 = p256_fp_add(&y3, &y3);
  y3 = p256_fp_add(&x3, &y3);
  x3 = p256_fp_sub(&t1, &y3);
  y3 = p256_fp_add(&t1, &y3);
  y3 = p256_fp_mul(&x3, &y3);
  x3 = p256_fp_mul(&x3, &t3);
  t3 = p256_fp_add(&t2, &t2);
  t2 = p256_fp_add(&t2, &t3);
  z3 = p256_fp_mul(&bm, &z3);
  z3 = p256_fp_sub(&z3, &t2);
  z3 = p256_fp_sub(&z3, &t0);
  t3 = p256_fp_add(&z3, &z3);
  z3 = p256_fp_add(&z3, &t3);
  t3 = p256_fp_add(&t0, &t0);
  t0 = p256_fp_add(&t3, &t0);
  t0 = p256_fp_sub(&t0, &t2);
  t0 = p256_fp_mul(&t0, &z3);
  y3 = p256_fp_add(&y3, &t0);
  t0 = p256_fp_mul(&p.y, &p.z);
  t0 = p256_fp_add(&t0, &t0);
  z3 = p256_fp_mul(&t0, &z3);
  x3 = p256_fp_sub(&x3, &z3);
  z3 = p256_fp_mul(&t0, &t1);
  z3 = p256_fp_add(&z3, &z3);
  z3 = p256_fp_add(&z3, &z3);
  return P256Point { x: x3, y: y3, z: z3 };
}

fn p256_pt_select(left: &P256Point, right: &P256Point, bit: Int) -> P256Point
  intent "秘密分岐を使わずに点を選ぶ（bit が 1 なら left）"
  requires none
  ensures none
  effects none
{

  return P256Point { x: p256_fe_select(&left.x, &right.x, bit), y: p256_fe_select(&left.y, &right.y, bit), z: p256_fe_select(&left.z, &right.z, bit) };
}

fn p256_pt_identity() -> P256Point
  intent "無限遠点（0 : 1 : 0）"
  requires none
  ensures none
  effects none
{

  return P256Point { x: p256_const_zero(), y: p256_const_one_p(), z: p256_const_zero() };
}

fn p256_pt_base() -> P256Point
  intent "基点 G"
  requires none
  ensures none
  effects none
{

  return P256Point { x: p256_const_gx(), y: p256_const_gy(), z: p256_const_one_p() };
}

fn p256_scalar_mult(scalar: &Secret, base: &P256Point) -> P256Point
  intent "スカラー倍算を固定 256 回の反復で行う"
  requires none
  ensures none
  effects none
{

  let mut acc = p256_pt_identity();
  let mut i = 0;
  while i < 256 {
    let byte = scalar.data.get(i >> 3).map(|b| b + 0).unwrap_or(0);
    let bit = (byte >> (7 - (i & 7))) & 1;
    let doubled = p256_pt_dbl(&acc);
    let summed = p256_pt_add(&doubled, &base);
    acc = p256_pt_select(&summed, &doubled, bit);
    i = i + 1;
  }
  return acc;
}


// ---------------------------------------------------------------------------
// ECDSA P-256（ADR 0064 決定 1・決定 2）。SHA-256 とＲＦＣ 6979 の決定的な nonce。
//
// 体の元は 26 ビット 10 語（2^260 を基数とするモンゴメリ表現、各語は 4 バイトで
// `Secret` に収める）。p と n の 2 つの体で、乗算・加減算とも常に [0, m) の
// 標準形を返す（乗算は 2m 未満の結果へ条件付き減算を 1 回、マスクで行う）。
// 点は射影座標で、加算・倍算は Renes-Costello-Batina の完全な式（a = -3）なので、
// 無限遠点・同じ点・逆の点の例外を分岐で扱わない。スカラー倍算は 256 回固定の
// 反復で、倍算の後に必ず加算を行い、ビットで結果をマスク選択する。
// 公開のものは添字・反復回数・指数（p-2、n-2）・公開鍵・署名・メッセージ。
//
// nonce は RFC 6979 の HMAC-DRBG を使う。候補は 4 つ分を常に同じ演算列で処理し、
// 範囲違反・r = 0・s = 0 はマスクで扱う。最初に有効な組を選ぶ。

pub enum EcdsaP256Error {
  InvalidPrivateKey,
  InvalidPublicKey,
  InvalidSignature,
  SigningFailed,
}

pub struct EcdsaP256PrivateKey {
  key: Secret,
}

pub struct EcdsaP256PublicKey {
  bytes: Bytes,
}

pub struct EcdsaP256Signature {
  r: Bytes,
  s: Bytes,
}

struct P256Candidate {
  r: Secret,
  s: Secret,
  ok: Int,
}

struct P256Drbg {
  k: Bytes,
  v: Bytes,
}

struct P256DerInt {
  ok: Bool,
  value: Bytes,
  next: Int,
}

fn p256_lt(left: &Secret, right: &Secret) -> Int
  intent "借りの連鎖で left < right かを 0 または 1 で返す"
  requires none
  ensures none
  effects none
{
  let mut borrow = 0;
  let mut i = 0;
  while i < 10 {
    let t = p256_fe_read(&left, i) - p256_fe_read(&right, i) - borrow;
    borrow = t >> 63;
    i = i + 1;
  }
  return borrow;
}

fn p256_nonzero(value: &Secret) -> Int
  intent "全語を調べて 0 でないかを 0 または 1 で返す"
  requires none
  ensures none
  effects none
{
  let mut acc = 0;
  let mut i = 0;
  while i < 10 {
    acc = acc | p256_fe_read(&value, i);
    i = i + 1;
  }
  return ((0 - acc) >> 63) & 1;
}

fn p256_scalar_ok(value: &Secret) -> Bool
  intent "スカラーが 1 以上 n 未満かを調べる（結果は公開）"
  requires none
  ensures none
  effects none
{
  let order = p256_const_n();
  return (p256_lt(&value, &order) & p256_nonzero(&value)) == 1;
}

fn p256_accepted(flag: Int) -> Bool
  intent "署名候補が選ばれたかの最終結果を公開する"
  requires none
  ensures none
  effects none
{
  return flag == 1;
}

fn p256_affine_x(pt: &P256Point) -> Secret
  intent "射影の点から標準形のアフィン X を求める"
  requires none
  ensures none
  effects none
{
  let pm2 = p256_const_pm2();
  let one = p256_const_raw_one();
  let zi = p256_fp_pow(&pt.z, &pm2);
  let xm = p256_fp_mul(&pt.x, &zi);
  return p256_fp_mul(&xm, &one);
}

fn p256_affine_y(pt: &P256Point) -> Secret
  intent "射影の点から標準形のアフィン Y を求める"
  requires none
  ensures none
  effects none
{
  let pm2 = p256_const_pm2();
  let one = p256_const_raw_one();
  let zi = p256_fp_pow(&pt.z, &pm2);
  let ym = p256_fp_mul(&pt.y, &zi);
  return p256_fp_mul(&ym, &one);
}

// 候補の後半（r と s の計算と有効性）。`xa` はアフィン X（標準形）、`ks` は選んだスカラー、
// `valid` は範囲検査の結果（0 または 1）。試験が r = 0・s = 0 を作れるよう分けてある。
fn p256_finish(xa: &Secret, ks: &Secret, valid: Int, e_m: &Secret, d_m: &Secret) -> P256Candidate
  intent "アフィン X から r と s を計算し、候補の有効性をマスクで求める"
  requires none
  ensures none
  effects none
{
  let one = p256_const_raw_one();
  let zero = p256_const_zero();
  let r = p256_fn_add(&xa, &zero);
  let r2n = p256_const_r2_n();
  let km = p256_fn_mul(&ks, &r2n);
  let nm2 = p256_const_nm2();
  let kinv = p256_fn_pow(&km, &nm2);
  let rm = p256_fn_mul(&r, &r2n);
  let rd = p256_fn_mul(&rm, &d_m);
  let sum = p256_fn_add(&e_m, &rd);
  let sm = p256_fn_mul(&kinv, &sum);
  let s = p256_fn_mul(&sm, &one);
  let ok = valid & p256_nonzero(&r) & p256_nonzero(&s);
  return P256Candidate { r: r, s: s, ok: ok };
}

fn p256_candidate(k_bytes: &Bytes, e_m: &Secret, d_m: &Secret) -> P256Candidate
  intent "nonce の候補 1 つ分の署名を固定の演算列で計算する"
  requires none
  ensures none
  effects none
{
  let kk = p256_fe_decode(&k_bytes);
  let order = p256_const_n();
  let valid = p256_lt(&kk, &order) & p256_nonzero(&kk);
  let one = p256_const_raw_one();
  let ks = p256_fe_select(&kk, &one, valid);
  let scalar = Secret.from_bytes(p256_fe_encode(&ks));
  let base = p256_pt_base();
  let pt = p256_scalar_mult(&scalar, &base);
  let xa = p256_affine_x(&pt);
  return p256_finish(&xa, &ks, valid, &e_m, &d_m);
}

struct P256Pick {
  r: Secret,
  s: Secret,
  taken: Int,
}

fn p256_pick(pick: P256Pick, cand: &P256Candidate) -> P256Pick
  intent "最初に有効な候補だけをマスクで選ぶ"
  requires none
  ensures none
  effects none
{
  let take = cand.ok & (1 - pick.taken);
  let r = p256_fe_select(&cand.r, &pick.r, take);
  let s = p256_fe_select(&cand.s, &pick.s, take);
  return P256Pick { r: r, s: s, taken: pick.taken | cand.ok };
}

fn p256_signature_from(pick: &P256Pick) -> Result<EcdsaP256Signature, EcdsaP256Error>
  intent "選んだ候補から署名を作り、1 つも選ばれていなければ署名生成失敗を返す"
  requires none
  ensures none
  effects none
{
  let rb = p256_fe_encode(&pick.r);
  let sb = p256_fe_encode(&pick.s);
  if !p256_accepted(pick.taken) {
    return Err(EcdsaP256Error.SigningFailed);
  }
  return Ok(EcdsaP256Signature { r: rb, s: sb });
}

fn p256_drbg_init(x: &Bytes, h1: &Bytes) -> P256Drbg
  intent "RFC 6979 §3.2 の手順 b〜g で K と V を初期化する"
  requires none
  ensures none
  effects none
{
  let mut k0 = Bytes.with_capacity(32);
  let mut v0 = Bytes.with_capacity(32);
  let mut i = 0;
  while i < 32 {
    k0.push(0);
    v0.push(1);
    i = i + 1;
  }
  let mut m1 = v0.clone();
  m1.push(0);
  m1.extend(&x);
  m1.extend(&h1);
  let k1 = hmac_any_key(&k0, &m1);
  let v1 = hmac_any_key(&k1, &v0);
  let mut m2 = v1.clone();
  m2.push(1);
  m2.extend(&x);
  m2.extend(&h1);
  let k2 = hmac_any_key(&k1, &m2);
  let v2 = hmac_any_key(&k2, &v1);
  let k0_wipe = Secret.from_bytes(k0);
  let v0_wipe = Secret.from_bytes(v0);
  let m1_wipe = Secret.from_bytes(m1);
  let k1_wipe = Secret.from_bytes(k1);
  let v1_wipe = Secret.from_bytes(v1);
  let m2_wipe = Secret.from_bytes(m2);
  return P256Drbg { k: k2, v: v2 };
}

fn p256_drbg_next(st: P256Drbg) -> P256Drbg
  intent "V = HMAC(K, V) を計算して候補の元にする（RFC 6979 §3.2 の手順 h.2）"
  requires none
  ensures none
  effects none
{
  let next_v = hmac_any_key(&st.k, &st.v);
  let v_wipe = Secret.from_bytes(st.v);
  return P256Drbg { k: st.k, v: next_v };
}

fn p256_drbg_step(st: P256Drbg) -> P256Drbg
  intent "候補が使われた後の K と V の更新（RFC 6979 §3.2 の手順 h.3）"
  requires none
  ensures none
  effects none
{
  let mut m = st.v.clone();
  m.push(0);
  let k1 = hmac_any_key(&st.k, &m);
  let v1 = hmac_any_key(&k1, &st.v);
  let k_wipe = Secret.from_bytes(st.k);
  let v_wipe = Secret.from_bytes(st.v);
  let m_wipe = Secret.from_bytes(m);
  return P256Drbg { k: k1, v: v1 };
}

pub fn ecdsa_p256_sign(private: &EcdsaP256PrivateKey, message: &Bytes) -> Result<EcdsaP256Signature, EcdsaP256Error>
  intent "メッセージを SHA-256 でハッシュし、RFC 6979 の決定的な nonce で署名する"
  requires none
  ensures none
  effects none
{
  let digest = sha256(&message);
  let zero = p256_const_zero();
  let r2n = p256_const_r2_n();
  let z = p256_fe_decode(&digest);
  let e = p256_fn_add(&z, &zero);
  let em = p256_fn_mul(&e, &r2n);
  let d = p256_fe_decode(&private.key.data);
  let dm = p256_fn_mul(&d, &r2n);
  let xb = private.key.expose();
  let h1 = p256_fe_encode(&e);
  let mut st = p256_drbg_init(&xb, &h1);
  let mut pick = P256Pick { r: p256_const_zero(), s: p256_const_zero(), taken: 0 };
  let mut j = 0;
  while j < 4 {
    st = p256_drbg_next(st);
    let cand = p256_candidate(&st.v, &em, &dm);
    pick = p256_pick(pick, &cand);
    st = p256_drbg_step(st);
    j = j + 1;
  }
  let signed = p256_signature_from(&pick);
  let xb_wipe = Secret.from_bytes(xb);
  let h1_wipe = Secret.from_bytes(h1);
  let k_wipe = Secret.from_bytes(st.k);
  let v_wipe = Secret.from_bytes(st.v);
  return signed;
}

// 公開鍵の取り込み: 65 バイトの非圧縮点。座標は p 未満、曲線上にあること。
// 検査は公開の入力だけを扱う。
fn p256_point_on_curve(x: &Secret, y: &Secret) -> Bool
  intent "標準形の座標 (x, y) が曲線 y^2 = x^3 - 3x + b 上にあるか調べる"
  requires none
  ensures none
  effects none
{
  let r2p = p256_const_r2_p();
  let xm = p256_fp_mul(&x, &r2p);
  let ym = p256_fp_mul(&y, &r2p);
  let lhs = p256_fp_mul(&ym, &ym);
  let x2 = p256_fp_mul(&xm, &xm);
  let x3 = p256_fp_mul(&x2, &xm);
  let twice = p256_fp_add(&xm, &xm);
  let three = p256_fp_add(&twice, &xm);
  let diff = p256_fp_sub(&x3, &three);
  let bm = p256_const_b();
  let rhs = p256_fp_add(&diff, &bm);
  let lb = p256_fe_encode(&lhs);
  let rb = p256_fe_encode(&rhs);
  return ct_eq(&lb, &rb);
}

fn p256_slice32(data: &Bytes, start: Int) -> Bytes
  intent "指定位置から 32 バイトを取り出す"
  requires none
  ensures none
  effects none
{
  return data.slice(start, start + 32).unwrap_or(Bytes.new());
}

impl EcdsaP256PrivateKey {
  pub fn from_secret(key: Secret) -> Result<EcdsaP256PrivateKey, EcdsaP256Error>
    intent "32 バイトの秘密を 1 以上 n 未満のスカラーとして取り込む"
    requires none
    ensures none
    effects none
  {
    if key.byte_len() != 32 {
      return Err(EcdsaP256Error.InvalidPrivateKey);
    }
    let limbs = p256_fe_decode(&key.data);
    if !p256_scalar_ok(&limbs) {
      return Err(EcdsaP256Error.InvalidPrivateKey);
    }
    return Ok(EcdsaP256PrivateKey { key: key });
  }
}

fn p256_public_from_bytes(encoded: &Bytes) -> Result<EcdsaP256PublicKey, EcdsaP256Error>
  intent "SEC 1 の非圧縮点（65 バイト）を検査して公開鍵として取り込む（入力は公開）"
  requires none
  ensures none
  effects none
{
  if encoded.byte_len() != 65 {
    return Err(EcdsaP256Error.InvalidPublicKey);
  }
  if encoded.get(0).map(|b| b + 0).unwrap_or(0) != 4 {
    return Err(EcdsaP256Error.InvalidPublicKey);
  }
  let x = p256_fe_decode(&p256_slice32(&encoded, 1));
  let y = p256_fe_decode(&p256_slice32(&encoded, 33));
  let prime = p256_const_p();
  if p256_lt(&x, &prime) != 1 || p256_lt(&y, &prime) != 1 {
    return Err(EcdsaP256Error.InvalidPublicKey);
  }
  if !p256_point_on_curve(&x, &y) {
    return Err(EcdsaP256Error.InvalidPublicKey);
  }
  return Ok(EcdsaP256PublicKey { bytes: encoded.clone() });
}

impl EcdsaP256PublicKey {
  pub fn from_bytes(encoded: &Bytes) -> Result<EcdsaP256PublicKey, EcdsaP256Error>
    intent "SEC 1 の非圧縮点（65 バイト）を検査して公開鍵として取り込む"
    requires none
    ensures none
    effects none
  {
    return p256_public_from_bytes(&encoded);
  }

  pub fn to_bytes(self: &EcdsaP256PublicKey) -> Bytes
    intent "公開鍵を SEC 1 の非圧縮点（65 バイト）で返す"
    requires none
    ensures result.byte_len() == 65
    effects none
  {
    return self.bytes.clone();
  }
}

pub fn ecdsa_p256_public_key(private: &EcdsaP256PrivateKey) -> EcdsaP256PublicKey
  intent "秘密鍵から公開鍵を導出する"
  requires none
  ensures none
  effects none
{
  let base = p256_pt_base();
  let pt = p256_scalar_mult(&private.key, &base);
  let x = p256_affine_x(&pt);
  let y = p256_affine_y(&pt);
  let mut out = Bytes.with_capacity(65);
  out.push(4);
  out.extend(&p256_fe_encode(&x));
  out.extend(&p256_fe_encode(&y));
  return EcdsaP256PublicKey { bytes: out };
}

// DER: SEQUENCE { INTEGER r, INTEGER s }。最短の長さ・整数表現だけを受理する。
fn p256_der_int(value: &Bytes) -> Bytes
  intent "32 バイトの整数を最短の DER INTEGER にする"
  requires none
  ensures none
  effects none
{
  let mut start = 0;
  let mut scanning = true;
  while scanning {
    if start >= 31 {
      scanning = false;
    } else {
      let lead = value.get(start).map(|b| b + 0).unwrap_or(0);
      if lead == 0 {
        start = start + 1;
      } else {
        scanning = false;
      }
    }
  }
  let first = value.get(start).map(|b| b + 0).unwrap_or(0);
  let len = 32 - start;
  let mut out = Bytes.with_capacity(35);
  out.push(2);
  if first >= 128 {
    out.push(len + 1);
    out.push(0);
  } else {
    out.push(len);
  }
  let mut i = start;
  while i < 32 {
    out.push(value.get(i).map(|b| b + 0).unwrap_or(0));
    i = i + 1;
  }
  return out;
}

fn p256_der_fail() -> P256DerInt
  intent "DER の整数の読み取り失敗を表す"
  requires none
  ensures none
  effects none
{
  return P256DerInt { ok: false, value: Bytes.new(), next: 0 };
}

fn p256_der_read(data: &Bytes, off: Int) -> P256DerInt
  intent "位置 off の DER INTEGER を 1 以上 n 未満の 32 バイトとして読む"
  requires none
  ensures none
  effects none
{
  let total = data.byte_len();
  if off + 2 > total {
    return p256_der_fail();
  }
  if data.get(off).map(|b| b + 0).unwrap_or(0) != 2 {
    return p256_der_fail();
  }
  let len = data.get(off + 1).map(|b| b + 0).unwrap_or(0);
  if len < 1 || len > 33 || off + 2 + len > total {
    return p256_der_fail();
  }
  let first = data.get(off + 2).map(|b| b + 0).unwrap_or(0);
  if first >= 128 {
    return p256_der_fail();
  }
  let mut skip = 0;
  if len > 1 && first == 0 {
    let second = data.get(off + 3).map(|b| b + 0).unwrap_or(0);
    if second < 128 {
      return p256_der_fail();
    }
    skip = 1;
  }
  let body = len - skip;
  if body > 32 {
    return p256_der_fail();
  }
  let mut value = Bytes.with_capacity(32);
  let mut pad = 32 - body;
  while pad > 0 {
    value.push(0);
    pad = pad - 1;
  }
  let mut i = 0;
  while i < body {
    value.push(data.get(off + 2 + skip + i).map(|b| b + 0).unwrap_or(0));
    i = i + 1;
  }
  let limbs = p256_fe_decode(&value);
  if !p256_scalar_ok(&limbs) {
    return p256_der_fail();
  }
  return P256DerInt { ok: true, value: value, next: off + 2 + len };
}

fn p256_signature_from_der(encoded: &Bytes) -> Result<EcdsaP256Signature, EcdsaP256Error>
  intent "DER の署名を厳密に読み、r と s が 1 以上 n 未満であることを確かめる（入力は公開）"
  requires none
  ensures none
  effects none
{
  let total = encoded.byte_len();
  if total < 8 || total > 72 {
    return Err(EcdsaP256Error.InvalidSignature);
  }
  if encoded.get(0).map(|b| b + 0).unwrap_or(0) != 48 {
    return Err(EcdsaP256Error.InvalidSignature);
  }
  if encoded.get(1).map(|b| b + 0).unwrap_or(0) != total - 2 {
    return Err(EcdsaP256Error.InvalidSignature);
  }
  let first = p256_der_read(&encoded, 2);
  if !first.ok {
    return Err(EcdsaP256Error.InvalidSignature);
  }
  let second = p256_der_read(&encoded, first.next);
  if !second.ok {
    return Err(EcdsaP256Error.InvalidSignature);
  }
  if second.next != total {
    return Err(EcdsaP256Error.InvalidSignature);
  }
  return Ok(EcdsaP256Signature { r: first.value, s: second.value });
}

fn p256_signature_der(r: &Bytes, s: &Bytes) -> Bytes
  intent "r と s（各 32 バイト）を最短の DER で返す（入力は公開）"
  requires none
  ensures result.byte_len() <= 72
  effects none
{
  let mut body = p256_der_int(&r);
  body.extend(&p256_der_int(&s));
  let mut out = Bytes.with_capacity(72);
  out.push(48);
  out.push(body.byte_len());
  out.extend(&body);
  return out;
}

impl EcdsaP256Signature {
  pub fn from_der(encoded: &Bytes) -> Result<EcdsaP256Signature, EcdsaP256Error>
    intent "DER の署名を厳密に読み、r と s が 1 以上 n 未満であることを確かめる"
    requires none
    ensures none
    effects none
  {
    return p256_signature_from_der(&encoded);
  }

  pub fn to_der(self: &EcdsaP256Signature) -> Bytes
    intent "署名を最短の DER（最大 72 バイト）で返す"
    requires none
    ensures result.byte_len() <= 72
    effects none
  {
    return p256_signature_der(&self.r, &self.s);
  }
}

pub fn ecdsa_p256_verify(public: &EcdsaP256PublicKey, message: &Bytes, signature: &EcdsaP256Signature) -> Bool
  intent "署名を検証する（形が正しくても照合に失敗すれば false）"
  requires none
  ensures none
  effects none
{
  let zero = p256_const_zero();
  let r2n = p256_const_r2_n();
  let r2p = p256_const_r2_p();
  let one = p256_const_raw_one();
  let r = p256_fe_decode(&signature.r);
  let s = p256_fe_decode(&signature.s);
  let digest = sha256(&message);
  let z = p256_fe_decode(&digest);
  let e = p256_fn_add(&z, &zero);
  let em = p256_fn_mul(&e, &r2n);
  let rm = p256_fn_mul(&r, &r2n);
  let sm = p256_fn_mul(&s, &r2n);
  let nm2 = p256_const_nm2();
  let w = p256_fn_pow(&sm, &nm2);
  let u1m = p256_fn_mul(&em, &w);
  let u2m = p256_fn_mul(&rm, &w);
  let u1 = p256_fn_mul(&u1m, &one);
  let u2 = p256_fn_mul(&u2m, &one);
  let scalar1 = Secret.from_bytes(p256_fe_encode(&u1));
  let scalar2 = Secret.from_bytes(p256_fe_encode(&u2));
  let qx = p256_fe_decode(&p256_slice32(&public.bytes, 1));
  let qy = p256_fe_decode(&p256_slice32(&public.bytes, 33));
  let q = P256Point {
    x: p256_fp_mul(&qx, &r2p),
    y: p256_fp_mul(&qy, &r2p),
    z: p256_const_one_p(),
  };
  let base = p256_pt_base();
  let first = p256_scalar_mult(&scalar1, &base);
  let second = p256_scalar_mult(&scalar2, &q);
  let sum = p256_pt_add(&first, &second);
  if p256_nonzero(&sum.z) != 1 {
    return false;
  }
  let xa = p256_affine_x(&sum);
  let reduced = p256_fn_add(&xa, &zero);
  let got = p256_fe_encode(&reduced);
  return ct_eq(&got, &signature.r);
}
