//   intent "ファイルを読む"
//   requires none
//   ensures none
//   effects none                   // エラー: 本体は fs.read を起こすのに宣言していない
// { return fs.read(path); }
//
// fn bad_extra(x: Int) -> Int
//   intent "2 倍にする"
//   requires none
//   ensures result == x * 2
//   effects console                // エラー: 本体は console を起こさないのに宣言している
// { return x * 2; }
//
// module examples.effects_browser            // 別のファイル（ブラウザ向けのモジュール）
//   targets browser
//   trust none
//
// fn bad_target(path: Path) -> Result<String, IoError>
//   intent "ファイルを読む"
//   requires none
//   ensures none
//   effects fs.read                // エラー: fs.read はサーバーでだけ使える
// { return fs.read(path); }
