// 例 04: 効果の宣言と一致検査（ADR 0004）
// effects 節には本体が起こしうる効果を過不足なく書く。コンパイラが推論した効果と一致しなければエラー。

module examples.effects
  targets server
  trust none

// 効果なし: 純粋な計算。
fn add_tax(price: Int, rate_percent: Int) -> Int
  intent "税込み価格を返す"
  requires price >= 0 && rate_percent >= 0
  ensures result >= price
  effects none
{
  return price + price * rate_percent / 100;
}

// 効果あり: ファイルを読み、ログを出す。
fn load_prices(path: Path) -> Result<List<Int>, IoError>
  intent "価格の一覧をファイルから読む"
  requires !empty(path)
  ensures none
  effects console, fs.read
{
  console.log("loading prices");
  let text = fs.read(path)?;
  return Ok(text.lines().map(|line| parse_int(line).unwrap_or(0)));
}

// 関数を引数にとる関数: 引数 f の効果を引き継ぐ。
fn apply_all(xs: &List<Int>, f: fn(Int) -> Int) -> List<Int>
  intent "一覧の各要素に f を適用した一覧を返す"
  requires none
  ensures len(result) == len(xs)
  effects of(f)
{
  return xs.map(f);
}

// 呼び出し側: 効果なしの関数を渡すので、apply_all の効果は none になる。
fn with_tax(prices: &List<Int>) -> List<Int>
  intent "すべての価格に 10% の税を加える"
  requires none
  ensures len(result) == len(prices)
  effects none
{
  return apply_all(prices, |p| add_tax(p, 10));
}

// 共有所有の型を通した書き換えは state 効果になる。
fn count_up(counter: &Shared<Cell<Int>>)
  intent "共有のカウンタを 1 増やす"
  requires none
  ensures none
  effects state
{
  counter.set(counter.get() + 1);
}

