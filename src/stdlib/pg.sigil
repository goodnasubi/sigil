module std.pg
  targets server
  trust none

// ADR 0034 決定 1・2・6。SCRAM と Startup は同じ Sigil 本体で評価する。
// 接続と単一文 query はこの共通 Sigil 実装を評価器・ネイティブで利用する。
// feed は一フレームまで消費し、Done/NeedMore の整数は入力から消費したバイト数。
// 呼出側は未消費分を再投入し、EOFでは finish を呼ぶ。受信エラー後は再利用しない。
// budget は応答全体へ適用し、通知など行以外のメッセージも wire 上限に数える。
// backend は形だけを検査する。応答順序・同期・期限・接続破棄は 6-5c/d の責務。
// BackendKeyData の秘密とサーバー詳細文は返さず、エラーは SQLSTATE だけを返す。
// 最大値: wire 一メッセージ1MiB、結果4MiB/10000行/256列、SQL64KiB/256パラメータ。
// 自前バッファは一メッセージ以下。型変換の一時値も wire 長以下（byteaは縮小）。
use std.pg_scram.credential;
use std.pg_scram.first;
use std.pg_scram.respond;
use std.pg_scram.verify;

pub enum PgError {
  UnsupportedCredential,
  SqlState(String),
  OutcomeUnknown,
  Authentication,
  Connection,
  Timeout,
  Protocol,
  LimitExceeded,
  TypeMismatch,
  UnsupportedType,
  LockBroken,
}

pub enum PgValue {
  Boolean(Bool),
  Integer(Int),
  Text(String),
  Binary(Bytes),
}

pub struct PgParam {
  oid: Int,
  value: Option<PgValue>,
}

pub struct PgColumn {
  name: String,
  oid: Int,
}

pub struct PgFrame {
  tag: Int,
  body: Bytes,
}

pub enum PgProgress {
  NeedMore(Int),
  Done(PgFrame, Int),
}

pub struct PgDecoder {
  data: Bytes,
  failed: Bool,
  max: Int,
}

pub struct PgBudget {
  wire: Int,
  rows: Int,
  max_wire: Int,
  max_rows: Int,
}

struct PgReader {
  data: Bytes,
  pos: Int,
}

pub enum PgBackend {
  RowDescription(List<PgColumn>),
  DataRow(List<Option<PgValue>>),
  CommandComplete(String),
  ErrorResponse(String),
  NoticeResponse,
  ParameterStatus(String, String),
  BackendKeyData,
  ReadyForQuery(Int),
  ParseComplete,
  BindComplete,
  NoData,
  EmptyQueryResponse,
}

fn supported(oid: Int) -> Bool
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  return oid == 16 || oid == 21 || oid == 23 || oid == 20 || oid == 25 || oid == 1043 || oid == 17;
}

fn part(data: &Bytes, start: Int, end: Int) -> Bytes
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  return data.slice(start, end).unwrap_or(Bytes.new());
}

pub fn param(oid: Int, value: Option<PgValue>) -> Result<PgParam, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if !supported(oid) {
    return Err(PgError.UnsupportedType);
  }
  let p = PgParam { oid: oid, value: value };
  match encode_value(&p) {
    Err(e) => {
      return Err(e);
    }
    Ok(v) => {}
  }
  return Ok(p);
}

pub fn encode_value(p: &PgParam) -> Result<Option<Bytes>, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if !supported(p.oid) {
    return Err(PgError.UnsupportedType);
  }
  match p.value {
    None => {
      return Ok(None);
    }
    Some(v) => {
      match v {
        PgValue.Boolean(b) => {
          if p.oid != 16 {
            return Err(PgError.TypeMismatch);
          }
          if b {
            return Ok(Some("t".as_bytes()));
          }
          return Ok(Some("f".as_bytes()));
        }
        PgValue.Integer(n) => {
          if !int_range(p.oid, n) {
            return Err(PgError.TypeMismatch);
          }
          return Ok(Some(int_text(n)));
        }
        PgValue.Text(t) => {
          if p.oid != 25 && p.oid != 1043 {
            return Err(PgError.TypeMismatch);
          }
          if t.len() > 1048571 {
            return Err(PgError.LimitExceeded);
          }
          let b = t.as_bytes();
          let mut i = 0;
          while i < b.len() {
            if b.get(i).unwrap_or(0) == 0 {
              return Err(PgError.TypeMismatch);
            }
            i = i + 1;
          }
          return Ok(Some(b));
        }
        PgValue.Binary(b) => {
          if p.oid != 17 {
            return Err(PgError.TypeMismatch);
          }
          if b.len() > 524284 {
            return Err(PgError.LimitExceeded);
          }
          let mut out = "\\x".as_bytes();
          let hex = "0123456789abcdef".as_bytes();
          let mut i = 0;
          while i < b.len() {
            let x = b.get(i).unwrap_or(0);
            out.push(hex.get(x / 16).unwrap_or(0));
            out.push(hex.get(x % 16).unwrap_or(0));
            i = i + 1;
          }
          return Ok(Some(out));
        }
      }
    }
  }
}

fn int_range(oid: Int, n: Int) -> Bool
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if oid == 21 {
    return n >= 0 - 32768 && n <= 32767;
  }
  if oid == 23 {
    return n >= 0 - 2147483648 && n <= 2147483647;
  }
  return oid == 20;
}

fn unhex(c: Int) -> Int
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if c >= 48 && c <= 57 {
    return c - 48;
  }
  if c >= 97 && c <= 102 {
    return c - 87;
  }
  if c >= 65 && c <= 70 {
    return c - 55;
  }
  return 0 - 1;
}

pub fn decode_value(oid: Int, data: &Bytes) -> Result<PgValue, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if !supported(oid) {
    return Err(PgError.UnsupportedType);
  }
  if data.len() > 1048571 {
    return Err(PgError.LimitExceeded);
  }
  if oid == 17 {
    if data.len() < 2 || data.get(0).unwrap_or(0) != 92 || data.get(1).unwrap_or(0) != 120 || data.len() % 2 != 0 {
      return Err(PgError.TypeMismatch);
    }
    let mut out = Bytes.new();
    let mut i = 2;
    while i < data.len() {
      let a = unhex(data.get(i).unwrap_or(0));
      let b = unhex(data.get(i + 1).unwrap_or(0));
      if a < 0 || b < 0 {
        return Err(PgError.TypeMismatch);
      }
      out.push(a * 16 + b);
      i = i + 2;
    }
    return Ok(PgValue.Binary(out));
  }
  let t = data.to_string_utf8().map_err(|e| PgError.TypeMismatch)?;
  if oid == 25 || oid == 1043 {
    return Ok(PgValue.Text(t));
  }
  if oid == 16 {
    if t == "t" {
      return Ok(PgValue.Boolean(true));
    }
    if t == "f" {
      return Ok(PgValue.Boolean(false));
    }
    return Err(PgError.TypeMismatch);
  }
  let mut i = 0;
  if data.get(0).unwrap_or(0) == 45 {
    i = 1;
  }
  if i == data.len() {
    return Err(PgError.TypeMismatch);
  }
  while i < data.len() {
    let c = data.get(i).unwrap_or(0);
    if c < 48 || c > 57 {
      return Err(PgError.TypeMismatch);
    }
    i = i + 1;
  }
  let n = t.parse_int().map_err(|e| PgError.TypeMismatch)?;
  if !int_range(oid, n) {
    return Err(PgError.TypeMismatch);
  }
  return Ok(PgValue.Integer(n));
}

pub fn decoder(max: Int) -> Result<PgDecoder, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if max < 5 || max > 1048576 {
    return Err(PgError.LimitExceeded);
  }
  return Ok(PgDecoder { data: Bytes.new(), failed: false, max: max });
}

impl PgDecoder {
  pub fn feed(self: &mut PgDecoder, input: &Bytes) -> Result<PgProgress, PgError>
    intent "上限と形式を検査する"
    requires none
    ensures none
    effects none
  {
    if self.failed {
      return Err(PgError.Protocol);
    }
    let mut used = 0;
    while used < input.len() {
      self.data.push(input.get(used).unwrap_or(0));
      used = used + 1;
      if self.data.len() == 5 {
        let n = self.data.read_u32_be(1).unwrap_or(0);
        if n < 4 || n > 2147483647 {
          self.failed = true;
          return Err(PgError.Protocol);
        }
        if n > self.max - 1 {
          self.failed = true;
          return Err(PgError.LimitExceeded);
        }
      }
      if self.data.len() >= 5 {
        let n = self.data.read_u32_be(1).unwrap_or(0);
        if self.data.len() == n + 1 {
          let f = PgFrame { tag: self.data.get(0).unwrap_or(0), body: part(&self.data, 5, n + 1) };
          self.data = Bytes.new();
          return Ok(PgProgress.Done(f, used));
        }
      }
    }
    return Ok(PgProgress.NeedMore(used));
  }

  pub fn finish(self: &mut PgDecoder) -> Result<Bool, PgError>
    intent "上限と形式を検査する"
    requires none
    ensures none
    effects none
  {
    if self.failed || self.data.len() != 0 {
      self.failed = true;
      return Err(PgError.Protocol);
    }
    return Ok(true);
  }
}

pub fn frame(tag: Int, body: Bytes, max: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if max < 5 || max > 1048576 || body.len() > max - 5 {
    return Err(PgError.LimitExceeded);
  }
  if tag < 0 || tag > 255 {
    return Err(PgError.Protocol);
  }
  let mut out = Bytes.new();
  out.push(tag);
  out.push_u32_be(body.len() + 4);
  out.extend(&body);
  return Ok(out);
}

pub fn budget(max_wire: Int, max_rows: Int) -> Result<PgBudget, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if max_wire < 1 || max_wire > 4194304 || max_rows < 0 || max_rows > 10000 {
    return Err(PgError.LimitExceeded);
  }
  return Ok(PgBudget { wire: 0, rows: 0, max_wire: max_wire, max_rows: max_rows });
}

impl PgBudget {
  pub fn accept(self: &mut PgBudget, f: &PgFrame) -> Result<Bool, PgError>
    intent "上限と形式を検査する"
    requires none
    ensures none
    effects none
  {
    let n = f.body.len() + 5;
    if n > self.max_wire - self.wire {
      return Err(PgError.LimitExceeded);
    }
    if f.tag == 68 {
      if self.rows >= self.max_rows {
        return Err(PgError.LimitExceeded);
      }
      self.rows = self.rows + 1;
    }
    self.wire = self.wire + n;
    return Ok(true);
  }
}

fn read_n(r: &mut PgReader, n: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if n < 0 || n > r.data.len() - r.pos {
    return Err(PgError.Protocol);
  }
  let out = part(&r.data, r.pos, r.pos + n);
  r.pos = r.pos + n;
  return Ok(out);
}

fn uint(r: &mut PgReader, n: Int) -> Result<Int, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let b = read_n(&mut r, n)?;
  let mut v = 0;
  let mut i = 0;
  while i < n {
    v = v * 256 + b.get(i).unwrap_or(0);
    i = i + 1;
  }
  return Ok(v);
}

fn cstring(r: &mut PgReader) -> Result<String, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let start = r.pos;
  while r.pos < r.data.len() {
    let c = r.data.get(r.pos).unwrap_or(0);
    r.pos = r.pos + 1;
    if c == 0 {
      return match part(&r.data, start, r.pos - 1).to_string_utf8() {
        Ok(t) => Ok(t),
        Err(e) => Err(PgError.Protocol),
      };
    }
  }
  return Err(PgError.Protocol);
}

fn columns(r: &mut PgReader) -> Result<List<PgColumn>, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let count = uint(&mut r, 2)?;
  if count > 256 {
    return Err(PgError.LimitExceeded);
  }
  let mut out = List.new();
  let mut i = 0;
  while i < count {
    let name = cstring(&mut r)?;
    match read_n(&mut r, 6) {
      Ok(b) => {}
      Err(e) => {
        return Err(e);
      }
    }
    let oid = uint(&mut r, 4)?;
    if !supported(oid) {
      return Err(PgError.UnsupportedType);
    }
    match read_n(&mut r, 6) {
      Ok(b) => {}
      Err(e) => {
        return Err(e);
      }
    }
    match uint(&mut r, 2) {
      Ok(n) => {
        if n != 0 {
          return Err(PgError.TypeMismatch);
        }
      }
      Err(e) => {
        return Err(e);
      }
    }
    out.push(PgColumn { name: name, oid: oid });
    i = i + 1;
  }
  return Ok(out);
}

fn row(r: &mut PgReader, cols: &List<PgColumn>) -> Result<List<Option<PgValue>>, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let count = uint(&mut r, 2)?;
  if count > 256 {
    return Err(PgError.LimitExceeded);
  }
  if count != cols.len() {
    return Err(PgError.Protocol);
  }
  let mut out = List.new();
  let mut i = 0;
  while i < count {
    let oid = match cols.get(i) {
      Some(c) => c.oid,
      None => 0,
    };
    let n = uint(&mut r, 4)?;
    if n == 4294967295 {
      out.push(None);
    } else {
      if n > 2147483647 {
        return Err(PgError.Protocol);
      }
      let b = read_n(&mut r, n)?;
      let v = decode_value(oid, &b)?;
      out.push(Some(v));
    }
    i = i + 1;
  }
  return Ok(out);
}

fn error_fields(r: &mut PgReader) -> Result<String, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let mut sqlstate = "";
  let mut seen = false;
  while r.pos < r.data.len() {
    let tag = uint(&mut r, 1)?;
    if tag == 0 {
      if !seen {
        return Err(PgError.Protocol);
      }
      return Ok(sqlstate);
    }
    let t = cstring(&mut r)?;
    if tag == 67 {
      if seen || t.len() != 5 {
        return Err(PgError.Protocol);
      }
      let b = t.as_bytes();
      let mut i = 0;
      while i < 5 {
        let c = b.get(i).unwrap_or(0);
        if !(c >= 48 && c <= 57) && !(c >= 65 && c <= 90) {
          return Err(PgError.Protocol);
        }
        i = i + 1;
      }
      sqlstate = t;
      seen = true;
    }
  }
  return Err(PgError.Protocol);
}

pub fn backend(f: &PgFrame, cols: &List<PgColumn>) -> Result<PgBackend, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if f.body.len() > 1048571 {
    return Err(PgError.LimitExceeded);
  }
  let mut r = PgReader { data: f.body.clone(), pos: 0 };
  let v = backend_body(f.tag, &mut r, &cols)?;
  if r.pos != r.data.len() {
    return Err(PgError.Protocol);
  }
  return Ok(v);
}

fn backend_body(tag: Int, r: &mut PgReader, cols: &List<PgColumn>) -> Result<PgBackend, PgError>
  intent "応答の種類を解釈する"
  requires none
  ensures none
  effects none
{
  match tag {
    84 => {
      return Ok(PgBackend.RowDescription(columns(&mut r)?));
    }
    68 => {
      return Ok(PgBackend.DataRow(row(&mut r, &cols)?));
    }
    67 => {
      return Ok(PgBackend.CommandComplete(cstring(&mut r)?));
    }
    69 => {
      return Ok(PgBackend.ErrorResponse(error_fields(&mut r)?));
    }
    78 => {
      match error_fields(&mut r) {
        Ok(t) => {}
        Err(e) => {
          return Err(e);
        }
      }
      return Ok(PgBackend.NoticeResponse);
    }
    83 => {
      let k = cstring(&mut r)?;
      let v = cstring(&mut r)?;
      return Ok(PgBackend.ParameterStatus(k, v));
    }
    75 => {
      match read_n(&mut r, 8) {
        Ok(b) => {}
        Err(e) => {
          return Err(e);
        }
      }
      return Ok(PgBackend.BackendKeyData);
    }
    90 => {
      let c = uint(&mut r, 1)?;
      if c != 73 && c != 84 && c != 69 {
        return Err(PgError.Protocol);
      }
      return Ok(PgBackend.ReadyForQuery(c));
    }
    49 => {
      return Ok(PgBackend.ParseComplete);
    }
    50 => {
      return Ok(PgBackend.BindComplete);
    }
    110 => {
      return Ok(PgBackend.NoData);
    }
    73 => {
      return Ok(PgBackend.EmptyQueryResponse);
    }
    _ => {
      return Err(PgError.Protocol);
    }
  }
}

pub fn parse(sql: &String, params: &List<PgParam>, max: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if sql.len() > 65536 || params.len() > 256 {
    return Err(PgError.LimitExceeded);
  }
  if max < 5 || max > 1048576 || sql.len() > max - 5 || params.len() * 4 + 4 > max - 5 - sql.len() {
    return Err(PgError.LimitExceeded);
  }
  let b = sql.as_bytes();
  let mut i = 0;
  while i < b.len() {
    if b.get(i).unwrap_or(0) == 0 {
      return Err(PgError.Protocol);
    }
    i = i + 1;
  }
  let mut out = Bytes.new();
  out.push(0);
  out.extend(&b);
  out.push(0);
  out.push_u16_be(params.len());
  i = 0;
  while i < params.len() {
    match params.get(i) {
      None => {
        return Err(PgError.Protocol);
      }
      Some(p) => {
        match encode_value(&p) {
          Ok(v) => {}
          Err(e) => {
            return Err(e);
          }
        }
        out.push_u32_be(p.oid);
      }
    }
    i = i + 1;
  }
  return frame(80, out, max);
}

pub fn bind(params: &List<PgParam>, max: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  if params.len() > 256 || max < 13 || max > 1048576 {
    return Err(PgError.LimitExceeded);
  }
  let mut out = Bytes.new();
  out.push(0);
  out.push(0);
  out.push_u16_be(0);
  out.push_u16_be(params.len());
  let mut i = 0;
  while i < params.len() {
    match params.get(i) {
      None => {
        return Err(PgError.Protocol);
      }
      Some(p) => {
        let v = encode_value(&p)?;
        if out.len() > max - 11 {
          return Err(PgError.LimitExceeded);
        }
        match v {
          None => {
            out.push_u32_be(4294967295);
          }
          Some(b) => {
            if b.len() > max - 11 - out.len() {
              return Err(PgError.LimitExceeded);
            }
            out.push_u32_be(b.len());
            out.extend(&b);
          }
        }
      }
    }
    i = i + 1;
  }
  out.push_u16_be(0);
  return frame(66, out, max);
}

pub fn describe(max: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let mut b = Bytes.new();
  b.push(80);
  b.push(0);
  return frame(68, b, max);
}

pub fn execute(max: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  let mut b = Bytes.new();
  b.push(0);
  b.push_u32_be(0);
  return frame(69, b, max);
}

pub fn sync(max: Int) -> Result<Bytes, PgError>
  intent "上限と形式を検査する"
  requires none
  ensures none
  effects none
{
  return frame(83, Bytes.new(), max);
}

fn int_text(n: Int) -> Bytes
  intent "最小整数も桁あふれなしで十進化する"
  requires none
  ensures none
  effects none
{
  let mut v = n;
  if v > 0 {
    v = 0 - v;
  }
  let mut rev = Bytes.new();
  rev.push(48 - v % 10);
  v = v / 10;
  while v != 0 {
    rev.push(48 - v % 10);
    v = v / 10;
  }
  let mut out = Bytes.new();
  if n < 0 {
    out.push(45);
  }
  let mut i = rev.len();
  while i > 0 {
    i = i - 1;
    out.push(rev.get(i).unwrap_or(0));
  }
  return out;
}

impl PgColumn {
  pub fn column_name(self: &PgColumn) -> String
    intent "列名を写す"
    requires none
    ensures none
    effects none
  {
    return self.name.clone();
  }

  pub fn type_oid(self: &PgColumn) -> Int
    intent "列のOIDを読む"
    requires none
    ensures none
    effects none
  {
    return self.oid;
  }
}


// 接続は fd を一つだけ所有する。認証失敗と timeout はこの値を返さず、TcpClient の破棄で閉じる。
pub struct PgConn {
  stream: Option<TcpClient>,
  ready_status: Int,
}

pub struct PgConfig {
  host: String,
  port: Int,
  user: String,
  database: String,
  password: Secret,
}

pub struct PgConnectLimits {
  timeout_ms: Int,
}

pub fn config(host: String, port: Int, user: String, database: String, password: Secret) -> Result<PgConfig, PgError>
  intent "接続前に資格情報と設定を検査する"
  requires none
  ensures none
  effects none
{
  if port < 1 || port > 65535 { return Err(PgError.Protocol); }
  let u = user.as_bytes();
  let d = database.as_bytes();
  if u.len() == 0 || d.len() == 0 || u.len() > 1024 || d.len() > 1024 { return Err(PgError.UnsupportedCredential); }
  let mut i = 0;
  while i < u.len() { if u.get(i).unwrap_or(0) == 0 { return Err(PgError.UnsupportedCredential); } i = i + 1; }
  i = 0;
  while i < d.len() { if d.get(i).unwrap_or(0) == 0 { return Err(PgError.UnsupportedCredential); } i = i + 1; }
  let pw = password.expose();
  let valid = credential(&pw);
  let wipe = Secret.from_bytes(pw);
  if !valid { return Err(PgError.UnsupportedCredential); }
  return Ok(PgConfig { host: host, port: port, user: user, database: database, password: password });
}

pub fn default_connect_limits() -> PgConnectLimits
  intent "認証全体の上限を10秒にする"
  requires none
  ensures none
  effects none
{
  return PgConnectLimits { timeout_ms: 10000 };
}

impl PgConnectLimits {
  pub fn with_timeout(self: PgConnectLimits, ms: Int) -> Result<PgConnectLimits, PgError>
    intent "期限を10秒以下に狭める"
    requires none
    ensures none
    effects none
  {
    if ms < 1 || ms > 10000 { return Err(PgError.LimitExceeded); }
    return Ok(PgConnectLimits { timeout_ms: ms });
  }
}

pub fn connect(config: PgConfig, limits: &PgConnectLimits) -> Result<PgConn, PgError>
  intent "SCRAMとStartupを期限内に完了しidle接続を返す"
  requires none
  ensures none
  effects net.client, random, clock, task.spawn, task.suspend
{
  match task.timeout(limits.timeout_ms, || connect_inner(&config)) {
    Some(r) => { return r; }
    None => { return Err(PgError.Timeout); }
  }
}

fn startup(user: &String, database: &String) -> Bytes
  intent "protocol3とUTF8と固定のbytea設定を送る"
  requires none
  ensures none
  effects none
{
  let mut body = Bytes.new();
  body.push_u32_be(196608);
  body.extend(&"user\u{0}".as_bytes()); body.extend(&user.as_bytes()); body.push(0);
  body.extend(&"database\u{0}".as_bytes()); body.extend(&database.as_bytes()); body.push(0);
  body.extend(&"client_encoding\u{0}UTF8\u{0}options\u{0}-c bytea_output=hex\u{0}\u{0}".as_bytes());
  let mut out = Bytes.new(); out.push_u32_be(body.len() + 4); out.extend(&body);
  return out;
}

fn scram_error(e: ScramError) -> PgError
  intent "秘密を含まない固定分類へ変換する"
  requires none
  ensures none
  effects none
{
  return match e {
    ScramError.LimitExceeded => PgError.LimitExceeded,
    ScramError.UnsupportedCredential => PgError.UnsupportedCredential,
    ScramError.Protocol => PgError.Authentication,
  };
}

// 1バイトずつ読むのでフレームの先を消費しない。保持量はdecoderの一メッセージ上限内。
fn receive(stream: &mut TcpClient, budget: &mut PgBudget) -> Result<PgFrame, PgError>
  intent "上限付きフレームを受け取る"
  requires none
  ensures none
  effects net.client, task.suspend
{
  let mut d = decoder(1048576)?;
  while true {
    match stream.read(1) {
      Ok(data) => {
        if data.len() == 0 { return Err(PgError.Connection); }
        match d.feed(&data)? {
          PgProgress.Done(f, n) => { budget.accept(&f)?; return Ok(f); }
          PgProgress.NeedMore(n) => {}
        }
      }
      Err(e) => { return Err(PgError.Connection); }
    }
  }
  return Err(PgError.Protocol);
}

fn send(stream: &mut TcpClient, data: &Bytes) -> Result<Bool, PgError>
  intent "フレーム全体を送る"
  requires none
  ensures none
  effects net.client, task.suspend
{
  match stream.write_all(&data) { Ok(v) => { return Ok(true); } Err(e) => { return Err(PgError.Connection); } }
}

fn auth(f: &PgFrame, code: Int) -> Result<Bytes, PgError>
  intent "認証の種類とサイズを検査する"
  requires none
  ensures none
  effects none
{
  if f.tag != 82 || f.body.len() < 4 { return Err(PgError.Authentication); }
  if f.body.read_u32_be(0).unwrap_or(0 - 1) != code { return Err(PgError.Authentication); }
  if f.body.len() > 16388 { return Err(PgError.LimitExceeded); }
  return Ok(part(&f.body, 4, f.body.len()));
}

fn sasl(mechanisms: &Bytes) -> Result<Bool, PgError>
  intent "SCRAM-SHA-256だけを選択する"
  requires none
  ensures none
  effects none
{
  let mut r = PgReader { data: mechanisms.clone(), pos: 0 };
  let mut found = false;
  while r.pos < r.data.len() {
    let name = cstring(&mut r)?;
    if name == "" {
      if r.pos != r.data.len() || !found { return Err(PgError.Authentication); }
      return Ok(true);
    }
    if name == "SCRAM-SHA-256" { if found { return Err(PgError.Authentication); } found = true; }
  }
  return Err(PgError.Authentication);
}

fn connect_inner(c: &PgConfig) -> Result<PgConn, PgError>
  intent "認証の応答を順番に検証する"
  requires none
  ensures none
  effects net.client, random, task.suspend
{
  let nonce = match random.bytes(24) { Some(b) => Ok(b), None => Err(PgError.Connection), }?;
  let initial = match first(&nonce) { Ok(b) => Ok(b), Err(e) => Err(scram_error(e)), }?;
  let mut stream = match net.connect(&c.host, c.port) { Ok(s) => Ok(s), Err(e) => Err(PgError.Connection), }?;
  send(&mut stream, &startup(&c.user, &c.database))?;
  let mut b = budget(4194304, 0)?;
  let methods = auth(&receive(&mut stream, &mut b)?, 10)?;
  sasl(&methods)?;
  let mut body = "SCRAM-SHA-256\u{0}".as_bytes(); body.push_u32_be(initial.len()); body.extend(&initial);
  send(&mut stream, &frame(112, body, 1048576)?)?;
  let challenge = auth(&receive(&mut stream, &mut b)?, 11)?;
  let reply = match respond(&c.password, &nonce, &challenge) { Ok(r) => Ok(r), Err(e) => Err(scram_error(e)), }?;
  send(&mut stream, &frame(112, reply.message, 1048576)?)?;
  let final = auth(&receive(&mut stream, &mut b)?, 12)?;
  match verify(&reply.signature, &final) {
    Ok(true) => {}
    Ok(false) => { return Err(PgError.Authentication); }
    Err(e) => { return Err(scram_error(e)); }
  }
  let ok = auth(&receive(&mut stream, &mut b)?, 0)?;
  if ok.len() != 0 { return Err(PgError.Authentication); }
  let mut encoding = false;
  let mut key = false;
  while true {
    let f = receive(&mut stream, &mut b)?;
    match backend(&f, &List.new())? {
      PgBackend.ParameterStatus(k, v) => {
        if k == "client_encoding" { if v != "UTF8" { return Err(PgError.Protocol); } encoding = true; }
      }
      PgBackend.BackendKeyData => { if key { return Err(PgError.Protocol); } key = true; }
      PgBackend.NoticeResponse => {}
      PgBackend.ReadyForQuery(status) => {
        if status != 73 || !encoding { return Err(PgError.Protocol); }
        return Ok(PgConn { stream: Some(stream), ready_status: 73 });
      }
      _ => { return Err(PgError.Protocol); }
    }
  }
  return Err(PgError.Protocol);
}

// 結果の文字列・バイト列は wire 累積以下。各値は少なくとも長さ欄4バイトを消費する。
// 値スロットは max_wire / 4 以下（製品上限1048576個）、行の箱は10000個以下。
// wire上限と合わせ、NULL/空値が多い応答にも復号後の保持量の固定上限を持たせる。
pub struct PgResult {
  result_cols: List<PgColumn>,
  result_rows: List<List<Option<PgValue>>>,
  command_tag: String,
  ready_status: Int,
}

pub struct PgQueryLimits {
  timeout_ms: Int,
  max_wire: Int,
  max_rows: Int,
}

pub fn default_query_limits() -> PgQueryLimits
  intent "一操作30秒と結果の固定上限を選ぶ"
  requires none
  ensures none
  effects none
{
  return PgQueryLimits { timeout_ms: 30000, max_wire: 4194304, max_rows: 10000 };
}

impl PgQueryLimits {
  pub fn with_timeout(self: PgQueryLimits, ms: Int) -> Result<PgQueryLimits, PgError>
    intent "一操作の期限を30秒以下に狭める"
    requires none
    ensures none
    effects none
  {
    if ms < 1 || ms > 30000 { return Err(PgError.LimitExceeded); }
    return Ok(PgQueryLimits { timeout_ms: ms, max_wire: self.max_wire, max_rows: self.max_rows });
  }

  pub fn with_result_bounds(self: PgQueryLimits, wire: Int, rows: Int) -> Result<PgQueryLimits, PgError>
    intent "結果の累積wireと行数の上限を狭める"
    requires none
    ensures none
    effects none
  {
    if wire < 1 || wire > 4194304 || rows < 0 || rows > 10000 { return Err(PgError.LimitExceeded); }
    return Ok(PgQueryLimits { timeout_ms: self.timeout_ms, max_wire: wire, max_rows: rows });
  }
}

impl PgResult {
  pub fn columns(self: &PgResult) -> Int
    intent "列数を返す"
    requires none
    ensures none
    effects none
  { return self.result_cols.len(); }

  pub fn rows(self: &PgResult) -> Int
    intent "行数を返す"
    requires none
    ensures none
    effects none
  { return self.result_rows.len(); }

  pub fn column(self: &PgResult, index: Int) -> Option<&PgColumn>
    intent "列情報を借用して返す"
    requires none
    ensures none
    effects none
  { return self.result_cols.get(index); }

  pub fn row(self: &PgResult, index: Int) -> Option<&List<Option<PgValue>>>
    intent "行を借用して返す"
    requires none
    ensures none
    effects none
  { return self.result_rows.get(index); }

  pub fn command(self: &PgResult) -> String
    intent "完了タグを返す"
    requires none
    ensures none
    effects none
  { return self.command_tag.clone(); }

  pub fn status(self: &PgResult) -> Int
    intent "同期時のトランザクション状態を返す"
    requires none
    ensures none
    effects none
  { return self.ready_status; }
}

impl PgConn {
  pub fn is_closed(self: &PgConn) -> Bool
    intent "同期不明や期限切れで破棄された接続を識別する"
    requires none
    ensures none
    effects none
  { return self.stream.is_none(); }

  pub fn query(self: &mut PgConn, sql: &String, params: &List<PgParam>, limits: &PgQueryLimits) -> Result<PgResult, PgError>
    intent "単一文を期限内に実行し同期できた接続だけを保持する"
    requires none
    ensures none
    effects net.client, clock, task.spawn, task.suspend
  {
    let mut pending = self.stream.take();
    self.ready_status = 0;
    if pending.is_none() { return Err(PgError.Connection); }
    match task.timeout(limits.timeout_ms, || query_pending(&mut pending, &sql, &params, &limits)) {
      None => { return Err(PgError.Timeout); }
      Some(done) => {
        let (saved, status, answer) = done;
        self.stream = saved;
        self.ready_status = status;
        return answer;
      }
    }
  }
}

fn query_pending(pending: &mut Option<TcpClient>, sql: &String, params: &List<PgParam>, limits: &PgQueryLimits) -> (Option<TcpClient>, Int, Result<PgResult, PgError>)
  intent "期限付きの子の中で接続の所有を引き取る"
  requires none
  ensures none
  effects net.client, task.suspend
{
  match pending.take() {
    Some(stream) => { return query_owned(stream, &sql, &params, &limits); }
    None => { return (None, 0, Err(PgError.Connection)); }
  }
}

fn query_owned(owned_stream: TcpClient, sql: &String, params: &List<PgParam>, limits: &PgQueryLimits) -> (Option<TcpClient>, Int, Result<PgResult, PgError>)
  intent "所有する接続を同期完了時だけ呼出元へ戻す"
  requires none
  ensures none
  effects net.client, task.suspend
{
  let mut stream = owned_stream;
  // 全入力の検査・符号化を送信より前、同じ期限内で行う。
  match query_request(&sql, &params) {
    Err(e) => { return (Some(stream), 0, Err(e)); }
    Ok(request) => {
      match send(&mut stream, &request) {
        Err(e) => { return (None, 0, Err(PgError.OutcomeUnknown)); }
        Ok(v) => {}
      }
      match query_receive(&mut stream, &limits) {
        Ok(done) => { let (status, answer) = done; return (Some(stream), status, answer); }
        Err(PgError.Connection) => { return (None, 0, Err(PgError.OutcomeUnknown)); }
        Err(e) => { return (None, 0, Err(e)); }
      }
    }
  }
}

fn query_request(sql: &String, params: &List<PgParam>) -> Result<Bytes, PgError>
  intent "値をBindへ分離した単一文の要求を作る"
  requires none
  ensures none
  effects none
{
  let mut request = parse(&sql, &params, 1048576)?;
  request.extend(&bind(&params, 1048576)?);
  request.extend(&describe(1048576)?);
  request.extend(&execute(1048576)?);
  request.extend(&sync(1048576)?);
  return Ok(request);
}

fn query_receive(stream: &mut TcpClient, limits: &PgQueryLimits) -> Result<(Int, Result<PgResult, PgError>), PgError>
  intent "応答順序と上限を検証し文エラー後もReadyForQueryまで同期する"
  requires none
  ensures none
  effects net.client, task.suspend
{
  let mut b = budget(limits.max_wire, limits.max_rows)?;
  let mut phase = 0;
  let mut columns = List.new();
  let mut rows = List.new();
  let mut command = "";
  let mut error = "";
  let mut cells = 0;
  while true {
    let f = receive(&mut stream, &mut b)?;
    match backend(&f, &columns)? {
      PgBackend.NoticeResponse => {}
      PgBackend.ParameterStatus(k, v) => {
        if (k == "client_encoding" && v != "UTF8") || (k == "bytea_output" && v != "hex") { return Err(PgError.Protocol); }
      }
      PgBackend.ErrorResponse(state) => {
        if phase >= 4 || error != "" { return Err(PgError.Protocol); }
        error = state;
        phase = 5;
      }
      PgBackend.ReadyForQuery(status) => {
        if phase == 5 { return Ok((status, Err(PgError.SqlState(error)))); }
        if phase != 4 { return Err(PgError.Protocol); }
        return Ok((status, Ok(PgResult { result_cols: columns, result_rows: rows, command_tag: command, ready_status: status })));
      }
      PgBackend.ParseComplete => {
        if phase != 0 { return Err(PgError.Protocol); }
        phase = 1;
      }
      PgBackend.BindComplete => {
        if phase != 1 { return Err(PgError.Protocol); }
        phase = 2;
      }
      PgBackend.RowDescription(cs) => {
        if phase != 2 { return Err(PgError.Protocol); }
        columns = cs;
        phase = 3;
      }
      PgBackend.NoData => {
        if phase != 2 { return Err(PgError.Protocol); }
        phase = 3;
      }
      PgBackend.DataRow(row) => {
        if phase != 3 || columns.len() == 0 { return Err(PgError.Protocol); }
        if row.len() > limits.max_wire / 4 - cells { return Err(PgError.LimitExceeded); }
        cells = cells + row.len();
        rows.push(row);
      }
      PgBackend.CommandComplete(tag) => {
        if phase != 3 { return Err(PgError.Protocol); }
        command = tag;
        phase = 4;
      }
      PgBackend.EmptyQueryResponse => {
        if phase != 3 || columns.len() != 0 { return Err(PgError.Protocol); }
        phase = 4;
      }
      _ => { return Err(PgError.Protocol); }
    }
  }
  return Err(PgError.Protocol);
}

// 接続の宣言順で fd を閉じてから permit を返す。破棄に通信や待機はない。
pub struct PgPooled {
  conn: PgConn,
  permit: CapacityPermit,
}

// List の借用から所有値を抜き取る入口を増やさず、上限16の固定保管庫を使う。
pub struct PgIdle {
  slot0: Option<PgPooled>,
  slot1: Option<PgPooled>,
  slot2: Option<PgPooled>,
  slot3: Option<PgPooled>,
  slot4: Option<PgPooled>,
  slot5: Option<PgPooled>,
  slot6: Option<PgPooled>,
  slot7: Option<PgPooled>,
  slot8: Option<PgPooled>,
  slot9: Option<PgPooled>,
  slot10: Option<PgPooled>,
  slot11: Option<PgPooled>,
  slot12: Option<PgPooled>,
  slot13: Option<PgPooled>,
  slot14: Option<PgPooled>,
  slot15: Option<PgPooled>,
}

pub struct PgPoolLimits {
  connections: Int,
  waiters: Int,
  connect_ms: Int,
  query_ms: Int,
  cleanup_ms: Int,
  acquire_ms: Int,
}

pub struct PgPool {
  config: Lock<PgConfig>,
  idle: SyncShared<Lock<PgIdle>>,
  connections: Capacity,
  waiters: Capacity,
  connect_ms: Int,
  query_ms: Int,
  cleanup_ms: Int,
  acquire_ms: Int,
}

pub struct PgLease {
  held: Option<PgPooled>,
  pool: PgPool,
}

pub fn default_pool_limits() -> PgPoolLimits
  intent "プール16接続と64待機および各期限の最大値を選ぶ"
  requires none
  ensures none
  effects none
{
  return PgPoolLimits { connections: 16, waiters: 64, connect_ms: 10000, query_ms: 30000, cleanup_ms: 5000, acquire_ms: 30000 };
}

impl PgPoolLimits {
  pub fn with_capacity(self: PgPoolLimits, connections: Int, waiters: Int) -> Result<PgPoolLimits, PgError>
    intent "接続と待機の容量をADRの上限以下へ狭める"
    requires none
    ensures none
    effects none
  {
    if connections < 1 || connections > 16 || waiters < 1 || waiters > 64 { return Err(PgError.LimitExceeded); }
    return Ok(PgPoolLimits { connections: connections, waiters: waiters, connect_ms: self.connect_ms, query_ms: self.query_ms, cleanup_ms: self.cleanup_ms, acquire_ms: self.acquire_ms });
  }

  pub fn with_timeouts(self: PgPoolLimits, connect_ms: Int, query_ms: Int, cleanup_ms: Int, acquire_ms: Int) -> Result<PgPoolLimits, PgError>
    intent "接続と操作と清掃と借出の期限を最大値以下へ狭める"
    requires none
    ensures none
    effects none
  {
    if connect_ms < 1 || connect_ms > 10000 || query_ms < 1 || query_ms > 30000 || cleanup_ms < 1 || cleanup_ms > 5000 || acquire_ms < 1 || acquire_ms > 30000 { return Err(PgError.LimitExceeded); }
    return Ok(PgPoolLimits { connections: self.connections, waiters: self.waiters, connect_ms: connect_ms, query_ms: query_ms, cleanup_ms: cleanup_ms, acquire_ms: acquire_ms });
  }

  pub fn max_result_wire(self: &PgPoolLimits) -> Int
    intent "全接続の一回の結果wire保持上限を値で返す"
    requires none
    ensures none
    effects none
  { return self.connections * 4194304; }
}

pub fn pool(config: PgConfig, limits: &PgPoolLimits) -> Result<PgPool, PgError>
  intent "明示上限の未接続プールを作る"
  requires none
  ensures none
  effects none
{
  let connections = match Capacity.new(limits.connections) { Some(c) => Ok(c), None => Err(PgError.LimitExceeded), }?;
  let waiters = match Capacity.new(limits.waiters) { Some(c) => Ok(c), None => Err(PgError.LimitExceeded), }?;
  let idle = PgIdle {
    slot0: None,
    slot1: None,
    slot2: None,
    slot3: None,
    slot4: None,
    slot5: None,
    slot6: None,
    slot7: None,
    slot8: None,
    slot9: None,
    slot10: None,
    slot11: None,
    slot12: None,
    slot13: None,
    slot14: None,
    slot15: None,
  };
  return Ok(PgPool { config: Lock.new(config), idle: SyncShared.new(Lock.new(idle)), connections: connections, waiters: waiters, connect_ms: limits.connect_ms, query_ms: limits.query_ms, cleanup_ms: limits.cleanup_ms, acquire_ms: limits.acquire_ms });
}

impl PgPool {
  pub fn clone(self: &PgPool) -> PgPool
    intent "同じ接続保管庫と容量を参照するプールの持ち手を作る"
    requires none
    ensures none
    effects none
  {
    return PgPool { config: self.config.clone(), idle: self.idle.clone(), connections: self.connections.clone(), waiters: self.waiters.clone(), connect_ms: self.connect_ms, query_ms: self.query_ms, cleanup_ms: self.cleanup_ms, acquire_ms: self.acquire_ms };
  }

  pub fn acquire(self: &PgPool) -> Result<PgLease, PgError>
    intent "期限内に排他所有する接続を一つだけ借り出す"
    requires none
    ensures none
    effects net.client, random, clock, task.spawn, task.share, task.suspend
  {
    let pool = self.clone();
    match task.timeout(pool.acquire_ms, || acquire_inner(&pool)) {
      None => { return Err(PgError.Timeout); }
      Some(answer) => { return answer; }
    }
  }
}

fn idle_take(idle: &mut PgIdle) -> Option<PgPooled>
  intent "固定保管庫から接続の所有を一つだけ取り出す"
  requires none
  ensures none
  effects none
{
  if idle.slot0.is_some() { return idle.slot0.take(); }
  if idle.slot1.is_some() { return idle.slot1.take(); }
  if idle.slot2.is_some() { return idle.slot2.take(); }
  if idle.slot3.is_some() { return idle.slot3.take(); }
  if idle.slot4.is_some() { return idle.slot4.take(); }
  if idle.slot5.is_some() { return idle.slot5.take(); }
  if idle.slot6.is_some() { return idle.slot6.take(); }
  if idle.slot7.is_some() { return idle.slot7.take(); }
  if idle.slot8.is_some() { return idle.slot8.take(); }
  if idle.slot9.is_some() { return idle.slot9.take(); }
  if idle.slot10.is_some() { return idle.slot10.take(); }
  if idle.slot11.is_some() { return idle.slot11.take(); }
  if idle.slot12.is_some() { return idle.slot12.take(); }
  if idle.slot13.is_some() { return idle.slot13.take(); }
  if idle.slot14.is_some() { return idle.slot14.take(); }
  if idle.slot15.is_some() { return idle.slot15.take(); }
  return None;
}

fn idle_put(idle: &mut PgIdle, held: PgPooled) -> Bool
  intent "清掃済み接続の所有を空いた固定欄へ移す"
  requires none
  ensures none
  effects none
{
  if idle.slot0.is_none() { idle.slot0 = Some(held); return true; }
  if idle.slot1.is_none() { idle.slot1 = Some(held); return true; }
  if idle.slot2.is_none() { idle.slot2 = Some(held); return true; }
  if idle.slot3.is_none() { idle.slot3 = Some(held); return true; }
  if idle.slot4.is_none() { idle.slot4 = Some(held); return true; }
  if idle.slot5.is_none() { idle.slot5 = Some(held); return true; }
  if idle.slot6.is_none() { idle.slot6 = Some(held); return true; }
  if idle.slot7.is_none() { idle.slot7 = Some(held); return true; }
  if idle.slot8.is_none() { idle.slot8 = Some(held); return true; }
  if idle.slot9.is_none() { idle.slot9 = Some(held); return true; }
  if idle.slot10.is_none() { idle.slot10 = Some(held); return true; }
  if idle.slot11.is_none() { idle.slot11 = Some(held); return true; }
  if idle.slot12.is_none() { idle.slot12 = Some(held); return true; }
  if idle.slot13.is_none() { idle.slot13 = Some(held); return true; }
  if idle.slot14.is_none() { idle.slot14 = Some(held); return true; }
  if idle.slot15.is_none() { idle.slot15 = Some(held); return true; }
  return false;
}

fn pool_config(pool: &PgPool) -> Result<PgConfig, PgError>
  intent "設定のロック内で資格情報を内部コピーし接続待機前にロックを解放する"
  requires none
  ensures none
  effects task.share, task.suspend
{
  match pool.config.acquire() {
    Err(e) => { return Err(PgError.LockBroken); }
    Ok(g) => {
      let c = g.get();
      return Ok(PgConfig { host: c.host.clone(), port: c.port, user: c.user.clone(), database: c.database.clone(), password: Secret.from_bytes(c.password.expose()) });
    }
  }
}

fn take_idle(pool: &PgPool) -> Result<Option<PgPooled>, PgError>
  intent "共有保管庫を待機なしの所有移動の間だけ守る"
  requires none
  ensures none
  effects task.share, task.suspend
{
  let idle_lock = pool.idle.borrow();
  match idle_lock.acquire() {
    Err(e) => { return Err(PgError.LockBroken); }
    Ok(g0) => { let mut g = g0; return Ok(idle_take(g.get_mut())); }
  }
}

fn acquire_inner(pool: &PgPool) -> Result<PgLease, PgError>
  intent "idleと接続枠を検査し満杯の間だけ上限付き待機枠を所有する"
  requires none
  ensures none
  effects net.client, random, clock, task.spawn, task.share, task.suspend
{
  let mut waiting = None;
  while true {
    let reused = take_idle(&pool)?;
    match reused {
      Some(held) => { return Ok(PgLease { held: Some(held), pool: pool.clone() }); }
      None => {}
    }
    match pool.connections.try_acquire() {
      Some(permit) => {
        if waiting.is_some() { let returned_waiter = waiting.take(); }
        let cfg = pool_config(&pool)?;
        let limits = PgConnectLimits { timeout_ms: pool.connect_ms };
        let conn = connect(cfg, &limits)?;
        return Ok(PgLease { held: Some(PgPooled { conn: conn, permit: permit }), pool: pool.clone() });
      }
      None => {}
    }
    if waiting.is_none() {
      match pool.waiters.try_acquire() {
        Some(permit) => { waiting = Some(permit); }
        None => { return Err(PgError.LimitExceeded); }
      }
    }
    task.yield();
  }
  return Err(PgError.Connection);
}

impl PgLease {
  pub fn query(self: &mut PgLease, sql: &String, params: &List<PgParam>, limits: &PgQueryLimits) -> Result<PgResult, PgError>
    intent "leaseの接続を操作の子へ移し取消では接続と容量を一緒に捨てる"
    requires none
    ensures none
    effects net.client, clock, task.spawn, task.suspend
  {
    let mut pending = self.held.take();
    let mut ms = self.pool.query_ms;
    if limits.timeout_ms < ms { ms = limits.timeout_ms; }
    match task.timeout(ms, || lease_query(&mut pending, &sql, &params, &limits)) {
      None => { return Err(PgError.Timeout); }
      Some(done) => {
        let (held, answer) = done;
        self.held = held;
        return answer;
      }
    }
  }

  pub fn release(self: PgLease) -> Result<Bool, PgError>
    intent "正常な明示返却だけを期限付き清掃しidleへ戻す"
    requires none
    ensures none
    effects net.client, clock, task.spawn, task.share, task.suspend
  {
    let pool = self.pool.clone();
    let mut pending = self.held;
    match task.timeout(pool.cleanup_ms, || release_pending(&pool, &mut pending)) {
      None => { return Err(PgError.Timeout); }
      Some(answer) => { return answer; }
    }
  }
}

fn lease_query(pending: &mut Option<PgPooled>, sql: &String, params: &List<PgParam>, limits: &PgQueryLimits) -> (Option<PgPooled>, Result<PgResult, PgError>)
  intent "子が接続と枠を所有し閉鎖された接続をleaseへ残さない"
  requires none
  ensures none
  effects net.client, clock, task.spawn, task.suspend
{
  match pending.take() {
    None => { return (None, Err(PgError.Connection)); }
    Some(owned) => {
      let mut held = owned;
      let answer = held.conn.query(&sql, &params, &limits);
      if held.conn.is_closed() { return (None, answer); }
      return (Some(held), answer);
    }
  }
}

fn release_pending(pool: &PgPool, pending: &mut Option<PgPooled>) -> Result<Bool, PgError>
  intent "idle確認とDISCARD ALLとhex再設定がすべて成功した接続だけを返す"
  requires none
  ensures none
  effects net.client, clock, task.spawn, task.share, task.suspend
{
  match pending.take() {
    None => { return Ok(false); }
    Some(owned) => {
      let mut held = owned;
      if held.conn.ready_status != 73 || held.conn.is_closed() { return Ok(false); }
      let limits = PgQueryLimits { timeout_ms: pool.cleanup_ms, max_wire: 4194304, max_rows: 10000 };
      let discarded = held.conn.query(&"DISCARD ALL", &List.new(), &limits)?;
      if discarded.status() != 73 || discarded.command() != "DISCARD ALL" { return Err(PgError.Protocol); }
      let reset = held.conn.query(&"SET bytea_output = 'hex'", &List.new(), &limits)?;
      if reset.status() != 73 || reset.command() != "SET" { return Err(PgError.Protocol); }
      let idle_lock = pool.idle.borrow();
      match idle_lock.acquire() {
        Err(e) => { return Err(PgError.LockBroken); }
        Ok(g0) => { let mut g = g0; return Ok(idle_put(g.get_mut(), held)); }
      }
    }
  }
}
