module std.os.sched
  targets server
  trust base

// タスクの実行の割り当て（ADR 0030 決定 1・2、PR 5-2d・5-2e）。ネイティブの実体。評価器は呼ばない（評価器は
// `src/ir_eval/sched.rs` が同じ意味を持つ）。ワーカー数 1 の決定的モード: 実行可能待ち行列は FIFO で、切り替えは
// 中断点でだけ起こり、時計は仮想（`task.sleep` は実時間で待たず、時計を最も早い目覚めまで進める）。
//
// - 生成コードが、このモジュールの関数を呼ぶ。値はすべて語（`Int`）で受け渡し、型は知らない。値を破棄する関数の番地は、
//   生成コードが渡してくる（チャネルの項・`Lock` の値・タスクの結果）。破棄は生成コードの役目で、ここは「捨てる値」の列
//   （ごみの列）に積み、生成コードが取り出して破棄する。
// - 状態の塊と各レコードは確保器から取る語の並び。添字（タスク・範囲・チャネル・`Lock` の番号）は評価器と同じく作った順の
//   連番で、`Scope`・`TaskHandle`・`Sender`・`Receiver`・`Lock` の値（`Int`）になる。
// - ブロックしうる操作（`join`・`recv`・`acquire`・`yield`・`sleep`・範囲の終わり）は、ブロックするときワーカー専用の「ブロック中」
//   の旗を立てて 0 を返す。生成コードは旗を見て、タスクの状態を保存して中断を返す。起こされるときの値は `take_resume` で渡る。
// - `Lock` の解放は、評価器と同じく遅延して反映する（`lock_release` は事象を積むだけで、次の `lock_acquire` の入口と
//   `next_task` の入口で `settle` が次の待機者へ渡す）。タスクの起こす順序が評価器と一致する。
// - 範囲は通常の範囲（`task.scope`）だけ。`timeout`・`race`・`all_ok` は未対応（生成コードがビルドで止める）。
// - 異常停止の隔離（ルートタスク単位）と `LockBroken` は、ルートタスクが 1 つの間は観測できないので持たない（5-2g）。
// - 共有の表・待ち行列・通知の世代は 1 本の futex 排他で守り、タスク本体は排他の外で並列に実行する。
// - 中断時の枠の保存が終わるまで T_ACTIVE を保ち、待機中に起こされても別ワーカーは枠を再開しない。
// - S_CUR・S_BLOCKED・S_YIELDED と取り消しの走査位置は、生成コードが整列スタック内のワーカー専用領域へ振り分ける。
// - 取り消しは対象を T_CANCEL で選択不能にし、T_ACTIVE が落ちるのを待ってから枠を巻き戻す。
// - 既定の台数は sched_getaffinity の CPU 数。SIGIL_WORKERS の正の整数で上書きし、1 で従来の FIFO と仮想時計を選ぶ。
// - 時計は 5-2d の仮想時計を引き継ぐ。fd の待ち（`io.wait_fd`。ADR 0031、PR 6-3c）を一度も登録していない間は、これまでどおり
//   仮想の時計（実行可能なタスクがなければ時計を最も早い目覚めまで飛ばす）。最初の fd の待ちの登録から**実時間モード**に入り、
//   戻らない（S_IO が 0 でなくなる）。実時間モードの時計は 登録時の仮想の時計 + 単調な実時間の経過（ミリ秒）で、実行可能な
//   タスクがなければ `epoll_wait`（`std.os.io` の I/O スレッド）の完了か期限まで futex で眠る。I/O スレッドは最初の登録で遅延して
//   作り、完了の列に積むたびにこの塊の S_EVENT を進めて起こす（`io_set_hook`）。完了の列からの取り出しと `wake` は、アイドルの
//   ワーカーと `next_task` が排他の下で行う。終了は `release` が `io_stop` → `join` → `io_free` で行う。
//
// 状態の塊 S の語: 0 タスク表, 1 数, 2 容量 / 3 範囲表, 4, 5 / 6 チャネル表, 7, 8 / 9 Lock 表, 10, 11 / 12 実行可能の先頭,
// 13 末尾 / 14 眠りの先頭 / 15 時計 / 16 連番 / 17 現在のタスク / 18 ブロック中 / 19 ルート完了 / 20 ルートの結果 /
// 21 ごみの先頭 / 22 ごみの末尾 / 23 Lock 事象の先頭 / 24 同末尾 / 25 取り消しの走査位置 / 36 I/O の状態（0 は実時間モードに入っていない）, 37 I/O スレッドのハンドル,
// 38 fd 待ちの数, 39 実時間モードに入った時刻（ナノ秒）, 40 そのときの仮想の時計, 41 登録済みの期限用タイマーの時刻（ナノ秒、0 は無し）。
//
// タスクのレコードの語: 0 状態, 1 枠, 2 起床の値, 3 結果, 4 結果の破棄, 5 属する範囲, 6 合流待ち, 7 実行可能の次,
// 8 待機の次, 9 番号, 10 眠りの時刻, 11 眠りの連番, 12 眠りの次, 13 待っている範囲, 14 結果あり, 15 兄弟の次。
// 範囲: 0 生きている子の数, 1 待っているタスク, 2 子の先頭, 3 子の末尾。
// チャネル: 0 項の先頭, 1 項の末尾（項は [次][値][破棄]）, 2 待機の先頭, 3 待機の末尾。
// Lock: 0 値（番地そのもの）, 1 保持者, 2 待機の先頭, 3 待機の末尾, 4 値の破棄。

use std.core.string.free;
use std.os.env.get;
use std.os.io.io_cancel;
use std.os.io.io_free;
use std.os.io.io_loop;
use std.os.io.io_new;
use std.os.io.io_now;
use std.os.io.io_set_hook;
use std.os.io.io_sleep_until;
use std.os.io.io_stop;
use std.os.io.io_take;
use std.os.io.io_wait_fd;
use std.os.thread.join;
use std.os.thread.spawn;

global mut SCHED: Int = 0

global T_STATE: Int = 0
global T_FRAME: Int = 1
global T_RESUME: Int = 2
global T_RESULT: Int = 3
global T_RETDROP: Int = 4
global T_SCOPE: Int = 5
global T_JOINER: Int = 6
global T_NEXT: Int = 7
global T_WNEXT: Int = 8
global T_ID: Int = 9
global T_SLEEP_AT: Int = 10
global T_SLEEP_SEQ: Int = 11
global T_SNEXT: Int = 12
global T_WAITSCOPE: Int = 13
global T_HASRES: Int = 14
global T_SIB: Int = 15
global T_HASRESUME: Int = 16
global T_SPIN_FP: Int = 17
global T_SPIN_VER: Int = 18
global T_SPIN_FLAG: Int = 19
global T_ACTIVE: Int = 20
global T_CANCEL: Int = 21
global T_WORDS: Int = 22

global ST_READY: Int = 1
global ST_RUNNING: Int = 2
global ST_JOINING: Int = 3
global ST_RECV: Int = 4
global ST_LOCKWAIT: Int = 5
global ST_SCOPING: Int = 6
global ST_SLEEPING: Int = 7
global ST_DONE: Int = 8
global ST_IOWAIT: Int = 9

global S_TASKS: Int = 0
global S_SCOPES: Int = 3
global S_CHANS: Int = 6
global S_LOCKS: Int = 9
global S_RHEAD: Int = 12
global S_RTAIL: Int = 13
global S_SLEEP: Int = 14
global S_CLOCK: Int = 15
global S_SEQ: Int = 16
global S_CUR: Int = 17
global S_BLOCKED: Int = 18
global S_RDONE: Int = 19
global S_RRES: Int = 20
global S_GHEAD: Int = 21
global S_GTAIL: Int = 22
global S_EHEAD: Int = 23
global S_ETAIL: Int = 24
global S_CANCEL_I: Int = 25
global S_VER: Int = 26
global S_YIELDED: Int = 27
global S_SAVED: Int = 28
global S_SCAN: Int = 29
global S_MUTEX: Int = 30
global S_EVENT: Int = 31
global S_ACTIVE: Int = 32
global S_STOP: Int = 33
global S_WORKERS: Int = 34
global S_HANDLES: Int = 35
global S_IO: Int = 36
global S_IOTHREAD: Int = 37
global S_IOPEND: Int = 38
global S_RT0: Int = 39
global S_RTCLK0: Int = 40
global S_TIMER_AT: Int = 41
global S_WORDS: Int = 42

// 期限用のトークン（タスクのトークンは 番号 + 1 で、これより小さい。std.os.io の範囲は 1..2147483646）。
global TIMER_TOKEN: Int = 2147483646

// 81920..82160 は作業の列・表示バッファの後の予約領域。生成コードが local の本体を置く。
fn local() -> Int
  intent "このワーカー専用の状態（生成コードが整列スタックから求める）"
  requires none
  ensures none
  effects none
{
  return 0;
}

fn slot(p: Int, i: Int) -> Int
  intent "共有レコードまたはワーカー専用の語の番地を求める"
  requires none
  ensures none
  effects none
  unchecked "SCHED は起動前に初期化され、全ワーカーの合流まで不変。local は生成コードが整列スタックから求める"
{
  if p == SCHED && (i == S_CUR || i == S_BLOCKED || i == S_YIELDED || i == S_SAVED || i == S_SCAN || i == S_CANCEL_I) {
    return local() + 8 * i;
  }
  return p + 8 * i;
}

fn ld(p: Int, i: Int) -> Int
  intent "レコード p の i 番目の語を読む"
  requires none
  ensures none
  effects none
  unchecked "p は rec が返した生きたレコードで、0 <= i はそのレコードの語数より小さい。共有の語はスケジューラの排他の下で読む。ワーカー専用の語は整列スタック内にあり、他のスレッドは触らない"
{
  return raw.load_i64(raw.int_to_addr(slot(p, i)));
}

fn st(p: Int, i: Int, v: Int)
  intent "レコード p の i 番目の語に v を書く"
  requires none
  ensures none
  effects none
  unchecked "p は rec が返した生きたレコードで、0 <= i はそのレコードの語数より小さい。共有の語はスケジューラの排他の下で書く。ワーカー専用の語は他のスレッドが触らない"
{
  raw.store_i64(raw.int_to_addr(slot(p, i)), v);
}

fn rec(words: Int) -> Int
  intent "words 語のレコードを確保し、0 で埋めて番地を返す"
  requires none
  ensures none
  effects none
  unchecked "確保器から取った領域を、返す前に 0 で埋める。words >= 1。rec_free で同じ語数を渡して返す"
{
  let a = raw.alloc(8 * words, 8);
  let p = raw.addr_to_int(a);
  let mut i = 0;
  while i < words {
    raw.store_i64(raw.int_to_addr(slot(p, i)), 0);
    i = i + 1;
  }
  return p;
}

fn rec_free(p: Int, words: Int)
  intent "rec が返したレコードを返す"
  requires none
  ensures none
  effects none
  unchecked "p は rec(words) が返し、まだ返していないレコード"
{
  raw.free(raw.int_to_addr(p), 8 * words, 8);
}

fn sched() -> Int
  intent "状態の塊を返す（初回に作る）"
  requires none
  ensures none
  effects none
  unchecked "大域 SCHED を読み書きする。初回はワーカー作成前に呼ぶ。その後は公開の入口の排他で守る。初回の呼び出しで作るので、同じ引数でも結果が変わる"
{
  if SCHED == 0 {
    SCHED = rec(S_WORDS);
  }
  return SCHED;
}

fn clear_sched()
  intent "状態の塊の大域を空に戻す"
  requires none
  ensures none
  effects none
  unchecked "大域 SCHED を書く。塊は呼び出し側が先に返している"
{
  SCHED = 0;
}

fn bump(s: Int)
  intent "共有の状態の版を進める（空転の検出が、状態が変わっていないかを見る）"
  requires none
  ensures none
  effects none
{
  st(s, S_VER, ld(s, S_VER) + 1);
}

// --- 表 ---

fn tab_push(s: Int, base: Int, p: Int) -> Int
  intent "表（語 base..base+2 = 配列・数・容量）に p を足し、その添字を返す"
  requires none
  ensures none
  effects none
{
  let len = ld(s, base + 1);
  let cap = ld(s, base + 2);
  if len == cap {
    let mut ncap = 8;
    if cap > 0 {
      ncap = cap * 2;
    }
    let nt = rec(ncap);
    let prev = ld(s, base);
    let mut i = 0;
    while i < len {
      st(nt, i, ld(prev, i));
      i = i + 1;
    }
    if cap > 0 {
      rec_free(prev, cap);
    }
    st(s, base, nt);
    st(s, base + 2, ncap);
  }
  st(ld(s, base), len, p);
  st(s, base + 1, len + 1);
  return len;
}

fn tab_get(s: Int, base: Int, i: Int) -> Int
  intent "表の i 番目を返す"
  requires none
  ensures none
  effects none
{
  return ld(ld(s, base), i);
}

fn tab_free(s: Int, base: Int)
  intent "表の配列を返す（要素は呼び出し側が先に返す）"
  requires none
  ensures none
  effects none
{
  let cap = ld(s, base + 2);
  if cap > 0 {
    rec_free(ld(s, base), cap);
  }
  st(s, base, 0);
  st(s, base + 1, 0);
  st(s, base + 2, 0);
}

// --- 待ち行列 ---

fn ready_push(s: Int, t: Int)
  intent "実行可能待ち行列の末尾にタスクを足す"
  requires none
  ensures none
  effects none
{
  st(t, T_NEXT, 0);
  let tail = ld(s, S_RTAIL);
  if tail == 0 {
    st(s, S_RHEAD, t);
  } else {
    st(tail, T_NEXT, t);
  }
  st(s, S_RTAIL, t);
}

fn ready_pop(s: Int) -> Int
  intent "実行可能待ち行列の先頭を取り出す（なければ 0）"
  requires none
  ensures none
  effects none
{
  let t = ld(s, S_RHEAD);
  if t == 0 {
    return 0;
  }
  let n = ld(t, T_NEXT);
  st(s, S_RHEAD, n);
  if n == 0 {
    st(s, S_RTAIL, 0);
  }
  st(t, T_NEXT, 0);
  return t;
}

fn wq_push(o: Int, ih: Int, t: Int)
  intent "待機の列（オブジェクト o の語 ih = 先頭、ih+1 = 末尾）の末尾にタスクを足す"
  requires none
  ensures none
  effects none
{
  st(t, T_WNEXT, 0);
  let tail = ld(o, ih + 1);
  if tail == 0 {
    st(o, ih, t);
  } else {
    st(tail, T_WNEXT, t);
  }
  st(o, ih + 1, t);
}

fn wq_pop(o: Int, ih: Int) -> Int
  intent "待機の列の先頭を取り出す（なければ 0）"
  requires none
  ensures none
  effects none
{
  let t = ld(o, ih);
  if t == 0 {
    return 0;
  }
  let n = ld(t, T_WNEXT);
  st(o, ih, n);
  if n == 0 {
    st(o, ih + 1, 0);
  }
  st(t, T_WNEXT, 0);
  return t;
}

fn wake(s: Int, t: Int, v: Int, has: Bool)
  intent "タスクを起こす（has なら起床の値を v にする）。実行可能待ち行列の末尾に足す"
  requires none
  ensures none
  effects none
{
  bump(s);
  if has {
    st(t, T_RESUME, v);
    st(t, T_HASRESUME, 1);
  }
  st(t, T_STATE, ST_READY);
  ready_push(s, t);
}

// --- ごみの列（生成コードが破棄する値） ---

fn garbage_push(s: Int, v: Int, dropfn: Int)
  intent "破棄する値を列に積む（破棄の関数が 0 の値は破棄が要らないので積まない）"
  requires none
  ensures none
  effects none
{
  if dropfn == 0 {
    return;
  }
  let n = rec(3);
  st(n, 1, v);
  st(n, 2, dropfn);
  let tail = ld(s, S_GTAIL);
  if tail == 0 {
    st(s, S_GHEAD, n);
  } else {
    st(tail, 0, n);
  }
  st(s, S_GTAIL, n);
}

fn garbage_pop_locked() -> Int
  intent "ごみの列の先頭の項を取り出す（なければ 0）。項は [次][値][破棄の関数] で、呼び出し側が garbage_free で返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let n = ld(s, S_GHEAD);
  if n == 0 {
    return 0;
  }
  let nx = ld(n, 0);
  st(s, S_GHEAD, nx);
  if nx == 0 {
    st(s, S_GTAIL, 0);
  }
  return n;
}

fn garbage_free_locked(n: Int)
  intent "garbage_pop が返した項を返す"
  requires none
  ensures none
  effects none
{
  rec_free(n, 3);
}

// --- ルートタスクと実行の割り当て ---

fn new_task(s: Int, frame: Int, retdrop: Int, sid: Int) -> Int
  intent "タスクのレコードを作って表に足す（番号は作った順）"
  requires none
  ensures none
  effects none
{
  let t = rec(T_WORDS);
  st(t, T_STATE, ST_READY);
  st(t, T_FRAME, frame);
  st(t, T_RETDROP, retdrop);
  st(t, T_SCOPE, sid);
  st(t, T_WAITSCOPE, 0 - 1);
  st(t, T_ID, tab_push(s, S_TASKS, t));
  return t;
}

fn start_locked(frame: Int, retdrop: Int) -> Int
  intent "ルートタスク（番号 0）を作り、実行可能待ち行列に積む"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let t = new_task(s, frame, retdrop, 0 - 1);
  ready_push(s, t);
  return 0;
}

fn settle(s: Int)
  intent "積んだ Lock の解放を反映する。待機者がいれば先頭に渡して起こす"
  requires none
  ensures none
  effects none
{
  let mut e = ld(s, S_EHEAD);
  st(s, S_EHEAD, 0);
  st(s, S_ETAIL, 0);
  while e != 0 {
    let nx = ld(e, 0);
    let l = ld(e, 1);
    st(l, 1, 0);
    let w = wq_pop(l, 2);
    if w != 0 {
      st(l, 1, w);
      wake(s, w, l, true);
    }
    rec_free(e, 2);
    e = nx;
  }
}

fn next_task_locked() -> Int
  intent "実行可能なタスクの先頭を取り出して現在のタスクにし、その枠を返す（なければ 0）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  if ld(s, S_STOP) != 0 || ld(s, S_RDONE) != 0 { return 0; }
  settle(s);
  if ld(s, S_IO) != 0 { io_poll_locked(s); }
  st(s, S_BLOCKED, 0);
  let mut t = ld(s, S_RHEAD);
  let mut prev = 0;
  while t != 0 && (ld(t, T_ACTIVE) != 0 || ld(t, T_CANCEL) != 0) {
    let nx = ld(t, T_NEXT);
    if ld(t, T_CANCEL) != 0 {
      // 取り消し済みの要素は残さない。idle が空でない列を見て空転するのを防ぐ。
      if prev == 0 { ready_pop(s); } else {
        st(prev, T_NEXT, nx);
        if ld(s, S_RTAIL) == t { st(s, S_RTAIL, prev); }
        st(t, T_NEXT, 0);
      }
    } else {
      prev = t;
    }
    t = nx;
  }
  if t == 0 {
    return 0;
  }
  if prev == 0 {
    ready_pop(s);
  } else {
    st(prev, T_NEXT, ld(t, T_NEXT));
    if ld(s, S_RTAIL) == t { st(s, S_RTAIL, prev); }
    st(t, T_NEXT, 0);
  }
  st(t, T_ACTIVE, 1);
  st(s, S_ACTIVE, ld(s, S_ACTIVE) + 1);
  st(s, S_CUR, t);
  st(t, T_STATE, ST_RUNNING);
  return ld(t, T_FRAME);
}

fn blocked_locked() -> Int
  intent "直前の操作が現在のタスクをブロックしたか（1 / 0）"
  requires none
  ensures none
  effects none
{
  return ld(sched(), S_BLOCKED);
}

fn take_resume_locked() -> Int
  intent "現在のタスクの起床の値を返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let t = ld(s, S_CUR);
  st(t, T_HASRESUME, 0);
  return ld(t, T_RESUME);
}

fn has_resume_locked() -> Int
  intent "現在のタスクが、まだ受け取っていない起床の値を持つか（1 / 0）。取り消しで、その値を破棄するために使う"
  requires none
  ensures none
  effects none
{
  let s = sched();
  return ld(ld(s, S_CUR), T_HASRESUME);
}

fn advance_clock(s: Int)
  intent "時計を最も早い目覚めまで進め、その時刻の眠りのタスクを連番の小さい順に起こす（眠りがあること）"
  requires none
  ensures none
  effects none
{
  let mut best = ld(s, S_SLEEP);
  let mut t = ld(best, T_SNEXT);
  while t != 0 {
    let a = ld(t, T_SLEEP_AT);
    let b = ld(best, T_SLEEP_AT);
    if a < b || (a == b && ld(t, T_SLEEP_SEQ) < ld(best, T_SLEEP_SEQ)) {
      best = t;
    }
    t = ld(t, T_SNEXT);
  }
  let at = ld(best, T_SLEEP_AT);
  st(s, S_CLOCK, at);
  let mut go = true;
  while go {
    let mut pick = 0;
    let mut p = ld(s, S_SLEEP);
    while p != 0 {
      if ld(p, T_SLEEP_AT) == at {
        if pick == 0 || ld(p, T_SLEEP_SEQ) < ld(pick, T_SLEEP_SEQ) {
          pick = p;
        }
      }
      p = ld(p, T_SNEXT);
    }
    if pick == 0 {
      go = false;
    } else {
      sleep_unlink(s, pick);
      wake(s, pick, 0, true);
    }
  }
}

fn rt_clock(s: Int) -> Int
  intent "実時間モードの時計（ミリ秒）: 入った時点の仮想の時計 + 実時間の経過。仮想の時計より戻さない"
  requires none
  ensures none
  effects none
{
  let c = ld(s, S_RTCLK0) + (io_now() - ld(s, S_RT0)) / 1000000;
  if c < ld(s, S_CLOCK) { return ld(s, S_CLOCK); }
  return c;
}

fn rt_clock_up(s: Int) -> Int
  intent "実時間モードの時計（ミリ秒、切り上げ）。眠りの期限を作るのに使い、期限が要求より早くならないようにする"
  requires none
  ensures none
  effects none
{
  let c = ld(s, S_RTCLK0) + (io_now() - ld(s, S_RT0) + 999999) / 1000000;
  if c < ld(s, S_CLOCK) { return ld(s, S_CLOCK); }
  return c;
}

fn io_enter(s: Int) -> Bool
  intent "実時間モードに入る（最初の fd の待ちの登録で一度だけ）: I/O の状態と I/O スレッドを作る。失敗なら false"
  requires none
  ensures none
  effects none
  unchecked "SCHED の排他を取得済み。I/O の状態は io_new が返した値で、スレッドの本体（io_loop）が読む間は release まで生きる。ハンドルは release が一度だけ join する"
{
  if ld(s, S_IO) != 0 { return true; }
  let io = io_new();
  if io == 0 { return false; }
  let hook = s + 8 * S_EVENT;
  io_set_hook(io, hook);
  let h = spawn(raw.int_to_addr(io));
  if raw.addr_to_int(h) == 0 {
    io_free(io);
    return false;
  }
  st(s, S_IOTHREAD, raw.addr_to_int(h));
  st(s, S_RT0, io_now());
  st(s, S_RTCLK0, ld(s, S_CLOCK));
  st(s, S_IO, io);
  return true;
}

fn io_wait_locked(fd: Int, events: Int) -> Int
  intent "現在のタスクを fd の準備完了まで待たせる（io.wait_fd）。登録に失敗したらブロックせず負の errno を返す。起こされる値は準備のできたイベントの印"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let t = ld(s, S_CUR);
  let token = ld(t, T_ID) + 1;
  if token >= TIMER_TOKEN { return 0 - 22; }
  if !io_enter(s) { return 0 - 12; }
  let r = io_wait_fd(ld(s, S_IO), fd, events, token);
  if r < 0 { return r; }
  bump(s);
  st(t, T_RESUME, 0);
  st(t, T_STATE, ST_IOWAIT);
  st(s, S_IOPEND, ld(s, S_IOPEND) + 1);
  st(s, S_BLOCKED, 1);
  return 0;
}

fn io_unwait(s: Int, t: Int)
  intent "fd の待ちのタスクを取り消す前に、I/O の登録・期限・取り出していない完了を外す（close より先）"
  requires none
  ensures none
  effects none
{
  if ld(t, T_STATE) == ST_IOWAIT {
    io_cancel(ld(s, S_IO), ld(t, T_ID) + 1);
    st(s, S_IOPEND, ld(s, S_IOPEND) - 1);
    st(t, T_STATE, ST_READY);
  }
}

fn due_sleepers(s: Int, clock: Int)
  intent "実時間モード: 時刻が clock に届いた眠りのタスクを、時刻・連番の順に起こす。時計は clock にする"
  requires none
  ensures none
  effects none
{
  while ld(s, S_SLEEP) != 0 {
    let mut best = ld(s, S_SLEEP);
    let mut t = ld(best, T_SNEXT);
    while t != 0 {
      let a = ld(t, T_SLEEP_AT);
      let b = ld(best, T_SLEEP_AT);
      if a < b || (a == b && ld(t, T_SLEEP_SEQ) < ld(best, T_SLEEP_SEQ)) {
        best = t;
      }
      t = ld(t, T_SNEXT);
    }
    if ld(best, T_SLEEP_AT) > clock { return; }
    sleep_unlink(s, best);
    wake(s, best, 0, true);
  }
}

fn io_poll_locked(s: Int) -> Int
  intent "実時間モード: 完了の列から実行可能待ち行列へ起こす（wake）。届いた期限の眠りも起こす。起こした数を返す"
  requires none
  ensures none
  effects none
{
  let io = ld(s, S_IO);
  if io == 0 { return 0; }
  let out = rec(4);
  let mut n = 0;
  while io_take(io, out) == 1 {
    let token = ld(out, 0);
    if token == TIMER_TOKEN {
      st(s, S_TIMER_AT, 0);
    } else {
      let t = tab_get(s, S_TASKS, token - 1);
      if ld(t, T_STATE) == ST_IOWAIT {
        st(s, S_IOPEND, ld(s, S_IOPEND) - 1);
        wake(s, t, ld(out, 2), true);
        n = n + 1;
      }
    }
  }
  rec_free(out, 4);
  let before = ld(s, S_RHEAD);
  let clock = rt_clock(s);
  due_sleepers(s, clock);
  st(s, S_CLOCK, clock);
  if ld(s, S_RHEAD) != before { n = n + 1; }
  return n;
}

fn arm_timer(s: Int)
  intent "実時間モード: 最も近い眠りの時刻に I/O スレッドの期限（epoll_wait のタイムアウト）を 1 つ登録する"
  requires none
  ensures none
  effects none
{
  let mut at = 0;
  let mut t = ld(s, S_SLEEP);
  while t != 0 {
    if at == 0 || ld(t, T_SLEEP_AT) < at { at = ld(t, T_SLEEP_AT); }
    t = ld(t, T_SNEXT);
  }
  if at == 0 { return; }
  // 時刻 0 の眠りは即座に届くので、ここへは来ない（due_sleepers が起こす）。ナノ秒への換算は飽和させる。
  let mut deadline = 9223372036854775807;
  if at - ld(s, S_RTCLK0) < 9000000000000 {
    deadline = ld(s, S_RT0) + (at - ld(s, S_RTCLK0)) * 1000000;
  }
  let armed = ld(s, S_TIMER_AT);
  if armed != 0 && armed <= deadline { return; }
  io_cancel(ld(s, S_IO), TIMER_TOKEN);
  io_sleep_until(ld(s, S_IO), deadline, TIMER_TOKEN);
  st(s, S_TIMER_AT, deadline);
}

fn idle_locked() -> Int
  intent "実行可能なタスクがないとき、時計を進めて眠りのタスクを起こす。眠りがなければ 0（デッドロック）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  if ld(s, S_STOP) != 0 || ld(s, S_RDONE) != 0 { return 1; }
  if ld(s, S_ACTIVE) != 0 {
    wait_event(s);
    return 1;
  }
  if ld(s, S_IO) != 0 {
    // 実時間モード: 時計を飛ばさず、完了と期限を待つ（fd の待ちが残る間はデッドロックにしない）。
    io_poll_locked(s);
    if ld(s, S_RHEAD) != 0 { return 1; }
    if ld(s, S_IOPEND) == 0 && ld(s, S_SLEEP) == 0 {
      st(s, S_CUR, 0);
      return 0;
    }
    arm_timer(s);
    wait_io(s);
    return 1;
  }
  if ld(s, S_RHEAD) != 0 { return 1; }
  if ld(s, S_SLEEP) == 0 {
    // デッドロック: 最後にブロックしたタスクも取り消しの対象にする（枠はまだ片付けられていない）。
    st(s, S_CUR, 0);
    return 0;
  }
  advance_clock(s);
  notify();
  return 1;
}

fn yield_plain_locked()
  intent "task.yield: yield_val_locked(0) に、空転の検出の対象になる印を付ける"
  requires none
  ensures none
  effects none
{
  yield_val_locked(0);
  st(sched(), S_YIELDED, 1);
}

fn yielded_locked() -> Int
  intent "直前の中断が task.yield だったか（1 / 0）。読むと印を消す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let y = ld(s, S_YIELDED);
  st(s, S_YIELDED, 0);
  return y;
}

fn note_yield_locked(fp: Int)
  intent "task.yield で中断したタスクの枠の指紋を記録する。実行可能なタスクがすべて、状態の版も指紋も変わらないまま 2 回続けて譲っているなら（空転）、眠りのタスクがいれば時計を進める（評価器の yield_livelock と同じ。眠りがないときの停止は持たない）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let t = ld(s, S_CUR);
  let ver = ld(s, S_VER);
  let mut same = 0;
  if fp != 0 && ld(t, T_SPIN_FP) == fp && ld(t, T_SPIN_VER) == ver {
    same = 1;
  }
  st(t, T_SPIN_FP, fp);
  st(t, T_SPIN_VER, ver);
  st(t, T_SPIN_FLAG, same);
  let mut all = true;
  let mut r = ld(s, S_RHEAD);
  while r != 0 {
    if ld(r, T_SPIN_FLAG) == 0 || ld(r, T_SPIN_VER) != ver {
      all = false;
    }
    r = ld(r, T_NEXT);
  }
  if all && ld(s, S_SLEEP) != 0 && ld(s, S_IO) == 0 {
    advance_clock(s);
  }
}

fn sleep_unlink(s: Int, t: Int)
  intent "眠りの列からタスクを外す"
  requires none
  ensures none
  effects none
{
  let head = ld(s, S_SLEEP);
  if head == t {
    st(s, S_SLEEP, ld(t, T_SNEXT));
  } else {
    let mut p = head;
    while p != 0 && ld(p, T_SNEXT) != t {
      p = ld(p, T_SNEXT);
    }
    if p != 0 {
      st(p, T_SNEXT, ld(t, T_SNEXT));
    }
  }
  st(t, T_SNEXT, 0);
}

fn root_done_locked() -> Int
  intent "ルートタスクが完了したか（1 / 0）"
  requires none
  ensures none
  effects none
{
  return ld(sched(), S_RDONE);
}

fn root_result_locked() -> Int
  intent "ルートタスクの結果の値"
  requires none
  ensures none
  effects none
{
  return ld(sched(), S_RRES);
}

// --- 範囲・生成・合流 ---

fn scope_begin_locked() -> Int
  intent "範囲を作って番号を返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let sc = rec(5);
  st(sc, 4, ld(s, S_CUR));
  return tab_push(s, S_SCOPES, sc);
}

fn finish_scope(s: Int, sc: Int)
  intent "範囲の子の、受け取られなかった結果をごみの列に積む（作った順）"
  requires none
  ensures none
  effects none
{
  let mut c = ld(sc, 2);
  while c != 0 {
    if ld(c, T_HASRES) != 0 {
      st(c, T_HASRES, 0);
      garbage_push(s, ld(c, T_RESULT), ld(c, T_RETDROP));
    }
    c = ld(c, T_SIB);
  }
}

fn scope_end_locked(sid: Int) -> Int
  intent "範囲の本体が戻った。生きている子がいれば現在のタスクを待たせて 1、いなければ後始末をして 0"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let sc = tab_get(s, S_SCOPES, sid);
  let t = ld(s, S_CUR);
  if ld(sc, 0) > 0 {
    st(sc, 1, t);
    st(t, T_STATE, ST_SCOPING);
    st(t, T_WAITSCOPE, sid);
    st(s, S_BLOCKED, 1);
    return 1;
  }
  finish_scope(s, sc);
  return 0;
}

fn spawn_locked(sid: Int, frame: Int, retdrop: Int) -> Int
  intent "範囲 sid にタスクを起こす。枠は生成コードが用意したもの。タスクの番号を返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let sc = tab_get(s, S_SCOPES, sid);
  let t = new_task(s, frame, retdrop, sid);
  // 取り消しの待機中に動いている親が作った子も、選択不能にして走査に含める。
  let cur = ld(s, S_CUR);
  if cur != 0 && ld(cur, T_CANCEL) != 0 { st(t, T_CANCEL, 1); }
  st(sc, 0, ld(sc, 0) + 1);
  let tail = ld(sc, 3);
  if tail == 0 {
    st(sc, 2, t);
  } else {
    st(tail, T_SIB, t);
  }
  st(sc, 3, t);
  ready_push(s, t);
  return ld(t, T_ID);
}

fn join_locked(tid: Int) -> Int
  intent "タスクの結果を受け取る。まだ終わっていなければ現在のタスクを待たせて 0 を返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let t = tab_get(s, S_TASKS, tid);
  let cur = ld(s, S_CUR);
  if ld(t, T_STATE) == ST_DONE && ld(t, T_CANCEL) == 0 {
    let v = ld(t, T_RESULT);
    st(t, T_HASRES, 0);
    return v;
  }
  st(t, T_JOINER, cur);
  st(cur, T_STATE, ST_JOINING);
  st(s, S_BLOCKED, 1);
  return 0;
}

fn finish_task_locked(v: Int)
  intent "現在のタスクが値 v で完了した。合流待ちと範囲の待ち手を起こす"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let t = ld(s, S_CUR);
  st(t, T_STATE, ST_DONE);
  st(t, T_FRAME, 0);
  let sid = ld(t, T_SCOPE);
  if sid < 0 {
    st(s, S_RDONE, 1);
    st(s, S_RRES, v);
    return;
  }
  let j = ld(t, T_JOINER);
  st(t, T_JOINER, 0);
  if j != 0 {
    wake(s, j, v, true);
  } else {
    st(t, T_RESULT, v);
    st(t, T_HASRES, 1);
  }
  let sc = tab_get(s, S_SCOPES, sid);
  let live = ld(sc, 0);
  if live > 0 {
    st(sc, 0, live - 1);
  }
  if ld(sc, 0) == 0 {
    let w = ld(sc, 1);
    if w != 0 {
      st(sc, 1, 0);
      st(w, T_WAITSCOPE, 0 - 1);
      finish_scope(s, sc);
      wake(s, w, 0, false);
    }
  }
}

fn yield_val_locked(v: Int)
  intent "現在のタスクを実行可能待ち行列の末尾に戻して中断する。起床の値は v"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let t = ld(s, S_CUR);
  st(t, T_RESUME, v);
  st(t, T_HASRESUME, 1);
  st(t, T_STATE, ST_READY);
  ready_push(s, t);
  st(s, S_BLOCKED, 1);
}

fn sleep_locked(ms: Int)
  intent "現在のタスクを仮想の時計で ms 待たせる（負は 0）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let t = ld(s, S_CUR);
  let mut d = ms;
  if d < 0 {
    d = 0;
  }
  bump(s);
  let seq = ld(s, S_SEQ) + 1;
  st(s, S_SEQ, seq);
  // 飽和加算（評価器の saturating_add と同じ）。実時間モードでは、基準を現在の実時間の時計にする。
  let mut clock = ld(s, S_CLOCK);
  if ld(s, S_IO) != 0 {
    // 期限は切り捨て前の実時間から作り、ミリ秒に切り上げる（切り捨てた時刻から作ると、最大 1 ミリ秒早く起きる）。
    // 時計 S_CLOCK 自体は切り捨てた値のまま進める（時計が実時間より先へ出ないように）。
    st(s, S_CLOCK, rt_clock(s));
    clock = rt_clock_up(s);
  }
  let mut at = 9223372036854775807;
  if d <= 9223372036854775807 - clock {
    at = clock + d;
  }
  st(t, T_SLEEP_AT, at);
  st(t, T_SLEEP_SEQ, seq);
  st(t, T_SNEXT, ld(s, S_SLEEP));
  st(s, S_SLEEP, t);
  st(t, T_RESUME, 0);
  st(t, T_STATE, ST_SLEEPING);
  st(s, S_BLOCKED, 1);
}

// --- チャネル ---

fn chan_new_locked() -> Int
  intent "チャネルを作って番号を返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  return tab_push(s, S_CHANS, rec(4));
}

fn chan_send_locked(id: Int, v: Int, dropfn: Int)
  intent "チャネルに値を送る。待っているタスクがいれば先頭に渡して起こし、いなければ項を積む。dropfn は値を破棄する関数の番地（0 なら不要）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let c = tab_get(s, S_CHANS, id);
  let w = wq_pop(c, 2);
  if w != 0 {
    wake(s, w, v, true);
    return;
  }
  let n = rec(3);
  st(n, 1, v);
  st(n, 2, dropfn);
  let tail = ld(c, 1);
  if tail == 0 {
    st(c, 0, n);
  } else {
    st(tail, 0, n);
  }
  st(c, 1, n);
}

fn chan_recv_locked(id: Int) -> Int
  intent "チャネルから値を受け取る。空なら現在のタスクを待たせて 0 を返す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let c = tab_get(s, S_CHANS, id);
  let n = ld(c, 0);
  if n != 0 {
    let nx = ld(n, 0);
    st(c, 0, nx);
    if nx == 0 {
      st(c, 1, 0);
    }
    let v = ld(n, 1);
    rec_free(n, 3);
    return v;
  }
  let cur = ld(s, S_CUR);
  wq_push(c, 2, cur);
  st(cur, T_STATE, ST_RECV);
  st(s, S_BLOCKED, 1);
  return 0;
}

// --- Lock ---

fn lock_new_locked(v: Int, dropfn: Int) -> Int
  intent "Lock を作って番号を返す。v は保護する値の語、dropfn はそれを破棄する関数の番地（0 なら不要）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  let l = rec(5);
  st(l, 0, v);
  st(l, 4, dropfn);
  return tab_push(s, S_LOCKS, l);
}

fn lock_acquire_locked(id: Int) -> Int
  intent "Lock を取る。取れたら Lock のレコードの番地、保持者がいれば現在のタスクを待たせて 0"
  requires none
  ensures none
  effects none
{
  let s = sched();
  bump(s);
  settle(s);
  let l = tab_get(s, S_LOCKS, id);
  let cur = ld(s, S_CUR);
  if ld(l, 1) == 0 {
    st(l, 1, cur);
    return l;
  }
  wq_push(l, 2, cur);
  st(cur, T_STATE, ST_LOCKWAIT);
  st(s, S_BLOCKED, 1);
  return 0;
}

fn lock_release_locked(l: Int)
  intent "LockGuard の破棄の知らせ。反映は次の settle まで遅らせる（評価器と起こす順序を揃える）"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let e = rec(2);
  st(e, 1, l);
  let tail = ld(s, S_ETAIL);
  if tail == 0 {
    st(s, S_EHEAD, e);
  } else {
    st(tail, 0, e);
  }
  st(s, S_ETAIL, e);
}

// --- 取り消しと後始末 ---

fn cancel_next_locked() -> Int
  intent "取り消すタスクの枠を、作った順の逆に 1 つ返す（現在のタスク・完了済み・枠のないものは飛ばす）。なければ 0"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let mut i = ld(s, S_CANCEL_I);
  if i == 0 {
    // 失敗した現在のタスクは、枠を呼び出し側が片付け済みなので対象にしない（デッドロックでは現在のタスクが空）。
    let cur = ld(s, S_CUR);
    if cur != 0 {
      st(cur, T_STATE, ST_DONE);
    }
    i = ld(s, S_TASKS + 1);
  }
  while i > 0 {
    i = i - 1;
    let t = tab_get(s, S_TASKS, i);
    // 完了済みで受け取られていない結果は、走査のこの位置で破棄させる（-1 を返し、呼び出し側が先にごみの列を空にする）。
    if ld(t, T_STATE) == ST_DONE && ld(t, T_HASRES) != 0 {
      st(t, T_HASRES, 0);
      garbage_push(s, ld(t, T_RESULT), ld(t, T_RETDROP));
      st(s, S_CANCEL_I, i);
      return 0 - 1;
    }
    if ld(t, T_STATE) != ST_DONE && ld(t, T_FRAME) != 0 {
      io_unwait(s, t);
      st(s, S_CANCEL_I, i);
      st(s, S_CUR, t);
      st(t, T_STATE, ST_DONE);
      let f = ld(t, T_FRAME);
      st(t, T_FRAME, 0);
      return f;
    }
  }
  st(s, S_CANCEL_I, 0 - 1);
  return 0;
}

fn defer_drop_locked(v: Int, dropfn: Int)
  intent "破棄する値を、ごみの列に積む（取り消しの途中で、局所の後に破棄させるため）"
  requires none
  ensures none
  effects none
{
  garbage_push(sched(), v, dropfn);
}

fn in_scope(s: Int, t: Int, sid: Int) -> Bool
  intent "タスク t が範囲 sid の子孫か（t を起こした範囲から、その範囲を作ったタスクの範囲へとたどる）"
  requires none
  ensures none
  effects none
{
  let mut x = ld(t, T_SCOPE);
  while x >= 0 {
    if x == sid {
      return true;
    }
    let creator = ld(tab_get(s, S_SCOPES, x), 4);
    if creator == 0 {
      return false;
    }
    x = ld(creator, T_SCOPE);
  }
  return false;
}

fn scope_cancel_next_locked(sid: Int) -> Int
  intent "範囲 sid の子孫のタスクを、作った順の逆に 1 つ取り消す。枠を返す（完了済みの未回収の結果は、積んで -1 を返す）。なければ 0 で、現在のタスクを元に戻す"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let mut i = 0;
  if ld(s, S_SAVED) == 0 {
    let me = ld(s, S_CUR);
    st(s, S_SAVED, me);
    // 排他を放す前に全子孫を選択不能にする。枠の巻き戻しは全員の停止後。
    let mut active = true;
    while active {
      active = false;
      let mut j = 0;
      while j < ld(s, S_TASKS + 1) {
        let t = tab_get(s, S_TASKS, j);
        if t != me && in_scope(s, t, sid) {
          st(t, T_CANCEL, 1);
          if ld(t, T_ACTIVE) != 0 { active = true; }
        }
        j = j + 1;
      }
      // 待機中に spawn された子孫も、再走査してから走査範囲を確定する。
      if active { wait_event(s); }
    }
    i = ld(s, S_TASKS + 1);
  } else {
    i = ld(s, S_SCAN);
  }
  let me = ld(s, S_SAVED);
  while i > 0 {
    i = i - 1;
    let t = tab_get(s, S_TASKS, i);
    if t != me && in_scope(s, t, sid) {
      if ld(t, T_STATE) == ST_DONE && ld(t, T_HASRES) != 0 {
        st(t, T_HASRES, 0);
        garbage_push(s, ld(t, T_RESULT), ld(t, T_RETDROP));
        st(s, S_SCAN, i);
        return 0 - 1;
      }
      if ld(t, T_STATE) != ST_DONE && ld(t, T_FRAME) != 0 {
        io_unwait(s, t);
        st(s, S_SCAN, i);
        st(s, S_CUR, t);
        st(t, T_STATE, ST_DONE);
        let f = ld(t, T_FRAME);
        st(t, T_FRAME, 0);
        return f;
      }
    }
  }
  st(s, S_CUR, me);
  st(s, S_SAVED, 0);
  return 0;
}

fn collect_garbage_locked()
  intent "残っている値（受け取られなかったタスクの結果・チャネルの項・Lock の値）をごみの列に積む"
  requires none
  ensures none
  effects none
{
  let s = sched();
  let n = ld(s, S_TASKS + 1);
  let mut i = n;
  while i > 0 {
    i = i - 1;
    let t = tab_get(s, S_TASKS, i);
    if ld(t, T_HASRES) != 0 {
      st(t, T_HASRES, 0);
      garbage_push(s, ld(t, T_RESULT), ld(t, T_RETDROP));
    }
  }
  let nc = ld(s, S_CHANS + 1);
  let mut j = 0;
  while j < nc {
    let c = tab_get(s, S_CHANS, j);
    let mut it = ld(c, 0);
    while it != 0 {
      garbage_push(s, ld(it, 1), ld(it, 2));
      it = ld(it, 0);
    }
    j = j + 1;
  }
  let nl = ld(s, S_LOCKS + 1);
  let mut k = 0;
  while k < nl {
    let l = tab_get(s, S_LOCKS, k);
    garbage_push(s, ld(l, 0), ld(l, 4));
    st(l, 0, 0);
    k = k + 1;
  }
}

fn release_locked()
  intent "すべてのレコードと状態の塊を返す。ごみの列は先に空にしておく"
  requires none
  ensures none
  effects none
  unchecked "全ワーカーの合流の後に主スレッドだけが呼ぶ。I/O スレッドのハンドルは io_enter が作ったもので、ここで一度だけ join する"
{
  let s = sched();
  settle(s);
  if ld(s, S_IO) != 0 {
    // 全ワーカーの合流の後: I/O スレッドを止めて合流し、I/O の状態を返す（登録した記述子は閉じない）。
    io_stop(ld(s, S_IO));
    join(raw.int_to_addr(ld(s, S_IOTHREAD)));
    io_free(ld(s, S_IO));
    st(s, S_IO, 0);
  }
  let n = ld(s, S_TASKS + 1);
  let mut i = 0;
  while i < n {
    rec_free(tab_get(s, S_TASKS, i), T_WORDS);
    i = i + 1;
  }
  tab_free(s, S_TASKS);
  let ns = ld(s, S_SCOPES + 1);
  let mut j = 0;
  while j < ns {
    rec_free(tab_get(s, S_SCOPES, j), 5);
    j = j + 1;
  }
  tab_free(s, S_SCOPES);
  let nc = ld(s, S_CHANS + 1);
  let mut k = 0;
  while k < nc {
    let c = tab_get(s, S_CHANS, k);
    let mut it = ld(c, 0);
    while it != 0 {
      let nx = ld(it, 0);
      rec_free(it, 3);
      it = nx;
    }
    rec_free(c, 4);
    k = k + 1;
  }
  tab_free(s, S_CHANS);
  let nl = ld(s, S_LOCKS + 1);
  let mut m = 0;
  while m < nl {
    rec_free(tab_get(s, S_LOCKS, m), 5);
    m = m + 1;
  }
  tab_free(s, S_LOCKS);
  rec_free(s, S_WORDS);
  clear_sched();
}

