module std.os.fs
  targets server
  trust base

// `fs.read`・`fs.write` の Sigil 実装（ADR 0025 補足 C-7 の 3-6b、補足 K）。ネイティブの実体。
// 評価器の `fs.read`/`fs.write` は Rust の組み込みのまま（補足 C-7）で、ここは呼ばない。ネイティブはシムから呼ぶ。
//
// - `read`: openat(AT_FDCWD, path, O_RDONLY|O_CLOEXEC) → read を 0（終わり）が返るまで繰り返す（-4 EINTR は再試行）→ close。
//   読んだバイト列は `std.core.string.valid_utf8` で検証し、不正なら Other（`new` は検証しないので、必ず検証してから呼ぶ）。
// - `write`: openat(…, O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC, 0o666) → write を全部書き終えるまで繰り返す
//   （部分書き込みは残りから、-4 は同じ位置から再試行、0 は Other）→ close（失敗は無視する）。
// - openat の -4 も再試行する。パスに NUL を含む場合は Rust の `std::fs` と同じく Other（システムコールを発行しない）。
// - errno の分類: ENOENT(2)→NotFound(0)、EACCES(13)・EPERM(1)→PermissionDenied(1)、それ以外→Other(2)（`src/shared/path.rs` の `io_arm`）。
// 失敗の種類は `kind` の番地（8 バイト）に書く。`std.os.console` と同じく入口の `targets` との照合は免除する（補足 J・K）。
// 排他を持たない単一スレッド前提（補足 A-5）。利用者のモジュールからは `use std.*` できない（ADR 0016 決定 3）。

use std.core.bytes.from_raw;
use std.core.string.new;
use std.core.string.valid_utf8;

fn classify(r: Int) -> Int
  intent "負の errno（-r）を IoError の腕の番号（0 NotFound, 1 PermissionDenied, 2 Other）にする"
  requires none
  ensures none
  effects none
  unchecked "なし（整数の分類だけ）"
{
  if r == -2 {
    return 0;
  }
  if r == -13 || r == -1 {
    return 1;
  }
  return 2;
}

fn open(pp: Addr, pl: Int, flags: Int, mode: Int) -> Int
  intent "path（pp..pp+pl）を NUL 終端にして openat する。fd か負の errno を返す。NUL を含むなら -22（Other）"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は読める（pl == 0 なら pp は読まない）。システムコールは SYS_openat（257）だけを発行する"
{
  let mut i = 0;
  while i < pl {
    if raw.load_u8(raw.offset(pp, i)) == 0 {
      return -22;
    }
    i = i + 1;
  }
  let buf = raw.alloc(pl + 1, 1);
  if pl > 0 {
    raw.copy(buf, pp, pl);
  }
  raw.store_u8(raw.offset(buf, pl), 0);
  let mut fd = -4;
  while fd == -4 {
    fd = raw.syscall(257, -100, raw.addr_to_int(buf), flags, mode, 0, 0);
  }
  raw.free(buf, pl + 1, 1);
  return fd;
}

pub fn read(pp: Addr, pl: Int, kind: Addr) -> Addr
  intent "path のファイルを全部読んで文字列にする。失敗なら空番地を返し、kind に IoError の腕の番号を書く。UTF-8 でなければ Other"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は読める正しい UTF-8、kind は 8 バイト書ける。戻りは std.core.string の頭（呼び出し側が所有）"
{
  let fd = open(pp, pl, 524288, 0);
  if fd < 0 {
    raw.store_i64(kind, classify(fd));
    return raw.addr_null();
  }
  let mut cap = 4096;
  let mut buf = raw.alloc(cap, 1);
  let mut n = 0;
  let mut err = 0;
  let mut go = true;
  while go {
    if n == cap {
      let bigger = raw.alloc(cap * 2, 1);
      raw.copy(bigger, buf, n);
      raw.free(buf, cap, 1);
      buf = bigger;
      cap = cap * 2;
    }
    let r = raw.syscall(0, fd, raw.addr_to_int(raw.offset(buf, n)), cap - n, 0, 0, 0);
    if r > 0 {
      n = n + r;
    } else {
      if r != -4 {
        go = false;
        if r < 0 {
          err = r;
        }
      }
    }
  }
  raw.syscall(3, fd, 0, 0, 0, 0, 0);
  if err < 0 {
    raw.free(buf, cap, 1);
    raw.store_i64(kind, classify(err));
    return raw.addr_null();
  }
  if !valid_utf8(buf, n) {
    raw.free(buf, cap, 1);
    raw.store_i64(kind, 2);
    return raw.addr_null();
  }
  let s = new(buf, n);
  raw.free(buf, cap, 1);
  return s;
}

pub fn write(pp: Addr, pl: Int, dp: Addr, dl: Int, kind: Addr) -> Int
  intent "path のファイルを作る（あれば切り詰める）。data の dl バイトを全部書く。成功は 0、失敗は 1 で kind に IoError の腕の番号を書く"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl と dp..dp+dl は読める（長さ 0 ならその番地は読まない）、kind は 8 バイト書ける"
{
  let fd = open(pp, pl, 524865, 438);
  if fd < 0 {
    raw.store_i64(kind, classify(fd));
    return 1;
  }
  let mut at = raw.addr_to_int(dp);
  let mut left = dl;
  let mut err = 0;
  let mut go = true;
  while go && left > 0 {
    let r = raw.syscall(1, fd, at, left, 0, 0, 0);
    if r > 0 {
      at = at + r;
      left = left - r;
    } else {
      if r != -4 {
        go = false;
        if r < 0 {
          err = r;
        } else {
          err = -5;
        }
      }
    }
  }
  raw.syscall(3, fd, 0, 0, 0, 0, 0);
  if err < 0 {
    raw.store_i64(kind, classify(err));
    return 1;
  }
  return 0;
}

// ADR 0036: バイナリ専用。既存文字列 I/O の振る舞いは変更しない。
// kind は BinaryIoError の腕、kind+8 は IoError の腕（Io の場合のみ）。
fn binary_path(pp: Addr, pl: Int) -> Bool
  intent "確保と OS 操作の前にパスの長さと NUL を検査する"
  requires none
  ensures none
  effects none
  unchecked "pp..pp+pl は生存する UTF-8 の借用。pl>=0。4095 超なら番地を読まず拒否し、ゼロ長でも読まない"
{
  if pl > 4095 {
    return false;
  }
  let mut i = 0;
  while i < pl {
    if raw.load_u8(raw.offset(pp, i)) == 0 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn binary_io(kind: Addr, r: Int)
  intent "OS エラーの分類をバイナリ用出力へ書く"
  requires none
  ensures none
  effects none
  unchecked "kind は独占した16バイトの書込み可能領域、8バイト境界。r は負の errno"
{
  raw.store_i64(kind, 4);
  raw.store_i64(raw.offset(kind, 8), classify(r));
}

fn binary_stat(fd: Int, max: Int, reading: Bool, kind: Addr) -> Bool
  intent "開いた fd の種別と読込み前のサイズを確認する"
  requires none
  ensures none
  effects fs
  unchecked "Linux x86-64 SYS_fstat=5。stat は144バイト・8バイト境界、st_mode は+24の下位32ビット、st_size は+48。fd は呼出し側の単独所有でここでは閉じない。kind は16バイト・8バイト境界。stat は成功時のみ読み同じサイズで全経路解放する"
{
  let stat = raw.alloc(144, 8);
  let mut r = -4;
  while r == -4 {
    r = raw.syscall(5, fd, raw.addr_to_int(stat), 0, 0, 0, 0);
  }
  if r < 0 {
    raw.free(stat, 144, 8);
    binary_io(kind, r);
    return false;
  }
  let mode = raw.load_i64(raw.offset(stat, 24)) & 61440;
  let size = raw.load_i64(raw.offset(stat, 48));
  raw.free(stat, 144, 8);
  if mode != 32768 {
    raw.store_i64(kind, 3);
    return false;
  }
  if reading && size > max {
    raw.store_i64(kind, 2);
    return false;
  }
  return true;
}

fn binary_close(fd: Int, good: Bool, kind: Addr) -> Bool
  intent "fd を一度だけ閉じ、先行失敗がなければ close 失敗を返す"
  requires none
  ensures none
  effects fs
  unchecked "fd は単独所有で未close。Linux x86-64 SYS_close=3 はEINTRでも再試行しない。kind は16バイト・8バイト境界。呼出し後はfdを利用しない"
{
  let r = raw.syscall(3, fd, 0, 0, 0, 0, 0);
  if good && r < 0 {
    binary_io(kind, r);
    return false;
  }
  return good;
}

pub fn read_bytes(pp: Addr, pl: Int, max: Int, kind: Addr) -> Addr
  intent "上限付きで通常ファイルを読み、EOFとclose成功後だけ所有Bytesを返す。失敗は空番地"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は生存するUTF-8借用、pl>=0。kind は独占16バイト・8バイト境界。max→pathの順で検査する。Linux x86-64 openat=257/read=0/fstat=5/close=3。fdは単独所有で一度だけclose。0<=n<=max<=134217728、read要求は残量以下か独立probe1。max=0なら本体確保も番地読出しもしない。全経路で本体を同じmaxで、probeを1で解放。from_rawは実長をコピーし、頭を呼出し側へ一回所有移譲する"
{
  if max < 0 || max > 134217728 {
    raw.store_i64(kind, 0);
    return raw.addr_null();
  }
  if !binary_path(pp, pl) {
    raw.store_i64(kind, 1);
    return raw.addr_null();
  }
  let fd = open(pp, pl, 526336, 0);
  if fd < 0 {
    binary_io(kind, fd);
    return raw.addr_null();
  }
  if !binary_stat(fd, max, true, kind) {
    binary_close(fd, false, kind);
    return raw.addr_null();
  }
  let mut buf = raw.addr_null();
  if max > 0 {
    buf = raw.alloc(max, 1);
  }
  let probe = raw.alloc(1, 1);
  let mut n = 0;
  let mut good = true;
  let mut go = true;
  while go {
    let mut dst = probe;
    let mut count = 1;
    if n < max {
      dst = raw.offset(buf, n);
      count = max - n;
    }
    let r = raw.syscall(0, fd, raw.addr_to_int(dst), count, 0, 0, 0);
    if r > 0 {
      if n == max {
        raw.store_i64(kind, 2);
        good = false;
        go = false;
      } else {
        n = n + r;
      }
    } else {
      if r != -4 {
        go = false;
        if r < 0 {
          binary_io(kind, r);
          good = false;
        }
      }
    }
  }
  good = binary_close(fd, good, kind);
  raw.free(probe, 1, 1);
  let mut owned = raw.addr_null();
  if good {
    owned = from_raw(buf, n);
  }
  if max > 0 {
    raw.free(buf, max, 1);
  }
  return owned;
}

pub fn write_bytes(pp: Addr, pl: Int, dp: Addr, dl: Int, max: Int, kind: Addr) -> Int
  intent "借用Bytesを通常ファイルへ全量書き、close成功でのみ0を返す。失敗1、途中出力は残す"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は生存UTF-8借用、dp..dp+dlは呼出し中生存するBytes共有借用、pl/dl>=0。ゼロ長なら番地を読まず、借用元を変更・保持・解放しない。kindは独占16バイト・8バイト境界。max→path→dlの順でopen前検査。Linux x86-64 openat=257/write=1/fstat=5/close=3、fdは単独所有で一度close。0<=n<=dl<=max<=134217728、部分writeは残量だけ、EINTRは同位置。失敗でもunlinkしない"
{
  if max < 0 || max > 134217728 {
    raw.store_i64(kind, 0);
    return 1;
  }
  if !binary_path(pp, pl) {
    raw.store_i64(kind, 1);
    return 1;
  }
  if dl > max {
    raw.store_i64(kind, 2);
    return 1;
  }
  let fd = open(pp, pl, 526913, 438);
  if fd < 0 {
    binary_io(kind, fd);
    return 1;
  }
  if !binary_stat(fd, max, false, kind) {
    binary_close(fd, false, kind);
    return 1;
  }
  let mut n = 0;
  let mut good = true;
  while good && n < dl {
    let r = raw.syscall(1, fd, raw.addr_to_int(raw.offset(dp, n)), dl - n, 0, 0, 0);
    if r > 0 {
      n = n + r;
    } else {
      if r != -4 {
        good = false;
        if r < 0 {
          binary_io(kind, r);
        } else {
          binary_io(kind, -5);
        }
      }
    }
  }
  good = binary_close(fd, good, kind);
  if good {
    return 0;
  }
  return 1;
}

// =========================================================================
// fs 境界の実装 A「資源・名前・排他」（ADR 0049 決定 1・2・4）
// =========================================================================

fn unit()
  intent "Unit の値を作る"
  requires none
  ensures none
  effects none
{
}

fn classify_io(r: Int, p: &Path) -> IoError
  intent "負の errno（-r）を IoError（NotFound/PermissionDenied/AlreadyExists/DirectoryNotEmpty等）にする"
  requires none
  ensures none
  effects none
{
  if r == -2 {
    return IoError.NotFound(p.clone());
  }
  if r == -13 || r == -1 || r == -40 {
    return IoError.PermissionDenied(p.clone());
  }
  if r == -17 {
    return IoError.AlreadyExists(p.clone());
  }
  if r == -39 {
    return IoError.DirectoryNotEmpty(p.clone());
  }
  if r == -11 {
    return IoError.Busy(p.clone());
  }
  if r == -21 {
    return IoError.IsADirectory(p.clone());
  }
  if r == -20 {
    return IoError.NotADirectory(p.clone());
  }
  if r == -22 {
    return IoError.InvalidInput(p.clone());
  }
  if r == -18 {
    return IoError.NotSameFileSystem(p.clone());
  }
  if r == -27 || r == -28 || r == -75 || r == -122 {
    return IoError.LimitExceeded(p.clone());
  }
  return IoError.Other(p.clone());
}

fn check_component_stat(current_fd: Int, sub_buf: Addr, err: Int) -> Int
  intent "中間構成要素の openat 失敗時、symlink なら -40 (ELOOP: PermissionDenied) に分類する"
  requires none
  ensures none
  effects fs
  unchecked "newfstatat(262) で AT_SYMLINK_NOFOLLOW(256) を指定して st_mode を確認する"
{
  if err == -20 {
    let stat_buf = raw.alloc(144, 8);
    let mut st = -4;
    while st == -4 {
      st = raw.syscall(262, current_fd, raw.addr_to_int(sub_buf), raw.addr_to_int(stat_buf), 256, 0, 0);
    }
    if st >= 0 {
      let mode = raw.load_i64(raw.offset(stat_buf, 24)) & 61440;
      raw.free(stat_buf, 144, 8);
      if mode == 40960 {
        return -40;
      }
    } else {
      raw.free(stat_buf, 144, 8);
    }
  }
  return err;
}

fn validate_path(p: &Path) -> Result<Bytes, IoError>
  intent "パスの長さと NUL を検査する"
  requires none
  ensures none
  effects none
{
  let b = p.as_bytes();
  let len = b.len();
  if len == 0 || len > 4096 {
    return Err(IoError.InvalidPath(p.clone()));
  }
  let mut i = 0;
  while i < len {
    if b.get(i).unwrap_or(0) == 0 {
      return Err(IoError.InvalidPath(p.clone()));
    }
    i = i + 1;
  }
  return Ok(b);
}

fn validate_subpath(p: &Path) -> Result<Bytes, IoError>
  intent "相対パスの安全性（空・NUL・絶対パス・.. 脱出の拒否）を検査する"
  requires none
  ensures none
  effects none
{
  let b = p.as_bytes();
  let len = b.len();
  if len == 0 || len > 4096 {
    return Err(IoError.InvalidPath(p.clone()));
  }
  if b.get(0).unwrap_or(0) == 47 {
    return Err(IoError.InvalidPath(p.clone()));
  }
  let mut bad = false;
  let mut i = 0;
  let mut comp_start = 0;
  while i <= len {
    let mut c = 47;
    if i < len {
      c = b.get(i).unwrap_or(0);
    }
    if c == 0 {
      bad = true;
    }
    if c == 47 {
      let comp_len = i - comp_start;
      if comp_len == 2 {
        let c0 = b.get(comp_start).unwrap_or(0);
        let c1 = b.get(comp_start + 1).unwrap_or(0);
        if c0 == 46 {
          if c1 == 46 {
            bad = true;
          }
        }
      }
      comp_start = i + 1;
    }
    i = i + 1;
  }
  if bad {
    return Err(IoError.InvalidPath(p.clone()));
  }
  return Ok(b);
}

fn c_path_buf(b: &Bytes) -> Addr
  intent "Bytes から NUL 終端の生バッファを割り当ててコピーする"
  requires none
  ensures none
  effects none
  unchecked "b の長さに +1 したバッファを確保し、NUL 終端する"
{
  let len = b.len();
  let buf = raw.alloc(len + 1, 1);
  let mut i = 0;
  while i < len {
    raw.store_u8(raw.offset(buf, i), b.get(i).unwrap_or(0));
    i = i + 1;
  }
  raw.store_u8(raw.offset(buf, len), 0);
  return buf;
}

fn check_io_range(len: Int, offset: Int) -> Bool
  intent "単一 I/O は64MiB以内、offsetと終端は符号付き64ビット以内で加算前に検査する"
  requires none
  ensures none
  effects none
{
  if len < 0 || len > 67108864 || offset < 0 {
    return false;
  }
  return offset <= 9223372036854775807 - len;
}

fn file_io(fd: Int, buf: Addr, len: Int, offset: Int, reading: Bool, positioned: Bool, complete: Bool) -> Int
  intent "EINTRを同位置で再試行し、完全充足時は残量だけ進める。EOF/進捗なしは失敗"
  requires none
  ensures none
  effects fs
  unchecked "bufは呼出し元がlenで確保し完了まで保持する生存領域。len<=64MiB、offset>=0、offset+len<=Int最大は検査済み。0<=done<=len、残量だけIOする。EINTRでdoneを変えず、正の戻り値だけ進める。ゼロ長では番地を読まない。所有権を保持・解放しない"
{
  let mut done = 0;
  while done < len {
    let mut op = 1;
    if reading { op = 0; }
    if positioned { op = op + 17; }
    let mut at = 0;
    if positioned { at = offset + done; }
    let r = raw.syscall(op, fd, raw.addr_to_int(raw.offset(buf, done)), len - done, at, 0, 0);
    if r != -4 {
      if r < 0 { return r; }
      if r > len - done { return -5; }
      if r == 0 {
        if complete { return -5; }
        return done;
      }
      done = done + r;
      if !complete { return done; }
    }
  }
  return done;
}

pub struct File {
  fd: Int,
  file_path: Path,
  append_mode: Bool,
}

impl File {
  pub fn read_at(self: &File, buf: &mut Bytes, offset: Int) -> Result<Int, IoError>
    intent "位置指定読み込み。実際の処理長を返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesは公開get/setでコピー、部分読み込みも保持する。fdはselfの生存借用中のみ使用する"
  {
    let len = buf.len();
    if offset < 0 { return Err(IoError.InvalidInput(self.file_path.clone())); }
    if !check_io_range(len, offset) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(0); }
    let staging = raw.alloc(len, 1);
    let io_status = file_io(self.fd, staging, len, offset, true, true, false);
    let mut i = 0;
    while i < io_status {
      let _ = buf.set(i, raw.load_u8(raw.offset(staging, i)));
      i = i + 1;
    }
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(io_status);
  }

  pub fn read_exact_at(self: &File, buf: &mut Bytes, offset: Int) -> Result<Unit, IoError>
    intent "位置指定読み込み。完全充足しEOF/進捗なしをOtherで返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesは公開get/setでコピー、部分読み込みも保持する。fdはselfの生存借用中のみ使用する"
  {
    let len = buf.len();
    if offset < 0 { return Err(IoError.InvalidInput(self.file_path.clone())); }
    if !check_io_range(len, offset) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(unit()); }
    let staging = raw.alloc(len, 1);
    let mut done = 0;
    let mut io_status = 0;
    let mut running = true;
    while done < len && running {
      let r = file_io(self.fd, staging, len - done, offset + done, true, true, false);
      if r <= 0 {
        io_status = r;
        if r == 0 { io_status = -5; }
        running = false;
      } else {
        let mut i = 0;
        while i < r {
          let _ = buf.set(done + i, raw.load_u8(raw.offset(staging, i)));
          i = i + 1;
        }
        done = done + r;
        io_status = done;
      }
    }
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(unit());
  }

  pub fn write_at(self: &File, buf: &Bytes, offset: Int) -> Result<Int, IoError>
    intent "位置指定書き込み。実際の処理長を返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesの共有借用をgetでコピーし、入力を変更・保持・解放しない。fdはselfの生存借用中のみ使用する"
  {
    if self.append_mode { return Err(IoError.InvalidInput(self.file_path.clone())); }
    let len = buf.len();
    if offset < 0 { return Err(IoError.InvalidInput(self.file_path.clone())); }
    if !check_io_range(len, offset) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(0); }
    let staging = raw.alloc(len, 1);
    let mut i = 0;
    while i < len {
      raw.store_u8(raw.offset(staging, i), buf.get(i).unwrap_or(0));
      i = i + 1;
    }
    let io_status = file_io(self.fd, staging, len, offset, false, true, false);
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(io_status);
  }

  pub fn write_all_at(self: &File, buf: &Bytes, offset: Int) -> Result<Unit, IoError>
    intent "位置指定書き込み。完全充足しEOF/進捗なしをOtherで返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesの共有借用をgetでコピーし、入力を変更・保持・解放しない。fdはselfの生存借用中のみ使用する"
  {
    if self.append_mode { return Err(IoError.InvalidInput(self.file_path.clone())); }
    let len = buf.len();
    if offset < 0 { return Err(IoError.InvalidInput(self.file_path.clone())); }
    if !check_io_range(len, offset) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(unit()); }
    let staging = raw.alloc(len, 1);
    let mut i = 0;
    while i < len {
      raw.store_u8(raw.offset(staging, i), buf.get(i).unwrap_or(0));
      i = i + 1;
    }
    let io_status = file_io(self.fd, staging, len, offset, false, true, true);
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(unit());
  }

  pub fn read(self: &mut File, buf: &mut Bytes) -> Result<Int, IoError>
    intent "ストリーム読み込み。実際の処理長を返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesは公開get/setでコピー、部分読み込みも保持する。fdはselfの生存借用中のみ使用する"
  {
    let len = buf.len();
    if !check_io_range(len, 0) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(0); }
    let staging = raw.alloc(len, 1);
    let io_status = file_io(self.fd, staging, len, 0, true, false, false);
    let mut i = 0;
    while i < io_status {
      let _ = buf.set(i, raw.load_u8(raw.offset(staging, i)));
      i = i + 1;
    }
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(io_status);
  }

  pub fn write(self: &mut File, buf: &Bytes) -> Result<Int, IoError>
    intent "ストリーム書き込み。実際の処理長を返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesの共有借用をgetでコピーし、入力を変更・保持・解放しない。fdはselfの生存借用中のみ使用する"
  {
    let len = buf.len();
    if !check_io_range(len, 0) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(0); }
    let staging = raw.alloc(len, 1);
    let mut i = 0;
    while i < len {
      raw.store_u8(raw.offset(staging, i), buf.get(i).unwrap_or(0));
      i = i + 1;
    }
    let io_status = file_io(self.fd, staging, len, 0, false, false, false);
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(io_status);
  }

  pub fn write_all(self: &mut File, buf: &Bytes) -> Result<Unit, IoError>
    intent "ストリーム書き込み。完全充足しEOF/進捗なしをOtherで返す"
    requires none
    ensures none
    effects fs
    unchecked "長さと終端を確保前に検査。stagingはlenバイトの独占領域、IO完了後に同じlenで解放。Bytesの共有借用をgetでコピーし、入力を変更・保持・解放しない。fdはselfの生存借用中のみ使用する"
  {
    let len = buf.len();
    if !check_io_range(len, 0) { return Err(IoError.LimitExceeded(self.file_path.clone())); }
    if len == 0 { return Ok(unit()); }
    let staging = raw.alloc(len, 1);
    let mut i = 0;
    while i < len {
      raw.store_u8(raw.offset(staging, i), buf.get(i).unwrap_or(0));
      i = i + 1;
    }
    let io_status = file_io(self.fd, staging, len, 0, false, false, true);
    raw.free(staging, len, 1);
    if io_status < 0 { return Err(classify_io(io_status, &self.file_path)); }
    return Ok(unit());
  }


  pub fn try_lock_exclusive(self: &File) -> Result<Bool, IoError>
    intent "非ブロッキング排他ロック（LOCK_EX|LOCK_NB）を取得する。成功は Ok(true)、競合中は Ok(false)"
    requires none
    ensures none
    effects fs
    unchecked "flock(73) を LOCK_EX|LOCK_NB で発行する"
  {
    let mut r = -4;
    while r == -4 {
      r = raw.syscall(73, self.fd, 6, 0, 0, 0, 0);
    }
    if r == 0 {
      return Ok(true);
    }
    if r == -11 {
      return Ok(false);
    }
    return Err(classify_io(r, &self.file_path));
  }

  pub fn try_lock_shared(self: &File) -> Result<Bool, IoError>
    intent "非ブロッキング共有ロック（LOCK_SH|LOCK_NB）を取得する。成功は Ok(true)、競合中は Ok(false)"
    requires none
    ensures none
    effects fs
    unchecked "flock(73) を LOCK_SH|LOCK_NB で発行する"
  {
    let mut r = -4;
    while r == -4 {
      r = raw.syscall(73, self.fd, 5, 0, 0, 0, 0);
    }
    if r == 0 {
      return Ok(true);
    }
    if r == -11 {
      return Ok(false);
    }
    return Err(classify_io(r, &self.file_path));
  }

  pub fn unlock(self: &File) -> Result<Unit, IoError>
    intent "ロックを明示的に解除する（LOCK_UN）"
    requires none
    ensures none
    effects fs
    unchecked "flock(73) を LOCK_UN で発行する"
  {
    let mut r = -4;
    while r == -4 {
      r = raw.syscall(73, self.fd, 8, 0, 0, 0, 0);
    }
    if r < 0 {
      return Err(classify_io(r, &self.file_path));
    }
    return Ok(unit());
  }

  pub fn close(self: File) -> Result<Unit, IoError>
    intent "ファイルを明示的に閉じる。破棄フックでの二重 close を防止する"
    requires none
    ensures none
    effects fs
    unchecked "close(3) を発行する"
  {
    if self.fd < 0 {
      return Ok(unit());
    }
    let r = raw.syscall(3, self.fd, 0, 0, 0, 0, 0);
    let mut f = self;
    f.fd = -1;
    if r < 0 {
      return Err(classify_io(r, &f.file_path));
    }
    return Ok(unit());
  }
}

