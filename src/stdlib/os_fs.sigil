module std.os.fs
  targets server
  trust base

// `fs.read`・`fs.write` の Sigil 実装（ADR 0025 補足 C-7 の 3-6b、補足 K）。ネイティブの実体。
// 評価器の `fs.read`/`fs.write` は Rust の組み込みのまま（補足 C-7）で、ここは呼ばない。ネイティブはシムから呼ぶ。
//
// - `read`: openat(AT_FDCWD, path, O_RDONLY|O_CLOEXEC) → read を 0（終わり）が返るまで繰り返す（-4 EINTR は再試行）→ close。
//   読んだバイト列は `std.core.string.valid_utf8` で検証し、不正なら Other（`new` は検証しないので、必ず検証してから呼ぶ）。
// - `write`: openat(…, O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC, 0o666) → write を全部書き終えるまで繰り返す
//   （部分書き込みは残りから、-4 は同じ位置から再試行、0 は Other）→ close（失敗は無視する）。
// - openat の -4 も再試行する。パスに NUL を含む場合は Rust の `std::fs` と同じく Other（システムコールを発行しない）。
// - errno の分類: ENOENT(2)→NotFound(0)、EACCES(13)・EPERM(1)→PermissionDenied(1)、それ以外→Other(2)（`src/shared/path.rs` の `io_arm`）。
// 失敗の種類は `kind` の番地（8 バイト）に書く。`std.os.console` と同じく入口の `targets` との照合は免除する（補足 J・K）。
// 排他を持たない単一スレッド前提（補足 A-5）。利用者のモジュールからは `use std.*` できない（ADR 0016 決定 3）。

use std.core.bytes.from_raw;
use std.core.string.new;
use std.core.string.valid_utf8;

fn classify(r: Int) -> Int
  intent "負の errno（-r）を IoError の腕の番号（0 NotFound, 1 PermissionDenied, 2 Other）にする"
  requires none
  ensures none
  effects none
  unchecked "なし（整数の分類だけ）"
{
  if r == -2 {
    return 0;
  }
  if r == -13 || r == -1 {
    return 1;
  }
  return 2;
}

fn open(pp: Addr, pl: Int, flags: Int, mode: Int) -> Int
  intent "path（pp..pp+pl）を NUL 終端にして openat する。fd か負の errno を返す。NUL を含むなら -22（Other）"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は読める（pl == 0 なら pp は読まない）。システムコールは SYS_openat（257）だけを発行する"
{
  let mut i = 0;
  while i < pl {
    if raw.load_u8(raw.offset(pp, i)) == 0 {
      return -22;
    }
    i = i + 1;
  }
  let buf = raw.alloc(pl + 1, 1);
  if pl > 0 {
    raw.copy(buf, pp, pl);
  }
  raw.store_u8(raw.offset(buf, pl), 0);
  let mut fd = -4;
  while fd == -4 {
    fd = raw.syscall(257, -100, raw.addr_to_int(buf), flags, mode, 0, 0);
  }
  raw.free(buf, pl + 1, 1);
  return fd;
}

pub fn read(pp: Addr, pl: Int, kind: Addr) -> Addr
  intent "path のファイルを全部読んで文字列にする。失敗なら空番地を返し、kind に IoError の腕の番号を書く。UTF-8 でなければ Other"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は読める正しい UTF-8、kind は 8 バイト書ける。戻りは std.core.string の頭（呼び出し側が所有）"
{
  let fd = open(pp, pl, 524288, 0);
  if fd < 0 {
    raw.store_i64(kind, classify(fd));
    return raw.addr_null();
  }
  let mut cap = 4096;
  let mut buf = raw.alloc(cap, 1);
  let mut n = 0;
  let mut err = 0;
  let mut go = true;
  while go {
    if n == cap {
      let bigger = raw.alloc(cap * 2, 1);
      raw.copy(bigger, buf, n);
      raw.free(buf, cap, 1);
      buf = bigger;
      cap = cap * 2;
    }
    let r = raw.syscall(0, fd, raw.addr_to_int(raw.offset(buf, n)), cap - n, 0, 0, 0);
    if r > 0 {
      n = n + r;
    } else {
      if r != -4 {
        go = false;
        if r < 0 {
          err = r;
        }
      }
    }
  }
  raw.syscall(3, fd, 0, 0, 0, 0, 0);
  if err < 0 {
    raw.free(buf, cap, 1);
    raw.store_i64(kind, classify(err));
    return raw.addr_null();
  }
  if !valid_utf8(buf, n) {
    raw.free(buf, cap, 1);
    raw.store_i64(kind, 2);
    return raw.addr_null();
  }
  let s = new(buf, n);
  raw.free(buf, cap, 1);
  return s;
}

pub fn write(pp: Addr, pl: Int, dp: Addr, dl: Int, kind: Addr) -> Int
  intent "path のファイルを作る（あれば切り詰める）。data の dl バイトを全部書く。成功は 0、失敗は 1 で kind に IoError の腕の番号を書く"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl と dp..dp+dl は読める（長さ 0 ならその番地は読まない）、kind は 8 バイト書ける"
{
  let fd = open(pp, pl, 524865, 438);
  if fd < 0 {
    raw.store_i64(kind, classify(fd));
    return 1;
  }
  let mut at = raw.addr_to_int(dp);
  let mut left = dl;
  let mut err = 0;
  let mut go = true;
  while go && left > 0 {
    let r = raw.syscall(1, fd, at, left, 0, 0, 0);
    if r > 0 {
      at = at + r;
      left = left - r;
    } else {
      if r != -4 {
        go = false;
        if r < 0 {
          err = r;
        } else {
          err = -5;
        }
      }
    }
  }
  raw.syscall(3, fd, 0, 0, 0, 0, 0);
  if err < 0 {
    raw.store_i64(kind, classify(err));
    return 1;
  }
  return 0;
}

// ADR 0036: バイナリ専用。既存文字列 I/O の振る舞いは変更しない。
// kind は BinaryIoError の腕、kind+8 は IoError の腕（Io の場合のみ）。
fn binary_path(pp: Addr, pl: Int) -> Bool
  intent "確保と OS 操作の前にパスの長さと NUL を検査する"
  requires none
  ensures none
  effects none
  unchecked "pp..pp+pl は生存する UTF-8 の借用。pl>=0。4095 超なら番地を読まず拒否し、ゼロ長でも読まない"
{
  if pl > 4095 {
    return false;
  }
  let mut i = 0;
  while i < pl {
    if raw.load_u8(raw.offset(pp, i)) == 0 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

fn binary_io(kind: Addr, r: Int)
  intent "OS エラーの分類をバイナリ用出力へ書く"
  requires none
  ensures none
  effects none
  unchecked "kind は独占した16バイトの書込み可能領域、8バイト境界。r は負の errno"
{
  raw.store_i64(kind, 4);
  raw.store_i64(raw.offset(kind, 8), classify(r));
}

fn binary_stat(fd: Int, max: Int, reading: Bool, kind: Addr) -> Bool
  intent "開いた fd の種別と読込み前のサイズを確認する"
  requires none
  ensures none
  effects fs
  unchecked "Linux x86-64 SYS_fstat=5。stat は144バイト・8バイト境界、st_mode は+24の下位32ビット、st_size は+48。fd は呼出し側の単独所有でここでは閉じない。kind は16バイト・8バイト境界。stat は成功時のみ読み同じサイズで全経路解放する"
{
  let stat = raw.alloc(144, 8);
  let mut r = -4;
  while r == -4 {
    r = raw.syscall(5, fd, raw.addr_to_int(stat), 0, 0, 0, 0);
  }
  if r < 0 {
    raw.free(stat, 144, 8);
    binary_io(kind, r);
    return false;
  }
  let mode = raw.load_i64(raw.offset(stat, 24)) & 61440;
  let size = raw.load_i64(raw.offset(stat, 48));
  raw.free(stat, 144, 8);
  if mode != 32768 {
    raw.store_i64(kind, 3);
    return false;
  }
  if reading && size > max {
    raw.store_i64(kind, 2);
    return false;
  }
  return true;
}

fn binary_close(fd: Int, good: Bool, kind: Addr) -> Bool
  intent "fd を一度だけ閉じ、先行失敗がなければ close 失敗を返す"
  requires none
  ensures none
  effects fs
  unchecked "fd は単独所有で未close。Linux x86-64 SYS_close=3 はEINTRでも再試行しない。kind は16バイト・8バイト境界。呼出し後はfdを利用しない"
{
  let r = raw.syscall(3, fd, 0, 0, 0, 0, 0);
  if good && r < 0 {
    binary_io(kind, r);
    return false;
  }
  return good;
}

pub fn read_bytes(pp: Addr, pl: Int, max: Int, kind: Addr) -> Addr
  intent "上限付きで通常ファイルを読み、EOFとclose成功後だけ所有Bytesを返す。失敗は空番地"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は生存するUTF-8借用、pl>=0。kind は独占16バイト・8バイト境界。max→pathの順で検査する。Linux x86-64 openat=257/read=0/fstat=5/close=3。fdは単独所有で一度だけclose。0<=n<=max<=134217728、read要求は残量以下か独立probe1。max=0なら本体確保も番地読出しもしない。全経路で本体を同じmaxで、probeを1で解放。from_rawは実長をコピーし、頭を呼出し側へ一回所有移譲する"
{
  if max < 0 || max > 134217728 {
    raw.store_i64(kind, 0);
    return raw.addr_null();
  }
  if !binary_path(pp, pl) {
    raw.store_i64(kind, 1);
    return raw.addr_null();
  }
  let fd = open(pp, pl, 526336, 0);
  if fd < 0 {
    binary_io(kind, fd);
    return raw.addr_null();
  }
  if !binary_stat(fd, max, true, kind) {
    binary_close(fd, false, kind);
    return raw.addr_null();
  }
  let mut buf = raw.addr_null();
  if max > 0 {
    buf = raw.alloc(max, 1);
  }
  let probe = raw.alloc(1, 1);
  let mut n = 0;
  let mut good = true;
  let mut go = true;
  while go {
    let mut dst = probe;
    let mut count = 1;
    if n < max {
      dst = raw.offset(buf, n);
      count = max - n;
    }
    let r = raw.syscall(0, fd, raw.addr_to_int(dst), count, 0, 0, 0);
    if r > 0 {
      if n == max {
        raw.store_i64(kind, 2);
        good = false;
        go = false;
      } else {
        n = n + r;
      }
    } else {
      if r != -4 {
        go = false;
        if r < 0 {
          binary_io(kind, r);
          good = false;
        }
      }
    }
  }
  good = binary_close(fd, good, kind);
  raw.free(probe, 1, 1);
  let mut owned = raw.addr_null();
  if good {
    owned = from_raw(buf, n);
  }
  if max > 0 {
    raw.free(buf, max, 1);
  }
  return owned;
}

pub fn write_bytes(pp: Addr, pl: Int, dp: Addr, dl: Int, max: Int, kind: Addr) -> Int
  intent "借用Bytesを通常ファイルへ全量書き、close成功でのみ0を返す。失敗1、途中出力は残す"
  requires none
  ensures none
  effects fs
  unchecked "pp..pp+pl は生存UTF-8借用、dp..dp+dlは呼出し中生存するBytes共有借用、pl/dl>=0。ゼロ長なら番地を読まず、借用元を変更・保持・解放しない。kindは独占16バイト・8バイト境界。max→path→dlの順でopen前検査。Linux x86-64 openat=257/write=1/fstat=5/close=3、fdは単独所有で一度close。0<=n<=dl<=max<=134217728、部分writeは残量だけ、EINTRは同位置。失敗でもunlinkしない"
{
  if max < 0 || max > 134217728 {
    raw.store_i64(kind, 0);
    return 1;
  }
  if !binary_path(pp, pl) {
    raw.store_i64(kind, 1);
    return 1;
  }
  if dl > max {
    raw.store_i64(kind, 2);
    return 1;
  }
  let fd = open(pp, pl, 526913, 438);
  if fd < 0 {
    binary_io(kind, fd);
    return 1;
  }
  if !binary_stat(fd, max, false, kind) {
    binary_close(fd, false, kind);
    return 1;
  }
  let mut n = 0;
  let mut good = true;
  while good && n < dl {
    let r = raw.syscall(1, fd, raw.addr_to_int(raw.offset(dp, n)), dl - n, 0, 0, 0);
    if r > 0 {
      n = n + r;
    } else {
      if r != -4 {
        good = false;
        if r < 0 {
          binary_io(kind, r);
        } else {
          binary_io(kind, -5);
        }
      }
    }
  }
  good = binary_close(fd, good, kind);
  if good {
    return 0;
  }
  return 1;
}
