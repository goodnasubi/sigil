module test.bearer509
  targets server
  trust none

fn private_handler(req: &AppRequest) -> HttpResponse
  intent "検証済み主体のみを返す"
  requires none
  ensures none
  effects none
{
  match req.identity() {
    Some(identity) => { return HttpResponse.new(200, identity.subject().as_bytes()); }
    None => { return HttpResponse.new(500, "missing identity".as_bytes()); }
  }
}
fn public_handler(req: &AppRequest) -> HttpResponse
  intent "公開経路に主体を付けない"
  requires none
  ensures none
  effects none
{
  match req.identity() {
    Some(_) => { return HttpResponse.new(500, "unexpected identity".as_bytes()); }
    None => { return HttpResponse.new(200, "public".as_bytes()); }
  }
}
fn before(req: &AppRequest) -> Option<HttpResponse>
  intent "成功後だけ前処理を実行する"
  requires none
  ensures none
  effects console
{ console.log(&"before"); return None; }
fn after(req: &AppRequest, response: HttpResponse) -> HttpResponse
  intent "最終出力にも秘密や理由を加えない"
  requires none
  ensures none
  effects console
{ console.log(&"after"); return response.with_header(&"x-after", &"safe".as_bytes()); }
fn configured() -> Result<Router, ConfigError>
  intent "すべての起動確認を待受より前に行う"
  requires none
  ensures none
  effects env, clock
{
  let config = web.load_bearer_config()?;
  let verifier = config.into_verifier()?;
  let mut router = Router.new().with_auth(verifier);
  router = router.route("GET", "/private", RouteHandler { handle: private_handler }).unwrap_or(Router.new());
  router = router.public_route("GET", "/public", RouteHandler { handle: public_handler }).unwrap_or(Router.new());
  router = router.before(BeforeHook { run: before }).after(AfterHook { run: after });
  return Ok(router);
}
fn describe(response: HttpResponse) -> String
  intent "試験用の最終応答を全見出しと本文で比較する"
  requires none
  ensures none
  effects none
{
  let mut text = response.body();
  let headers = response.headers();
  let mut i = 0;
  while i < headers.len() {
    match headers.get(i) {
      Some(h) => { text = text.concat(&"|".as_bytes()).concat(&h.name().as_bytes()).concat(&":".as_bytes()).concat(&h.value()); }
      None => {}
    }
    i = i + 1;
  }
  return text.to_string_utf8().unwrap_or("invalid utf8");
}
fn dispatch(wire: String) -> String
  intent "設定を所有する既存ルーターを直接 dispatch する"
  requires none
  ensures none
  effects env, clock, console, db, random, task
{
  match configured() {
    Err(e) => { return e.name(); }
    Ok(router) => {
      let mut parser = http.parser(&http.default_limits());
      match parser.feed(&wire.as_bytes(), 0) {
        Ok(progress) => {
          match progress {
            HttpProgress.Done(req, _) => { return describe(router.dispatch(&req)); }
            HttpProgress.NeedMore => { return "incomplete"; }
          }
        }
        Err(_) => { return "parse error"; }
      }
    }
  }
}
fn serve() -> Int
  intent "起動設定失敗なら待受せず一接続だけ処理する試験サーバー"
  requires none
  ensures none
  effects env, clock, console, db, random, task, net.server
{
  match configured() {
    Err(e) => { console.log(&e.name()); return 1; }
    Ok(router) => {
      let shared = SyncShared.new(router);
      match net.listen(&"127.0.0.1", 0, 4) {
        Err(_) => { return 2; }
        Ok(listener) => {
          console.log(&listener.local_port());
          match listener.accept() {
            Err(_) => { return 3; }
            Ok(stream) => {
              let conn = http.conn(stream);
              http.serve_conn(&conn, &http.default_limits(), move |req| { let router_ref = shared.borrow(); return router_ref.dispatch(&req); });
            }
          }
        }
      }
    }
  }
  return 0;
}
