  effects none
{

  return p256_fe_pack(40747962, 24314746, 64528516, 6596633, 22376891, 50009688, 52662966, 8325398, 22665558, 3689317);
}

fn p256_const_one_n() -> Secret
  intent "モンゴメリ表現の 1（n 上）"
  requires none
  ensures none
  effects none
{

  return p256_fe_pack(30255856, 13956110, 24841286, 9845272, 3248213, 1, 0, 67092480, 1048575, 0);
