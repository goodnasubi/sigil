module std.web
  targets server
  trust none

// ADR 0033 E・I・J / Issue #460。設定・定型応答・ルーター。停止処理は task.roots_grace と task.race を組み合わせる。
// 前段ヘッダーを解釈する API や信頼フラグは持たない。HttpRequest.header の値は未検証の生値。
// 不正な設定は Result の Err で起動側に返し、失敗時には待ち受けを開始しない。
// ConfigError は変数名だけを保持し、設定値（秘密を含む）を保持・表示しない。
// HOST は net.listen と同じ IPv4 ドット表記。形式の最終検証は待ち受け側で行う。

pub struct AppConfig {
  config_host: String,
  config_port: Int,
  config_http: HttpLimits,
  config_app: AppLimits,
}

pub struct AppLimits {
  lim_query: Int,
  lim_json: Int,
  lim_shutdown: Int,
}

pub struct ConfigError {
  config_name: String,
  config_kind: String,
}

fn read_limit(name: &String, fallback: Int, cap: Int) -> Result<Int, ConfigError>
  intent "未設定なら既定値、整数変換と範囲検証に失敗すれば変数名だけを返す"
  requires none
  ensures none
  effects env
{
  match env.get(&name) {
    None => {
      return Ok(fallback);
    }
    Some(text) => {
      match text.parse_int() {
        Ok(v) => {
          if 1 <= v && v <= cap {
            return Ok(v);
          }
        }
        Err(_) => {}
      }
    }
  }
  return Err(ConfigError { config_name: name.clone(), config_kind: "invalid" });
}

pub fn load_config() -> Result<AppConfig, ConfigError>
  intent "環境変数を読み、無制限値を含む不正な設定を起動前に拒否する"
  requires none
  ensures none
  effects env
{
  let mut limits = http.default_limits();
  let request_line = read_limit(&"SIGIL_HTTP_REQUEST_LINE_BYTES", limits.request_line(), 65536)?;
  limits = limits.with_request_line(request_line);
  let head = read_limit(&"SIGIL_HTTP_HEAD_BYTES", limits.head(), 262144)?;
  limits = limits.with_head(head);
  let headers = read_limit(&"SIGIL_HTTP_HEADERS_MAX", limits.headers(), 1000)?;
  limits = limits.with_headers(headers);
  let body = read_limit(&"SIGIL_HTTP_BODY_BYTES", limits.body(), 67108864)?;
  limits = limits.with_body(body);
  let chunk_line = read_limit(&"SIGIL_HTTP_CHUNK_LINE_BYTES", limits.chunk_line(), 1024)?;
  limits = limits.with_chunk_line(chunk_line);
  let encoded_body = read_limit(&"SIGIL_HTTP_ENCODED_BODY_BYTES", limits.encoded_body(), 134217728)?;
  limits = limits.with_encoded_body(encoded_body);
  let conns = read_limit(&"SIGIL_HTTP_CONNS_MAX", limits.conns(), 4096)?;
  limits = limits.with_conns(conns);
  let backlog = read_limit(&"SIGIL_HTTP_BACKLOG", limits.backlog(), 1024)?;
  limits = limits.with_backlog(backlog);
  let head_ms = read_limit(&"SIGIL_HTTP_HEAD_MS", limits.head_ms(), 600000)?;
  limits = limits.with_head_ms(head_ms);
  let body_ms = read_limit(&"SIGIL_HTTP_BODY_MS", limits.body_ms(), 600000)?;
  limits = limits.with_body_ms(body_ms);
  let handler_ms = read_limit(&"SIGIL_HTTP_HANDLER_MS", limits.handler_ms(), 600000)?;
  limits = limits.with_handler_ms(handler_ms);
  let send_ms = read_limit(&"SIGIL_HTTP_SEND_MS", limits.send_ms(), 600000)?;
  limits = limits.with_send_ms(send_ms);
  let idle_ms = read_limit(&"SIGIL_HTTP_IDLE_MS", limits.idle_ms(), 600000)?;
  limits = limits.with_idle_ms(idle_ms);
  let requests = read_limit(&"SIGIL_HTTP_REQUESTS_PER_CONN", limits.requests(), 100000)?;
  limits = limits.with_requests(requests);
  let response_body = read_limit(&"SIGIL_HTTP_RESPONSE_BODY_BYTES", limits.response_body(), 67108864)?;
  limits = limits.with_response_body(response_body);
  let query = read_limit(&"SIGIL_APP_QUERY_PARAMS_MAX", 100, 1000)?;
  let depth = read_limit(&"SIGIL_APP_JSON_MAX_DEPTH", 64, 128)?;
  let grace = read_limit(&"SIGIL_APP_SHUTDOWN_GRACE_MS", 10000, 300000)?;
  let port = read_limit(&"SIGIL_APP_PORT", 8080, 65535)?;
  let host = env.get(&"SIGIL_APP_HOST").unwrap_or("127.0.0.1");
  return Ok(AppConfig { config_host: host, config_port: port, config_http: limits, config_app: AppLimits { lim_query: query, lim_json: depth, lim_shutdown: grace } });
}

fn decimal(value: Int) -> String
  intent "非負整数を十進の文字列にする"
  requires value >= 0
  ensures none
  effects none
{
  let mut reverse = Bytes.new();
  let mut n = value;
  reverse.push(48 + n % 10);
  n = n / 10;
  while n > 0 {
    reverse.push(48 + n % 10);
    n = n / 10;
  }
  let mut digits = Bytes.new();
  let mut i = reverse.byte_len();
  while i > 0 {
    i = i - 1;
    digits.push(reverse.get(i).unwrap_or(48));
  }
  return digits.to_string_utf8().unwrap_or("");
}

impl AppConfig {
  pub fn host(self: &AppConfig) -> String
    intent "待ち受け先 IPv4 の文字列を写す"
    requires none
    ensures none
    effects none
  {
    return self.config_host.clone();
  }

  pub fn port(self: &AppConfig) -> Int
    intent "環境変数のポートは 1 から 65535、未設定は 8080"
    requires none
    ensures none
    effects none
  {
    return self.config_port;
  }

  pub fn http_limits(self: &AppConfig) -> HttpLimits
    intent "検証済みの HTTP 上限を写す"
    requires none
    ensures none
    effects none
  {
    let mut limits = http.default_limits();
    limits = limits.with_request_line(self.config_http.request_line());
    limits = limits.with_head(self.config_http.head());
    limits = limits.with_headers(self.config_http.headers());
    limits = limits.with_body(self.config_http.body());
    limits = limits.with_chunk_line(self.config_http.chunk_line());
    limits = limits.with_encoded_body(self.config_http.encoded_body());
    limits = limits.with_conns(self.config_http.conns());
    limits = limits.with_backlog(self.config_http.backlog());
    limits = limits.with_head_ms(self.config_http.head_ms());
    limits = limits.with_body_ms(self.config_http.body_ms());
    limits = limits.with_handler_ms(self.config_http.handler_ms());
    limits = limits.with_send_ms(self.config_http.send_ms());
    limits = limits.with_idle_ms(self.config_http.idle_ms());
    limits = limits.with_requests(self.config_http.requests());
    limits = limits.with_response_body(self.config_http.response_body());
    return limits;
  }

  pub fn app_limits(self: &AppConfig) -> AppLimits
    intent "検証済みのアプリ上限を写す"
    requires none
    ensures none
    effects none
  {
    return AppLimits { lim_query: self.config_app.lim_query, lim_json: self.config_app.lim_json, lim_shutdown: self.config_app.lim_shutdown };
  }

  pub fn log_memory_bound(self: &AppConfig)
    intent "起動時に最悪の HTTP メモリ見積もりを定型の一行で出す"
    requires none
    ensures none
    effects console
  {
    let value = decimal(self.config_http.memory_bound());
    let line = "sigil.web memory_bound_bytes=".as_bytes().concat(&value.as_bytes());
    console.log(&line.to_string_utf8().unwrap_or(""));
  }
}

impl AppLimits {
  pub fn query_params_max(self: &AppLimits) -> Int
    intent "検証済みのアプリ上限を返す"
    requires none
    ensures none
    effects none
  {
    return self.lim_query;
  }

  pub fn json_max_depth(self: &AppLimits) -> Int
    intent "検証済みのアプリ上限を返す"
    requires none
    ensures none
    effects none
  {
    return self.lim_json;
  }

  pub fn shutdown_grace_ms(self: &AppLimits) -> Int
    intent "検証済みのアプリ上限を返す"
    requires none
    ensures none
    effects none
  {
    return self.lim_shutdown;
  }
}

impl ConfigError {
  pub fn kind(self: &ConfigError) -> String
    intent "設定値を含まない固定分類を返す"
    requires none
    ensures none
    effects none
  {
    return self.config_kind.clone();
  }

  pub fn name(self: &ConfigError) -> String
    intent "不正な設定の変数名だけを返す"
    requires none
    ensures none
    effects none
  {
    return self.config_name.clone();
  }
}

pub fn error_response(status: Int) -> HttpResponse
  intent "フレームワークのエラー本文は固定文のみ。未対応コードは安全な 500 にする"
  requires none
  ensures none
  effects none
{
  let code = match status {
    400 => 400,
    401 => 401,
    403 => 403,
    404 => 404,
    405 => 405,
    408 => 408,
    413 => 413,
    414 => 414,
    417 => 417,
    429 => 429,
    431 => 431,
    500 => 500,
    501 => 501,
    503 => 503,
    505 => 505,
    _ => 500,
  };
  let text = match code {
    400 => "bad request",
    401 => "unauthorized",
    403 => "forbidden",
    404 => "not found",
    405 => "method not allowed",
    408 => "request timeout",
    413 => "content too large",
    414 => "uri too long",
    417 => "expectation failed",
    429 => "too many requests",
    431 => "request header fields too large",
    500 => "internal server error",
    501 => "not implemented",
    503 => "service unavailable",
    505 => "http version not supported",
    _ => "internal server error",
  };
  return HttpResponse.new(code, text.as_bytes()).with_header(&"content-type", &"text/plain; charset=utf-8".as_bytes());
}

// ADR 0033 C1。関数引数の格納や高階ミドルウェアを導入せず、利用者が型付きの箱を構築する。
// 許される効果の上限はサーバー処理だけ。ファイル・ネットワーク・プロセスの権限を渡さない。

pub struct RouteHandler {
  handle: fn(&AppRequest) -> HttpResponse effects clock, console, db, env, random, task,
}

pub struct BeforeHook {
  run: fn(&AppRequest) -> Option<HttpResponse> effects clock, console, db, env, random, task,
}

pub struct AfterHook {
  run: fn(&AppRequest, HttpResponse) -> HttpResponse effects clock, console, db, env, random, task,
}

pub struct AuthVerifier {
  verify: fn(&AppRequest) -> Result<AuthIdentity, HttpResponse> effects clock, console, db, env, random, task,
}

pub enum AuthPolicy {
  Required,
  Public,
}

pub struct AuthIdentity {
  identity_subject: String,
}

pub struct WebParam {
  param_name: String,
  param_value: String,
}

pub struct WebRoute {
  route_method: String,
  route_path: String,
  route_handler: RouteHandler,
  route_auth: AuthPolicy,
}

pub struct AppRequest {
  app_method: String,
  app_path: String,
  app_query: List<WebParam>,
  app_params: List<WebParam>,
  app_headers: List<HttpHeader>,
  app_body: Bytes,
  app_identity: Option<AuthIdentity>,
}

pub struct Router {
  router_routes: List<WebRoute>,
  router_before: List<BeforeHook>,
  router_after: List<AfterHook>,
  router_verifier: Option<AuthVerifier>,
  router_query_max: Int,
}

pub fn validate<T>(value: Option<T>) -> Result<T, HttpResponse>
  intent "篩型 T.check の Option を固定の 400 応答へ写す"
  requires none
  ensures none
  effects none
{
  return value.ok_or(error_response(400));
}

fn hex_digit(b: Int) -> Int
  intent "入力を検査して安全な結果を返す"
  requires none
  ensures none
  effects none
{
  if b >= 48 && b <= 57 {
    return b - 48;
  }
  if b >= 65 && b <= 70 {
    return b - 55;
  }
  if b >= 97 && b <= 102 {
    return b - 87;
  }
  return -1;
}

fn decode(data: &Bytes, plus_space: Bool) -> Result<String, HttpResponse>
  intent "百分率符号化を一度だけ解き、不正な符号化・UTF-8・NULを拒否する"
  requires none
  ensures none
  effects none
{
  let mut out = Bytes.new();
  let mut i = 0;
  while i < data.byte_len() {
    let mut b = data.get(i).unwrap_or(0);
    if b == 37 {
      if i + 2 >= data.byte_len() {
        return Err(error_response(400));
      }
      let hi = hex_digit(data.get(i + 1).unwrap_or(0));
      let lo = hex_digit(data.get(i + 2).unwrap_or(0));
      if hi < 0 || lo < 0 {
        return Err(error_response(400));
      }
      b = hi * 16 + lo;
      i = i + 2;
    } else {
      if plus_space && b == 43 {
        b = 32;
      }
    }
    if b == 0 {
      return Err(error_response(400));
    }
    out.push(b);
    i = i + 1;
  }
  return out.to_string_utf8().map_err(|e| error_response(400));
}

fn path_segments(path: &String) -> Result<List<String>, HttpResponse>
  intent "ルート以外の空セグメント・末尾スラッシュ・ドット・逆スラッシュを拒否する"
  requires none
  ensures none
  effects none
{
  let data = path.as_bytes();
  if data.byte_len() == 0 || data.get(0).unwrap_or(0) != 47 {
    return Err(error_response(400));
  }
  let mut items = List.new();
  if data.byte_len() == 1 {
    return Ok(items);
  }
  let mut start = 1;
  let mut i = 1;
  while i <= data.byte_len() {
    let b = data.get(i).unwrap_or(47);
    if b == 47 {
      let segment = data.slice(start, i).unwrap_or(Bytes.new()).to_string_utf8().map_err(|e| error_response(400))?;
      if segment == "" || segment == "." || segment == ".." {
        return Err(error_response(400));
      }
      items.push(segment);
      start = i + 1;
    } else {
      if b <= 32 || b == 92 || b == 127 || b == 63 || b == 35 {
        return Err(error_response(400));
      }
    }
    i = i + 1;
  }
  return Ok(items);
}

fn decode_path(data: &Bytes) -> Result<String, HttpResponse>
  intent "入力を検査して安全な結果を返す"
  requires none
  ensures none
  effects none
{
  // 符号化された区切りは経路の別名を生まないよう拒否する。
  let mut i = 0;
  while i + 2 < data.byte_len() {
    if data.get(i).unwrap_or(0) == 37 {
      let b = hex_digit(data.get(i + 1).unwrap_or(0)) * 16 + hex_digit(data.get(i + 2).unwrap_or(0));
      if b == 47 || b == 92 {
        return Err(error_response(400));
      }
      i = i + 2;
    }
    i = i + 1;
  }
  let path = decode(&data, false)?;
  let segments = path_segments(&path)?;
  return Ok(path);
}

fn parse_query(data: &Bytes, cap: Int) -> Result<List<WebParam>, HttpResponse>
  intent "空欄・重複を含め全ての問い合わせ欄を数え上限を適用する"
  requires none
  ensures none
  effects none
{
  let mut items = List.new();
  if data.byte_len() == 0 {
    return Ok(items);
  }
  let mut start = 0;
  let mut i = 0;
  let mut count = 0;
  while i <= data.byte_len() {
    let current = data.get(i).unwrap_or(0);
    if i == data.byte_len() || current == 38 {
      count = count + 1;
      if count > cap {
        return Err(error_response(400));
      }
      let mut split = start;
      let mut delimiter = data.get(split).unwrap_or(0);
      while split < i && delimiter != 61 {
        split = split + 1;
        delimiter = data.get(split).unwrap_or(0);
      }
      let name_bytes = data.slice(start, split).unwrap_or(Bytes.new());
      let name = decode(&name_bytes, true)?;
      let mut value_start = split;
      if split < i {
        value_start = split + 1;
      }
      let value_bytes = data.slice(value_start, i).unwrap_or(Bytes.new());
      let value = decode(&value_bytes, true)?;
      items.push(WebParam { param_name: name, param_value: value });
      start = i + 1;
    }
    i = i + 1;
  }
  return Ok(items);
}

fn find_param(params: &List<WebParam>, name: &String) -> Result<String, HttpResponse>
  intent "欠落と重複を400にしてパラメータ汚染による解釈の不一致を防ぐ"
  requires none
  ensures none
  effects none
{
  let mut found = None;
  let mut i = 0;
  while i < params.len() {
    match params.get(i) {
      Some(p) => {
        if p.param_name == name {
          match found {
            Some(_) => {
              return Err(error_response(400));
            }
            None => {}
          }
          found = Some(p.param_value.clone());
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return found.ok_or(error_response(400));
}

fn match_route(pattern: &String, path: &List<String>) -> Option<List<WebParam>>
  intent "同じセグメント数の完全一致または :name の一セグメント変数で照合する"
  requires none
  ensures none
  effects none
{
  let mut expected = List.new();
  match path_segments(&pattern) {
    Ok(v) => {
      expected = v;
    }
    Err(_) => {
      return None;
    }
  }
  if expected.len() != path.len() {
    return None;
  }
  let mut params = List.new();
  let mut i = 0;
  while i < expected.len() {
    let a = expected.get(i)?;
    let b = path.get(i)?;
    let bytes = a.as_bytes();
    if bytes.get(0).unwrap_or(0) == 58 {
      let name = bytes.slice(1, bytes.byte_len()).unwrap_or(Bytes.new()).to_string_utf8().unwrap_or("");
      params.push(WebParam { param_name: name, param_value: b.clone() });
    } else {
      if a != b {
        return None;
      }
    }
    i = i + 1;
  }
  return Some(params);
}

impl AuthIdentity {
  pub fn new(subject: String) -> AuthIdentity
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return AuthIdentity { identity_subject: subject };
  }

  pub fn subject(self: &AuthIdentity) -> String
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return self.identity_subject.clone();
  }
}

fn json_field(value: &JsonValue, name: &String) -> Option<JsonNode>
  intent "JSON のトップレベルのオブジェクトから名前付きの値を読む"
  requires none
  ensures none
  effects none
{
  let nodes = value.nodes();
  let node = nodes.get(value.root())?;
  match node {
    JsonNode.Object(fields) => {
      let mut i = 0;
      while i < fields.len() {
        let field = fields.get(i)?;
        if field.name() == name {
          let child = nodes.get(field.index())?;
          return Some(child.clone());
        }
        i = i + 1;
      }
    }
    _ => {}
  }
  return None;
}

fn ascii_lower_byte(b: Int) -> Int
  intent "ASCII 英大文字を小文字に変換する"
  requires none
  ensures none
  effects none
{
  if b >= 65 && b <= 90 {
    return b + 32;
  }
  return b;
}

fn ascii_eq_ignore_case(a: &String, b: &String) -> Bool
  intent "ASCII 文字列を大文字小文字を区別せずに比較する"
  requires none
  ensures none
  effects none
{
  let ab = a.as_bytes();
  let bb = b.as_bytes();
  if ab.byte_len() != bb.byte_len() {
    return false;
  }
  let mut i = 0;
  while i < ab.byte_len() {
    let ca = match ab.get(i) {
      Some(c) => ascii_lower_byte(c),
      None => -1,
    };
    let cb = match bb.get(i) {
      Some(c) => ascii_lower_byte(c),
      None => -2,
    };
    if ca != cb {
      return false;
    }
    i = i + 1;
  }
  return true;
}

impl AppRequest {
  pub fn method(self: &AppRequest) -> String
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return self.app_method.clone();
  }

  pub fn path(self: &AppRequest) -> String
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return self.app_path.clone();
  }

  pub fn body(self: &AppRequest) -> Bytes
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return self.app_body.clone();
  }

  pub fn identity(self: &AppRequest) -> Option<AuthIdentity>
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return match self.app_identity {
      Some(v) => Some(AuthIdentity.new(v.subject())),
      None => None,
    };
    return None;
  }

  pub fn header(self: &AppRequest, name: &String) -> Option<Bytes>
    intent "前段ヘッダーも未検証の生値としてのみ返す。名前は大文字小文字無視"
    requires none
    ensures none
    effects none
  {
    let mut i = 0;
    while i < self.app_headers.len() {
      match self.app_headers.get(i) {
        Some(h) => {
          let hname = h.name();
          if ascii_eq_ignore_case(&hname, &name) {
            return Some(h.value());
          }
        }
        None => {}
      }
      i = i + 1;
    }
    return None;
  }

  pub fn header_count(self: &AppRequest, name: &String) -> Int
    intent "ヘッダーの全出現件数を取得する（大文字小文字無視）"
    requires none
    ensures none
    effects none
  {
    let mut count = 0;
    let mut i = 0;
    while i < self.app_headers.len() {
      match self.app_headers.get(i) {
        Some(h) => {
          let hname = h.name();
          if ascii_eq_ignore_case(&hname, &name) {
            count = count + 1;
          }
        }
        None => {}
      }
      i = i + 1;
    }
    return count;
  }

  pub fn param(self: &AppRequest, name: &String) -> Result<String, HttpResponse>
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return find_param(&self.app_params, &name);
  }

  pub fn query(self: &AppRequest, name: &String) -> Result<String, HttpResponse>
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return find_param(&self.app_query, &name);
  }

  pub fn param_int(self: &AppRequest, name: &String) -> Result<Int, HttpResponse>
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return self.param(&name)?.parse_int().map_err(|e| error_response(400));
  }

  pub fn query_int(self: &AppRequest, name: &String) -> Result<Int, HttpResponse>
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    return self.query(&name)?.parse_int().map_err(|e| error_response(400));
  }

  pub fn json(self: &AppRequest) -> Result<JsonValue, HttpResponse>
    intent "JSONモジュールの深さ64・構文検査を適用し失敗を固定の400へ写す"
    requires none
    ensures none
    effects none
  {
    return json.parse(&self.app_body).map_err(|e| error_response(400));
  }

  pub fn json_string(self: &AppRequest, name: &String) -> Result<String, HttpResponse>
    intent "JSON の値を型付きで読み、欠落・型違いは400にする"
    requires none
    ensures none
    effects none
  {
    let value = self.json()?;
    match json_field(&value, &name).ok_or(error_response(400))? {
      JsonNode.Str(v) => {
        return Ok(v.clone());
      }
      _ => {}
    }
    return Err(error_response(400));
  }

  pub fn json_int(self: &AppRequest, name: &String) -> Result<Int, HttpResponse>
    intent "JSON の値を型付きで読み、欠落・型違いは400にする"
    requires none
    ensures none
    effects none
  {
    let value = self.json()?;
    match json_field(&value, &name).ok_or(error_response(400))? {
      JsonNode.Int(v) => {
        return Ok(v);
      }
      _ => {}
    }
    return Err(error_response(400));
  }
}

impl Router {
  pub fn new() -> Router
    intent "認証検証器なし・問い合わせ上限100で既定拒否のルーターを作る"
    requires none
    ensures none
    effects none
  {
    return Router { router_routes: List.new(), router_before: List.new(), router_after: List.new(), router_verifier: None, router_query_max: 100 };
  }

  pub fn with_limits(self: Router, limits: &AppLimits) -> Router
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    let mut router = self;
    router.router_query_max = limits.query_params_max();
    return router;
  }

  pub fn route(self: Router, method: String, path: String, handler: RouteHandler) -> Result<Router, HttpResponse>
    intent "通常の経路は必ず認証必須として登録する"
    requires none
    ensures none
    effects none
  {
    return self.add_route(method, path, handler, AuthPolicy.Required).ok_or(error_response(400));
  }

  pub fn public_route(self: Router, method: String, path: String, handler: RouteHandler) -> Result<Router, HttpResponse>
    intent "明示した公開経路だけを認証から外す"
    requires none
    ensures none
    effects none
  {
    return self.add_route(method, path, handler, AuthPolicy.Public).ok_or(error_response(400));
  }

  fn add_route(self: Router, method: String, path: String, handler: RouteHandler, policy: AuthPolicy) -> Option<Router>
    intent "経路パターンを検査し、同一メソッドで重なる経路を拒否する"
    requires none
    ensures none
    effects none
  {
    let segments = path_segments(&path).ok()?;
    if method == "" {
      return None;
    }
    let method_bytes = method.as_bytes();
    let mut method_index = 0;
    while method_index < method_bytes.byte_len() {
      let b = method_bytes.get(method_index).unwrap_or(0);
      let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
      let digit = b >= 48 && b <= 57;
      let punctuation = b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126;
      if !alpha && !digit && !punctuation {
        return None;
      }
      method_index = method_index + 1;
    }
    let mut names = List.new();
    let mut i = 0;
    while i < segments.len() {
      let segment = segments.get(i)?;
      let bytes = segment.as_bytes();
      if bytes.get(0).unwrap_or(0) == 58 {
        if bytes.byte_len() == 1 {
          return None;
        }
        let name = bytes.slice(1, bytes.byte_len()).unwrap_or(Bytes.new()).to_string_utf8().unwrap_or("");
        let mut j = 0;
        while j < names.len() {
          if names.get(j)? == name {
            return None;
          }
          j = j + 1;
        }
        names.push(name);
      }
      i = i + 1;
    }
    let mut router = self;
    // 同一メソッドで重なるパターンは公開/必須の曖昧な優先順位を作らず拒否する。
    i = 0;
    while i < router.router_routes.len() {
      let previous = router.router_routes.get(i)?;
      if previous.route_method == method {
        let old_segments = path_segments(&previous.route_path).ok()?;
        if old_segments.len() == segments.len() {
          let mut overlaps = true;
          let mut j = 0;
          while j < segments.len() {
            let a = segments.get(j)?;
            let b = old_segments.get(j)?;
            let a_bytes = a.as_bytes();
            let b_bytes = b.as_bytes();
            let a_variable = a_bytes.get(0).unwrap_or(0) == 58;
            let b_variable = b_bytes.get(0).unwrap_or(0) == 58;
            if a != b && !a_variable && !b_variable {
              overlaps = false;
            }
            j = j + 1;
          }
          if overlaps {
            return None;
          }
        }
      }
      i = i + 1;
    }
    router.router_routes.push(WebRoute { route_method: method, route_path: path, route_handler: handler, route_auth: policy });
    return Some(router);
  }

  pub fn before(self: Router, hook: BeforeHook) -> Router
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    let mut router = self;
    router.router_before.push(hook);
    return router;
  }

  pub fn after(self: Router, hook: AfterHook) -> Router
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    let mut router = self;
    router.router_after.push(hook);
    return router;
  }

  pub fn with_auth(self: Router, verifier: AuthVerifier) -> Router
    intent "入力を検査して安全な結果を返す"
    requires none
    ensures none
    effects none
  {
    let mut router = self;
    router.router_verifier = Some(verifier);
    return router;
  }

  pub fn public_routes(self: &Router) -> List<String>
    intent "認証を外した経路を登録順で METHOD PATH の一覧として監査可能にする"
    requires none
    ensures none
    effects none
  {
    let mut items = List.new();
    let mut i = 0;
    while i < self.router_routes.len() {
      match self.router_routes.get(i) {
        Some(route) => {
          match route.route_auth {
            AuthPolicy.Public => {
              let text = route.route_method.as_bytes().concat(&" ".as_bytes()).concat(&route.route_path.as_bytes());
              items.push(text.to_string_utf8().unwrap_or(""));
            }
            AuthPolicy.Required => {}
          }
        }
        None => {}
      }
      i = i + 1;
    }
    return items;
  }

  pub fn dispatch(self: &Router, req: &HttpRequest) -> HttpResponse
    intent "ソケットなしで境界検査・認証・フックを適用する。内部の一覧不整合は安全な500にする"
    requires none
    ensures none
    effects clock, console, db, env, random, task
  {
    return self.try_dispatch(&req).unwrap_or(error_response(500));
  }

  fn try_dispatch(self: &Router, req: &HttpRequest) -> Option<HttpResponse>
    intent "ソケットなしで境界検証・照合・認証・前処理・ハンドラ・後処理を順に適用する"
    requires none
    ensures none
    effects clock, console, db, env, random, task
  {
    let mut path = "";
    match decode_path(&req.path()) {
      Ok(v) => {
        path = v;
      }
      Err(e) => {
        return Some(e);
      }
    }
    let mut segments = List.new();
    match path_segments(&path) {
      Ok(v) => {
        segments = v;
      }
      Err(e) => {
        return Some(e);
      }
    }
    let mut query = List.new();
    match parse_query(&req.query(), self.router_query_max) {
      Ok(v) => {
        query = v;
      }
      Err(e) => {
        return Some(e);
      }
    }
    let method = req.method();
    let mut i = 0;
    let mut path_found = false;
    while i < self.router_routes.len() {
      let route = self.router_routes.get(i)?;
      match match_route(&route.route_path, &segments) {
        Some(params) => {
          path_found = true;
          if route.route_method == method {
            let mut request = AppRequest { app_method: method, app_path: path, app_query: query, app_params: params, app_headers: req.headers(), app_body: req.body(), app_identity: None };
            match route.route_auth {
              AuthPolicy.Required => {
                match self.router_verifier {
                  Some(verifier) => {
                    match verifier.verify(&request) {
                      Ok(identity) => {
                        request.app_identity = Some(identity);
                      }
                      Err(response) => {
                        // レート制限の429だけは検証器の応答を通す。それ以外は理由を隠して固定401にする。
                        if response.status() == 429 {
                          return Some(response);
                        }
                        return Some(bearer_unauthorized());
                      }
                    }
                  }
                  None => {
                    return Some(bearer_unauthorized());
                  }
                }
              }
              AuthPolicy.Public => {}
            }
            let mut early = None;
            let mut j = 0;
            let mut stopped = false;
            while j < self.router_before.len() && !stopped {
              let hook = self.router_before.get(j)?;
              match hook.run(&request) {
                Some(response) => {
                  early = Some(response);
                  stopped = true;
                }
                None => {}
              }
              j = j + 1;
            }
            let mut response = match early {
              Some(r) => r,
              None => route.route_handler.handle(&request),
            };
            // 後処理は登録の逆順。境界検査・認証失敗時にはフックを呼ばない。
            j = self.router_after.len();
            while j > 0 {
              j = j - 1;
              let hook = self.router_after.get(j)?;
              response = hook.run(&request, response);
            }
            return Some(response);
          }
        }
        None => {}
      }
      i = i + 1;
    }
    if path_found {
      return Some(error_response(405));
    }
    return Some(error_response(404));
  }
}

// ADR 0037 / 6-6c。表示・鍵の取出し・再読込 API を持たない起動時設定。
pub struct BearerConfig {
  bearer_key: Secret,
  bearer_audience: String,
}

pub fn load_bearer_config() -> Result<BearerConfig, ConfigError>
  intent "起動時に鍵と audience を一回読み不正値を固定分類で拒否する"
  requires none
  ensures none
  effects env
{
  // 両変数をここだけで各一回読む。失敗しても値をエラーに保持しない。
  let key_text = env.get(&"SIGIL_AUTH_HMAC_KEY_HEX");
  let audience_text = env.get(&"SIGIL_AUTH_AUDIENCE");
  let mut key = "";
  match key_text {
    Some(text) => { key = text; }
    None => { return Err(ConfigError { config_name: "SIGIL_AUTH_HMAC_KEY_HEX", config_kind: "missing" }); }
  }
  let key_bytes = key.as_bytes();
  if key_bytes.byte_len() != 64 {
    let wipe = Secret.from_bytes(key_bytes);
    return Err(ConfigError { config_name: "SIGIL_AUTH_HMAC_KEY_HEX", config_kind: "invalid" });
  }
  let mut decoded = Bytes.new();
  let mut i = 0;
  while i < 64 {
    let hi = bearer_hex(key_bytes.get(i).unwrap_or(256));
    let lo = bearer_hex(key_bytes.get(i + 1).unwrap_or(256));
    if hi < 0 || lo < 0 {
      let wipe = Secret.from_bytes(key_bytes);
      let partial = Secret.from_bytes(decoded);
      return Err(ConfigError { config_name: "SIGIL_AUTH_HMAC_KEY_HEX", config_kind: "invalid" });
    }
    decoded.push(hi * 16 + lo);
    i = i + 2;
  }
  let wipe = Secret.from_bytes(key_bytes);
  let secret = Secret.from_bytes(decoded);
  let mut audience = "";
  match audience_text {
    Some(text) => { audience = text; }
    None => { return Err(ConfigError { config_name: "SIGIL_AUTH_AUDIENCE", config_kind: "missing" }); }
  }
  if !bearer_identifier(&audience.as_bytes(), 128) {
    return Err(ConfigError { config_name: "SIGIL_AUTH_AUDIENCE", config_kind: "invalid" });
  }
  return Ok(BearerConfig { bearer_key: secret, bearer_audience: audience });
}

fn bearer_hex(c: Int) -> Int
  intent "小文字 hex の一桁だけを受け付ける"
  requires none
  ensures none
  effects none
{
  if c >= 48 && c <= 57 { return c - 48; }
  if c >= 97 && c <= 102 { return c - 87; }
  return -1;
}

impl BearerConfig {
  pub fn into_verifier(self: BearerConfig) -> Result<AuthVerifier, ConfigError>
    intent "待受前に時計を確認し不変設定を所有する検証クロージャを作る"
    requires none
    ensures none
    effects clock
  {
    match clock.unix_seconds() {
      None => { return Err(ConfigError { config_name: "clock.unix_seconds", config_kind: "unavailable" }); }
      Some(_) => {}
    }
    let config = self;
    let rate = SyncShared.new(Lock.new(BearerRate { rate_start: -1, rate_count: 0 }));
    return Ok(AuthVerifier { verify: move |req| bearer_request(&config, &rate, &req) });
  }
}

// ADR 0037 / Issue #659: 外部公開前の最低限の対策としてのレート制限の状態。
// キーは検証器全体の認証失敗回数だけにする。接続元アドレスは要求型に無く、
// 署名検証前の未検証クレームはキーにできない（ADR 0037 決定3）ため。
// 閾値（60秒で失敗100回）は判断の手順（typesafe-ai 正式判定、2026-11-22）で
// 確定した定数で、設定面（環境変数等）は広げない。状態はプロセス内のみ。
struct BearerRate {
  rate_start: Int,
  rate_count: Int,
}

fn bearer_rate_limited(rate: &BearerRate, now: Int) -> Option<Int>
  intent "制限中なら再試行までの秒数を返す。ウィンドウ外か上限未満なら None"
  requires none
  ensures none
  effects none
{
  // 壁時計が巻き戻ったとき（now < rate_start）もウィンドウの外として扱う。
  // 巻き戻しをウィンドウ内とみなすと、制限が巻き戻し分だけ長く続いてしまう。
  if rate.rate_start < 0 || now < rate.rate_start || now >= rate.rate_start + 60 { return None; }
  if rate.rate_count < 100 { return None; }
  return Some(rate.rate_start + 60 - now);
}

fn bearer_rate_note_failure(rate: &mut BearerRate, now: Int)
  intent "認証失敗を数える。最初の失敗でウィンドウを開き、経過後は数え直す"
  requires none
  ensures none
  effects none
{
  // 壁時計の巻き戻し（now < rate_start）も新しいウィンドウを開く。
  if rate.rate_start < 0 || now < rate.rate_start || now >= rate.rate_start + 60 {
    rate.rate_start = now;
    rate.rate_count = 1;
    return;
  }
  rate.rate_count = rate.rate_count + 1;
}

fn bearer_rate_gate(rate: &SyncShared<Lock<BearerRate>>, now: Int) -> Option<Int>
  intent "共有状態を読み、制限中なら再試行までの秒数を返す。ロックが壊れていれば制限しない"
  requires none
  ensures none
  effects task.share, task.suspend
{
  let lock = rate.borrow();
  match lock.acquire() {
    Err(_) => { return None; }
    Ok(g) => { return bearer_rate_limited(g.get(), now); }
  }
}

fn bearer_rate_record(rate: &SyncShared<Lock<BearerRate>>, now: Int)
  intent "共有状態へ認証失敗を一回分記録する。ロックが壊れていれば記録しない"
  requires none
  ensures none
  effects task.share, task.suspend
{
  let lock = rate.borrow();
  match lock.acquire() {
    Err(_) => {}
    Ok(g0) => {
      let mut g = g0;
      bearer_rate_note_failure(g.get_mut(), now);
    }
  }
}

fn bearer_request(config: &BearerConfig, rate: &SyncShared<Lock<BearerRate>>, req: &AppRequest) -> Result<AuthIdentity, HttpResponse>
  intent "要求時の一回の時計取得でレート制限を確認し、単一の Bearer を検証する。失敗は数え、成功は数えず戻しもしない"
  requires none
  ensures none
  effects clock, task.share, task.suspend
{
  // 不正ヘッダでも時計を一回だけ取得する。公開経路では呼ばれない。
  let now = clock.unix_seconds();
  match now {
    None => { return Err(bearer_unauthorized()); }
    Some(sec) => {
      match bearer_rate_gate(&rate, sec) {
        Some(retry) => { return Err(bearer_too_many(retry)); }
        None => {}
      }
      match bearer_attempt(&config, &req, sec) {
        Ok(identity) => { return Ok(identity); }
        Err(response) => {
          bearer_rate_record(&rate, sec);
          return Err(response);
        }
      }
    }
  }
}

fn bearer_attempt(config: &BearerConfig, req: &AppRequest, sec: Int) -> Result<AuthIdentity, HttpResponse>
  intent "単一の Bearer を抽出し、取得済みの時刻で検証する"
  requires none
  ensures none
  effects none
{
  if req.header_count(&"authorization") != 1 { return Err(bearer_unauthorized()); }
  let value = req.header(&"authorization").unwrap_or(Bytes.new());
  if value.byte_len() < 8 { return Err(bearer_unauthorized()); }
  let prefix = value.slice(0, 7).unwrap_or(Bytes.new());
  if !bearer_scheme(&prefix) { return Err(bearer_unauthorized()); }
  let token = value.slice(7, value.byte_len()).unwrap_or(Bytes.new());
  match verify_bearer(&config.bearer_key, &config.bearer_audience, &token, sec) {
    Ok(identity) => { return Ok(identity); }
    Err(_) => { return Err(bearer_unauthorized()); }
  }
}

fn bearer_scheme(prefix: &Bytes) -> Bool
  intent "Bearer と一個の SP を ASCII 大小不問で比較する"
  requires none
  ensures none
  effects none
{
  let expected = "bearer ".as_bytes();
  if prefix.byte_len() != 7 { return false; }
  let mut i = 0;
  while i < 7 {
    let mut c = prefix.get(i).unwrap_or(256);
    if c >= 65 && c <= 90 { c = c + 32; }
    if c != expected.get(i).unwrap_or(257) { return false; }
    i = i + 1;
  }
  return true;
}

fn bearer_unauthorized() -> HttpResponse
  intent "認証失敗は理由にかかわらず固定の401とベアラー見出しだけを返す"
  requires none
  ensures none
  effects none
{
  return error_response(401).with_header(&"www-authenticate", &"Bearer".as_bytes()).with_header(&"cache-control", &"no-store".as_bytes());
}

fn bearer_too_many(retry_after: Int) -> HttpResponse
  intent "レート制限中は理由にかかわらず固定の429と再試行までの秒数だけを返す"
  requires none
  ensures none
  effects none
{
  return error_response(429).with_header(&"retry-after", &decimal(retry_after).as_bytes()).with_header(&"cache-control", &"no-store".as_bytes());
}

// ADR 0037 / Issue #507: 純粋な検証核。設定読込・HTTP・時計取得は行わない。
// key と audience は検証済み設定から渡す。入口でも不正な長さ等を Err にし、
// 暗号の requires 違反へ進めない。失敗値は公開の固定文字列だけ。
// token / audience / now は公開入力。鍵の内容は ct_bearer_signature だけへ流す。
// 検証器全体の処理時間は一定ではない（形式と認証成否で分岐する）。
pub fn verify_bearer(key: &Secret, audience: &String, token: &Bytes, now: Int) -> Result<AuthIdentity, String>
  intent "受信トークンを署名検証後に解釈し主体だけを返す"
  requires none
  ensures none
  effects none
{
  if key.byte_len() != 32 || now < 0 || now > 253402300799 { return Err("unauthorized"); }
  let expected_aud = audience.as_bytes();
  if !bearer_identifier(&expected_aud, 128) { return Err("unauthorized"); }
  if token.byte_len() > 1024 || token.byte_len() < 9 { return Err("unauthorized"); }
  let mut dots = 0;
  let mut split = 0;
  let mut i = 0;
  while i < token.byte_len() {
    if token.get(i).unwrap_or(0) == 46 { dots = dots + 1; split = i; }
    i = i + 1;
  }
  if dots != 2 { return Err("unauthorized"); }
  let prefix = token.slice(0, 7).unwrap_or(Bytes.new());
  if prefix != "sigil1.".as_bytes() || split <= 7 { return Err("unauthorized"); }
  let encoded = token.slice(7, split).unwrap_or(Bytes.new());
  let tag_text = token.slice(split + 1, token.byte_len()).unwrap_or(Bytes.new());
  if tag_text.byte_len() != 43 { return Err("unauthorized"); }
  // ここでは復号と正規形・サイズの確認のみ。フィールドには触れない。
  let payload = bearer_base64url(&encoded, 404)?;
  let tag = bearer_base64url(&tag_text, 32)?;
  if tag.byte_len() != 32 { return Err("unauthorized"); }
  let signed = token.slice(0, split).unwrap_or(Bytes.new());
  if !ct_bearer_signature(&key, &signed, &tag) { return Err("unauthorized"); }
  // 署名後の意味解釈はこの一箇所だけ。HMAC は上の一回だけ。
  return bearer_claims(&payload, &expected_aud, now);
}

// 暗号の核だけを CT と称する。鍵は Secret、message/tag は公開の受信バイト。
// 戻り値は明示的に公開される認証成否。鍵・期待 MAC を外へ返さない。
fn ct_bearer_signature(key: &Secret, message: &Bytes, tag: &Bytes) -> Bool
  intent "既存 HMAC の定数時間照合に受信署名対象を渡す"
  requires none
  ensures none
  effects none
{
  return verify_hmac_sha256(&key, &message, &tag);
}

fn bearer_digit(c: Int) -> Int
  intent "公開 base64url 文字を六ビット値へ変換する"
  requires none
  ensures none
  effects none
{
  if c >= 65 && c <= 90 { return c - 65; }
  if c >= 97 && c <= 122 { return c - 71; }
  if c >= 48 && c <= 57 { return c + 4; }
  if c == 45 { return 62; }
  if c == 95 { return 63; }
  return 0 - 1;
}

fn bearer_base64url(data: &Bytes, max: Int) -> Result<Bytes, String>
  intent "パディング無し base64url の正規形だけを上限付きで復号する"
  requires none
  ensures none
  effects none
{
  if data.byte_len() == 0 || data.byte_len() % 4 == 1 || data.byte_len() > ((max * 4 + 2) / 3) { return Err("unauthorized"); }
  let mut out = Bytes.new();
  let mut acc = 0;
  let mut bits = 0;
  let mut i = 0;
  while i < data.byte_len() {
    let value = bearer_digit(data.get(i).unwrap_or(0));
    if value < 0 { return Err("unauthorized"); }
    acc = (acc << 6) | value;
    bits = bits + 6;
    if bits >= 8 {
      bits = bits - 8;
      out.push((acc >> bits) & 255);
      acc = acc & ((1 << bits) - 1);
    }
    i = i + 1;
  }
  // 正規アルファベット、不可能長の排除、未使用ビットゼロは
  // 復号して再符号化した文字列との完全一致と同値。
  if acc != 0 || out.byte_len() > max { return Err("unauthorized"); }
  return Ok(out);
}

fn bearer_identifier(data: &Bytes, max: Int) -> Bool
  intent "公開の audience と subject の ASCII 制約を確かめる"
  requires none
  ensures none
  effects none
{
  if data.byte_len() == 0 || data.byte_len() > max { return false; }
  let mut i = 0;
  while i < data.byte_len() {
    let c = data.get(i).unwrap_or(0);
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 46 || c == 95 || c == 58 || c == 45) { return false; }
    i = i + 1;
  }
  return true;
}

fn bearer_time(data: &Bytes, offset: Int) -> Result<Int, String>
  intent "符号無し大端の時刻を範囲検査してから Int に組み立てる"
  requires none
  ensures none
  effects none
{
  let mut value = 0;
  let mut i = 0;
  while i < 8 {
    let b = data.get(offset + i).unwrap_or(0);
    // 乗算・加算より先に 9999 年末の範囲を検査する。
    if value > (253402300799 - b) / 256 { return Err("unauthorized"); }
    value = value * 256 + b;
    i = i + 1;
  }
  return Ok(value);
}

fn bearer_claims(data: &Bytes, audience: &Bytes, now: Int) -> Result<AuthIdentity, String>
  intent "署名済みの固定 binary の時刻と対象を検査し主体を作る"
  requires none
  ensures none
  effects none
{
  if data.byte_len() < 22 { return Err("unauthorized"); }
  let iat = bearer_time(&data, 0)?;
  let exp = bearer_time(&data, 8)?;
  if exp <= iat || iat > now || now >= exp { return Err("unauthorized"); }
  if exp - iat > 3600 { return Err("unauthorized"); }
  let aud_len = data.get(16).unwrap_or(0) * 256 + data.get(17).unwrap_or(0);
  if aud_len < 1 || aud_len > 128 || 20 + aud_len > data.byte_len() { return Err("unauthorized"); }
  let aud = data.slice(18, 18 + aud_len).unwrap_or(Bytes.new());
  if !bearer_identifier(&aud, 128) || aud != audience { return Err("unauthorized"); }
  let pos = 18 + aud_len;
  let sub_len = data.get(pos).unwrap_or(0) * 256 + data.get(pos + 1).unwrap_or(0);
  if sub_len < 1 || sub_len > 256 || pos + 2 + sub_len != data.byte_len() { return Err("unauthorized"); }
  let sub = data.slice(pos + 2, data.byte_len()).unwrap_or(Bytes.new());
  if !bearer_identifier(&sub, 256) { return Err("unauthorized"); }
  return Ok(AuthIdentity.new(sub.to_string_utf8().unwrap_or("")));
}
