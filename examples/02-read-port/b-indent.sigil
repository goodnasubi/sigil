# 例 02: 設定ファイルからポート番号を読む（候補 B: インデント + キーワード）
# 副作用（ファイル読み込み）と失敗（Result）を含む関数。
# 値の範囲は篩型（refinement type）で表し、事後条件を型に寄せる。

type Port = Int where 1 <= self and self <= 65535

enum ReadPortError
  Io(IoError)
  NotANumber(String)
  OutOfRange(Int)

fn read_port
  intent   "設定ファイルの内容を整数として読み、ポート番号として返す"
  params   path: Path
  returns  Result[Port, ReadPortError]
  requires not empty(path)
  ensures  none
  effects  fs.read(path)
  body
    let text = fs.read(path).map_err(ReadPortError.Io)?
    match parse_int(trim(text))
      Ok(n)  -> Port.check(n, ReadPortError.OutOfRange(n))
      Err(_) -> Err(ReadPortError.NotANumber(text))
