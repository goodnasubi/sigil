;; 例 02: 設定ファイルからポート番号を読む（候補 A: S 式）
;; 副作用（ファイル読み込み）と失敗（Result）を含む関数。
;; 値の範囲は篩型（refinement type）で表し、事後条件を型に寄せる。

(type Port (Int (where (<= 1 self 65535))))

(enum ConfigError
  (Io IoError)
  (NotANumber String)
  (OutOfRange Int))

(fn read-port
  (intent "設定ファイルの内容を整数として読み、ポート番号として返す")
  (params (path Path))
  (returns (Result Port ConfigError))
  (requires (not (empty? path)))
  (ensures)
  (effects (fs.read path))
  (body
    (let ((text (try (map-err (fs.read path) ConfigError.Io))))
      (match (parse-int (trim text))
        ((Ok n)  (Port.check n (ConfigError.OutOfRange n)))
        ((Err _) (Err (ConfigError.NotANumber text)))))))
