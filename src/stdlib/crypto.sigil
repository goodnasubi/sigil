module std.crypto
  targets bare, browser, server
  trust none

// 暗号の基本部品（ADR 0024、PR 6-1b・6-1c・6-1d）。秘密を型で隔離する
// `Secret` とその入口の関数、SHA-256（ストリーミング型 `Sha256` と
// ワンショット関数 `sha256`、内部の圧縮関数 `sha256_compress`）、
// HMAC-SHA-256（`hmac_sha256` と照合の `verify_hmac_sha256`）、
// PBKDF2-HMAC-SHA-256（`pbkdf2_sha256`）を置く。
//
// API の形について: 標準ライブラリの表（src/stdlib.rs の IMPLS）にも
// 同じメソッドを宣言して利用者へ見せる。表の宣言とこのモジュールの
// 実装が二重にならないよう、検査器は埋め込みモジュールの `impl` を
// 宣言の実体として受け取る（check/register.rs の register_impl）。
//
// `Secret` は表示（Displayable）を持たない。破棄のときに中身をゼロで
// 上書きするのは、生成系とランタイムの側の取り決め（記述子による破棄）で、
// このモジュールでは中身の置き場を 1 つに保つことで、それを可能にする。
//
// 定数時間のバイト列比較は、言語の自由関数 `ct_eq` が担う（ADR 0024
// 決定 1 の 2: std.crypto の主たる比較手段として位置付け、実体は
// std.core.bytes.ct_equal）。埋め込みモジュール側で同じ名前の関数を
// 置くと自由関数と衝突するため、ここには置かない
// （std.core.bytes の ct_equal と同じ先例）。

pub struct Secret {
  data: Bytes,
}

impl Secret {
  // 範囲: バイト列を取り込んで秘密にする。生成はこの入口に限る。
  pub fn from_bytes(b: Bytes) -> Secret
    intent "バイト列を取り込んで秘密にする"
    requires none
    ensures none
    effects none
  {
    return Secret { data: b };
  }

  // 範囲: 中身のバイト列の複製を返す。秘密を取り出す唯一の明示的な入口で、
  // 定数時間検査の対象（tests/ct_rules.rs の対象表）に含める。
  // ADR 0024 の素描は `-> &Bytes` だが、場所への参照を返すのは言語の
  // 組み込みだけに許される形で、Sigil で書いたメソッドは値の複製を返す
  // 形になる（取り出しが明示的な 1 点に限られる、という不変条件は保つ。
  // 複製は呼び出し側の所有物になり、元の秘密の破棄・ゼロ化とは独立する）。
  pub fn expose(self: &Secret) -> Bytes
    intent "中身のバイト列の複製を返す（秘密の明示的な取り出し）"
    requires none
    ensures none
    effects none
  {
    return self.data.clone();
  }

  pub fn byte_len(self: &Secret) -> Int
    intent "中身のバイト列の長さを返す（定数時間）。バイト位置を要求する API にはこの値を使う"
    requires none
    ensures none
    effects none
  {
    return self.data.byte_len();
  }
}

// ---------------------------------------------------------------------------
// SHA-256（ADR 0024 決定 1 の 3、PR 6-1c）。RFC 6234 / FIPS 180-4 準拠。
//
// 内部の圧縮は `sha256_compress` に寄せる。引数のうち公開なのは
// `block_count`（処理する 64 バイトブロックの数）だけで、ループ回数・
// 添字はすべてそこから派生するカウンタと定数で決める（長さも公開の情報
// だが、ADR の対象表の形に合わせて block_count 駆動にする）。圧縮の
// 中身は &, |, ^, ~, >>, rotr32 と 32 ビット幅への切り詰め（加算後に
// & 0xFFFFFFFF）だけで書き、秘密の値に依存する分岐・添字・除算は持たない
// （tests/ct_rules.rs の対象表と静的検査が担保する）。
//
// 書き方の制約（定数時間検査に合わせたもの）:
// - モジュール内の補助関数は置かない: `std.crypto.` で始まる名前はすべて
//   包括基準に当たるため、定数表（初期状態・ラウンド定数）の組み立ては
//   使う場所に直接書く。
// - 一覧の読みは `get(i).map(|x| x + 0).unwrap_or(0)` で受ける。`match` で
//   受けると、秘密の領域から読んだ値の振り分け（判別）自体が分岐として
//   R1 に当たる。範囲外は来ないので既定値は使われない。
// - 圧縮は次の状態を戻り値で返す。要素への代入（get_mut の受け取り）も
//   同じ理由で使わず、状態の差し替えは呼び出し側で行う。

pub struct Sha256 {
  state: List<Int>,
  buffer: Bytes,
  total_len: Int,
}

impl Sha256 {
  // 範囲: 初期状態（FIPS 180-4 の初期ハッシュ値）を持つ文脈を作る。
  pub fn new() -> Sha256
    intent "SHA-256 コンテキストを初期化する"
    requires none
    ensures none
    effects none
  {
    let mut st = List.new();
    st.push(0x6a09e667);
    st.push(0xbb67ae85);
    st.push(0x3c6ef372);
    st.push(0xa54ff53a);
    st.push(0x510e527f);
    st.push(0x9b05688c);
    st.push(0x1f83d9ab);
    st.push(0x5be0cd19);
    return Sha256 { state: st, buffer: Bytes.new(), total_len: 0 };
  }

  // 範囲: バイト列を追加する。64 バイト溜まったブロックから順に圧縮し、
  // 端数は buffer に残す。圧縮へ渡すブロック数は 1 つずつ（溜まった分を
  // その場で処理する）。
  pub fn update(self: &mut Sha256, data: &Bytes)
    intent "バイト列を追加して状態を更新する"
    requires none
    ensures none
    effects none
  {
    self.total_len = self.total_len + data.byte_len();
    let mut buf = self.buffer.clone();
    buf.extend(&data);
    while buf.byte_len() >= 64 {
      let block = buf.slice(0, 64).unwrap_or(Bytes.new());
      self.state = sha256_compress(&self.state, &block, 1);
      buf = buf.slice(64, buf.byte_len()).unwrap_or(Bytes.new());
    }
    self.buffer = buf;
  }

  // 範囲: パディングを適用して 32 バイトのダイジェストを返す。パディング
  // の形（0x80 の位置・ゼロの数・末尾の長さ欄）は入力の長さ（公開の情報）
  // だけから決める。
  pub fn finalize(self: &mut Sha256) -> Bytes
    intent "パディングを適用し 32 バイトのダイジェストを返す"
    requires none
    ensures result.byte_len() == 32
    effects none
  {
    let zero = 0;
    let mut tail = self.buffer.clone();
    tail.push(0x80);
    while tail.byte_len() % 64 != 56 {
      tail.push(0);
    }
    tail.push_u64_be(self.total_len * 8);
    self.state = sha256_compress(&self.state, &tail, tail.byte_len() / 64);
    // 状態の読みは写しを取ってから行う（フィールド越しの get と既定値の
    // 借用が重なると、参照の位置の規則に合わないため）。
    let done = self.state.clone();
    let mut out = Bytes.new();
    out.push_u32_be(done.get(0).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(1).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(2).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(3).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(4).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(5).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(6).map(|x| x + 0).unwrap_or(0));
    out.push_u32_be(done.get(7).map(|x| x + 0).unwrap_or(0));
    return out;
  }
}

// 範囲: データ全体のダイジェストを 1 回で計算する。パディング済みの全体を
// 組み立てて圧縮を 1 回呼ぶ（ストリーミングのメソッド経由にはしない:
// メソッドは定数時間検査の対象表にないため、秘密の値を渡すと R4 の
// 違反になる。tests/ct_rules.rs の設計判断）。
pub fn sha256(data: &Bytes) -> Bytes
  intent "データ全体の SHA-256 ダイジェスト (32 バイト) を計算する"
  requires none
  ensures result.byte_len() == 32
  effects none
{
  let mut padded = data.clone();
  padded.push(0x80);
  while padded.byte_len() % 64 != 56 {
    padded.push(0);
  }
  padded.push_u64_be(data.byte_len() * 8);
  let mut st = List.new();
  st.push(0x6a09e667);
  st.push(0xbb67ae85);
  st.push(0x3c6ef372);
  st.push(0xa54ff53a);
  st.push(0x510e527f);
  st.push(0x9b05688c);
  st.push(0x1f83d9ab);
  st.push(0x5be0cd19);
  let done = sha256_compress(&st, &padded, padded.byte_len() / 64);
  let mut done_b = Bytes.new();
  done_b.push_u32_be(done.get(0).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(1).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(2).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(3).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(4).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(5).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(6).map(|x| x + 0).unwrap_or(0));
  done_b.push_u32_be(done.get(7).map(|x| x + 0).unwrap_or(0));
  let out = done_b.clone();
  let done_wipe = Secret.from_bytes(done_b);
  let padded_wipe = Secret.from_bytes(padded);
  return out;
}

// 範囲: 圧縮関数の本体。`data` の先頭から `block_count` 個の 64 バイト
// ブロックを処理し、状態（8 つの 32 ビット語）の次の値を返す。呼び出し側は
// ブロック単位に整えたバイト列を渡す（端数やパディングは呼び出し側）。
pub fn sha256_compress(st: &List<Int>, data: &Bytes, block_count: Int) -> List<Int>
  intent "64 バイトブロックを block_count 個圧縮した次の状態を返す"
  requires none
  ensures none
  effects none
{
  // ラウンド定数 K（FIPS 180-4）。定数は公開の値。
  let mut k = Bytes.new();
  k.push_u32_be(0x428a2f98);
  k.push_u32_be(0x71374491);
  k.push_u32_be(0xb5c0fbcf);
  k.push_u32_be(0xe9b5dba5);
  k.push_u32_be(0x3956c25b);
  k.push_u32_be(0x59f111f1);
  k.push_u32_be(0x923f82a4);
  k.push_u32_be(0xab1c5ed5);
  k.push_u32_be(0xd807aa98);
  k.push_u32_be(0x12835b01);
  k.push_u32_be(0x243185be);
  k.push_u32_be(0x550c7dc3);
  k.push_u32_be(0x72be5d74);
  k.push_u32_be(0x80deb1fe);
  k.push_u32_be(0x9bdc06a7);
  k.push_u32_be(0xc19bf174);
  k.push_u32_be(0xe49b69c1);
  k.push_u32_be(0xefbe4786);
  k.push_u32_be(0x0fc19dc6);
  k.push_u32_be(0x240ca1cc);
  k.push_u32_be(0x2de92c6f);
  k.push_u32_be(0x4a7484aa);
  k.push_u32_be(0x5cb0a9dc);
  k.push_u32_be(0x76f988da);
  k.push_u32_be(0x983e5152);
  k.push_u32_be(0xa831c66d);
  k.push_u32_be(0xb00327c8);
  k.push_u32_be(0xbf597fc7);
  k.push_u32_be(0xc6e00bf3);
  k.push_u32_be(0xd5a79147);
  k.push_u32_be(0x06ca6351);
  k.push_u32_be(0x14292967);
  k.push_u32_be(0x27b70a85);
  k.push_u32_be(0x2e1b2138);
  k.push_u32_be(0x4d2c6dfc);
  k.push_u32_be(0x53380d13);
  k.push_u32_be(0x650a7354);
  k.push_u32_be(0x766a0abb);
  k.push_u32_be(0x81c2c92e);
  k.push_u32_be(0x92722c85);
  k.push_u32_be(0xa2bfe8a1);
  k.push_u32_be(0xa81a664b);
  k.push_u32_be(0xc24b8b70);
  k.push_u32_be(0xc76c51a3);
  k.push_u32_be(0xd192e819);
  k.push_u32_be(0xd6990624);
  k.push_u32_be(0xf40e3585);
  k.push_u32_be(0x106aa070);
  k.push_u32_be(0x19a4c116);
  k.push_u32_be(0x1e376c08);
  k.push_u32_be(0x2748774c);
  k.push_u32_be(0x34b0bcb5);
  k.push_u32_be(0x391c0cb3);
  k.push_u32_be(0x4ed8aa4a);
  k.push_u32_be(0x5b9cca4f);
  k.push_u32_be(0x682e6ff3);
  k.push_u32_be(0x748f82ee);
  k.push_u32_be(0x78a5636f);
  k.push_u32_be(0x84c87814);
  k.push_u32_be(0x8cc70208);
  k.push_u32_be(0x90befffa);
  k.push_u32_be(0xa4506ceb);
  k.push_u32_be(0xbef9a3f7);
  k.push_u32_be(0xc67178f2);
  let mut cur = st.clone();
  let mut blk = 0;
  while blk < block_count {
    // メッセージスケジュール W（64 語）。最初の 16 語はブロックを
    // ビッグエンディアンで読んだもの、残りは小さい σ で広げる。
    let mut w = Bytes.new();
    let mut t = 0;
    while t < 16 {
      w.push_u32_be(data.read_u32_be(blk * 64 + t * 4).unwrap_or(0));
      t = t + 1;
    }
    while t < 64 {
      let x15 = w.read_u32_be((t - 15) * 4).unwrap_or(0);
      let s0 = x15.rotr32(7) ^ x15.rotr32(18) ^ (x15 >> 3);
      let x2 = w.read_u32_be((t - 2) * 4).unwrap_or(0);
      let s1 = x2.rotr32(17) ^ x2.rotr32(19) ^ (x2 >> 10);
      let w16 = w.read_u32_be((t - 16) * 4).unwrap_or(0);
      let w7 = w.read_u32_be((t - 7) * 4).unwrap_or(0);
      w.push_u32_be((w16 + s0 + w7 + s1) & 0xFFFFFFFF);
      t = t + 1;
    }
    // 64 ラウンド。作業変数は局所に置く（Σ・Ch・Maj はすべてビット演算）。
    let mut a = cur.get(0).map(|x| x + 0).unwrap_or(0);
    let mut b = cur.get(1).map(|x| x + 0).unwrap_or(0);
    let mut c = cur.get(2).map(|x| x + 0).unwrap_or(0);
    let mut d = cur.get(3).map(|x| x + 0).unwrap_or(0);
    let mut e = cur.get(4).map(|x| x + 0).unwrap_or(0);
    let mut f = cur.get(5).map(|x| x + 0).unwrap_or(0);
    let mut g = cur.get(6).map(|x| x + 0).unwrap_or(0);
    let mut h = cur.get(7).map(|x| x + 0).unwrap_or(0);
    let mut r = 0;
    while r < 64 {
      let bs1 = e.rotr32(6) ^ e.rotr32(11) ^ e.rotr32(25);
      let ch = (e & f) ^ ((~e) & g);
      let kw = k.read_u32_be(r * 4).unwrap_or(0);
      let ww = w.read_u32_be(r * 4).unwrap_or(0);
      let t1 = (h + bs1 + ch + kw + ww) & 0xFFFFFFFF;
      let bs0 = a.rotr32(2) ^ a.rotr32(13) ^ a.rotr32(22);
      let maj = (a & b) ^ (a & c) ^ (b & c);
      let t2 = (bs0 + maj) & 0xFFFFFFFF;
      h = g;
      g = f;
      f = e;
      e = (d + t1) & 0xFFFFFFFF;
      d = c;
      c = b;
      b = a;
      a = (t1 + t2) & 0xFFFFFFFF;
      r = r + 1;
    }
    // 状態へ作業変数を加算する（32 ビット幅に切り詰める）。次の状態は
    // 新しい一覧に組み立てて差し替える。
    let mut next = List.new();
    next.push((cur.get(0).map(|x| x + 0).unwrap_or(0) + a) & 0xFFFFFFFF);
    next.push((cur.get(1).map(|x| x + 0).unwrap_or(0) + b) & 0xFFFFFFFF);
    next.push((cur.get(2).map(|x| x + 0).unwrap_or(0) + c) & 0xFFFFFFFF);
    next.push((cur.get(3).map(|x| x + 0).unwrap_or(0) + d) & 0xFFFFFFFF);
    next.push((cur.get(4).map(|x| x + 0).unwrap_or(0) + e) & 0xFFFFFFFF);
    next.push((cur.get(5).map(|x| x + 0).unwrap_or(0) + f) & 0xFFFFFFFF);
    next.push((cur.get(6).map(|x| x + 0).unwrap_or(0) + g) & 0xFFFFFFFF);
    next.push((cur.get(7).map(|x| x + 0).unwrap_or(0) + h) & 0xFFFFFFFF);
    cur = next;
    let w_wipe = Secret.from_bytes(w);
    blk = blk + 1;
  }
  return cur;
}

// ---------------------------------------------------------------------------
// HMAC-SHA-256（ADR 0024 決定 1 の 4、PR 6-1d）。RFC 2104 / RFC 4231。
//
// 鍵は `Secret` 必須で、32 バイト未満は `requires` 違反として異常停止
// する（長すぎる鍵を黙って切り詰める事故を型と契約で防ぐ。ADR 0024
// 決定 2）。ブロック長（64 バイト）を超える鍵は SHA-256 で圧縮して
// から使う。鍵の長さによる分岐は、長さ（公開の情報）にだけ依存する。
// 対象表では公開の引数は無し、つまり鍵だけでなくメッセージの中身も
// 秘密として解析する（メッセージは鍵で守る対象でありうるため）。
// 出力も `Secret`。

pub fn hmac_sha256(key: &Secret, message: &Bytes) -> Secret
  intent "HMAC-SHA-256 を計算する"
  requires key.byte_len() >= 32
  ensures result.byte_len() == 32
  effects none
{
  let mut kb = key.expose();
  if kb.byte_len() > 64 {
    let hashed = sha256(&kb);
    let old_kb_wipe = Secret.from_bytes(kb);
    kb = hashed;
  }
  while kb.byte_len() < 64 {
    kb.push(0);
  }
  let mut ipad = Bytes.new();
  let mut opad = Bytes.new();
  let mut i = 0;
  while i < 64 {
    let b = kb.get(i).map(|x| x + 0).unwrap_or(0);
    ipad.push(b ^ 0x36);
    opad.push(b ^ 0x5C);
    i = i + 1;
  }
  let mut inner = ipad;
  inner.extend(&message);
  let inner_hash = sha256(&inner);
  let mut outer = opad;
  outer.extend(&inner_hash);
  let ret = Secret.from_bytes(sha256(&outer));
  let kb_wipe = Secret.from_bytes(kb);
  let in_wipe = Secret.from_bytes(inner);
  let out_wipe = Secret.from_bytes(outer);
  let ih_wipe = Secret.from_bytes(inner_hash);
  return ret;
}

// 範囲: HMAC の照合。計算した値を `ct_eq`（定数時間比較）で比べ、結果を
// そのまま返す（この関数の中で結果による分岐はしない）。

pub fn verify_hmac_sha256(key: &Secret, message: &Bytes, expected: &Bytes) -> Bool
  intent "HMAC-SHA-256 を定数時間で照合する"
  requires key.byte_len() >= 32
  ensures none
  effects none
{
  let mac = hmac_sha256(&key, &message);
  let got = mac.expose();
  let ok = ct_eq(&got, &expected);
  let got_wipe = Secret.from_bytes(got);
  return ok;
}

// ---------------------------------------------------------------------------
// PBKDF2-HMAC-SHA-256（ADR 0024 決定 1 の 5、PR 6-1d）。RFC 2898。
//
// 反復回数は 4096〜100000 を `requires` で強制する（少なすぎる反復を
// 黙って通さない。ADR 0024 決定 2）。塩・反復回数・出力の長さは公開の
// 情報（対象表の公開引数）で、ループの回数と添字はすべてそこから
// 決まる。パスワードだけが秘密。
//
// 協調点（ADR 0024 決定 2）: 反復は長い計算になるため、ブロック内の
// 反復 1024 回ごとに `task.yield` で実行を譲る。6-1d の実装当初は、
// 効果 `task.suspend` の対象が HOSTED（browser / server）のみで、
// `targets` に bare を含むこのモジュールでは宣言も推論もできず、
// 逸脱として yield なしで実装した。その後 ADR 0028 で `task.suspend`
// の対象に bare が含められ（bare での yield は協調点、スケジューラが
// 無い実行では no-op）、本実装で逸脱は解消した。

// 範囲: 鍵のパッド（ipad・opad の 64 バイト）を処理し終えた 2 つの状態から、
// メッセージの HMAC-SHA-256 を求める。PBKDF2 は鍵が全反復で同じなので、
// パッドの圧縮を最初に 1 回だけ行い、反復ごとに内側と外側の 1 ブロックずつ
// （メッセージが 32 バイトのとき）を圧縮するだけで済む（HMAC を毎回計算すると
// 反復ごとに 4 回の圧縮が要る）。パディングの形は、パッドの 64 バイトを含めた
// 全体の長さ（公開の情報）だけから決める。値は `hmac_sha256` と同じ。
fn hmac_from_pads(ist: &List<Int>, ost: &List<Int>, message: &Bytes) -> Bytes
  intent "処理済みのパッドの状態から HMAC-SHA-256 を計算する"
  requires none
  ensures result.byte_len() == 32
  effects none
{
  let mut inner = message.clone();
  inner.push(0x80);
  while inner.byte_len() % 64 != 56 {
    inner.push(0);
  }
  inner.push_u64_be((64 + message.byte_len()) * 8);
  let ih = sha256_compress(&ist, &inner, inner.byte_len() / 64);
  let mut ih_b = Bytes.new();
  ih_b.push_u32_be(ih.get(0).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(1).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(2).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(3).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(4).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(5).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(6).map(|x| x + 0).unwrap_or(0));
  ih_b.push_u32_be(ih.get(7).map(|x| x + 0).unwrap_or(0));
  let mut outer = ih_b.clone();
  outer.push(0x80);
  while outer.byte_len() % 64 != 56 {
    outer.push(0);
  }
  outer.push_u64_be((64 + 32) * 8);
  let oh = sha256_compress(&ost, &outer, outer.byte_len() / 64);
  let mut oh_b = Bytes.new();
  oh_b.push_u32_be(oh.get(0).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(1).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(2).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(3).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(4).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(5).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(6).map(|x| x + 0).unwrap_or(0));
  oh_b.push_u32_be(oh.get(7).map(|x| x + 0).unwrap_or(0));
  let out = oh_b.clone();
  let inner_wipe = Secret.from_bytes(inner);
  let outer_wipe = Secret.from_bytes(outer);
  let ih_wipe = Secret.from_bytes(ih_b);
  let oh_wipe = Secret.from_bytes(oh_b);
  return out;
}

pub fn pbkdf2_sha256(password: &Secret, salt: &Bytes, iterations: Int, dk_len: Int) -> Secret
  intent "PBKDF2-HMAC-SHA-256 で鍵を導出する"
  requires iterations >= 4096 && iterations <= 100000 && dk_len > 0
  ensures result.byte_len() == dk_len
  effects task.suspend
{
  let mut out = Bytes.new();
  // パスワードは HMAC の鍵として使う（RFC 2898）。64 バイトを超えれば SHA-256 で
  // 圧縮し、64 バイトに満たなければゼロで詰める（`hmac_sha256` と同じ規則）。
  // 鍵は全反復で同じなので、ipad・opad のブロックを処理した状態を最初に
  // 1 回だけ求め、反復ごとに使い回す（`hmac_from_pads`）。
  let mut kb = password.expose();
  if kb.byte_len() > 64 {
    let hashed = sha256(&kb);
    let old_kb_wipe = Secret.from_bytes(kb);
    kb = hashed;
  }
  while kb.byte_len() < 64 {
    kb.push(0);
  }
  let mut ipad = Bytes.new();
  let mut opad = Bytes.new();
  let mut i0 = 0;
  while i0 < 64 {
    let b = kb.get(i0).map(|x| x + 0).unwrap_or(0);
    ipad.push(b ^ 0x36);
    opad.push(b ^ 0x5C);
    i0 = i0 + 1;
  }
  let mut init = List.new();
  init.push(0x6a09e667);
  init.push(0xbb67ae85);
  init.push(0x3c6ef372);
  init.push(0xa54ff53a);
  init.push(0x510e527f);
  init.push(0x9b05688c);
  init.push(0x1f83d9ab);
  init.push(0x5be0cd19);
  let ist = sha256_compress(&init, &ipad, 1);
  let ost = sha256_compress(&init, &opad, 1);
  let ipad_wipe = Secret.from_bytes(ipad);
  let opad_wipe = Secret.from_bytes(opad);
  let kb_wipe = Secret.from_bytes(kb);
  let blocks = (dk_len + 31) / 32;
  let mut blk = 1;
  while blk <= blocks {
    let mut msg = salt.clone();
    msg.push_u32_be(blk);
    let mut u = hmac_from_pads(&ist, &ost, &msg);
    let msg_wipe = Secret.from_bytes(msg);
    let mut t = u.clone();
    let mut j = 1;
    while j < iterations {
      let nu = hmac_from_pads(&ist, &ost, &u);
      let old_u_wipe = Secret.from_bytes(u);
      u = nu;
      let mut nt = Bytes.new();
      let mut i = 0;
      while i < t.byte_len() {
        let tb = t.get(i).map(|x| x + 0).unwrap_or(0);
        let ub = u.get(i).map(|x| x + 0).unwrap_or(0);
        nt.push(tb ^ ub);
        i = i + 1;
      }
      let old_t_wipe = Secret.from_bytes(t);
      t = nt;
      if j % 1024 == 0 {
        task.yield();
      }
      j = j + 1;
    }
    let u_wipe = Secret.from_bytes(u);
    out.extend(&t);
    let t_wipe = Secret.from_bytes(t);
    blk = blk + 1;
  }
  let key = out.slice(0, dk_len).unwrap_or(Bytes.new());
  let mut ist_b = Bytes.new();
  ist_b.push_u32_be(ist.get(0).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(1).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(2).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(3).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(4).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(5).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(6).map(|x| x + 0).unwrap_or(0));
  ist_b.push_u32_be(ist.get(7).map(|x| x + 0).unwrap_or(0));
  let mut ost_b = Bytes.new();
  ost_b.push_u32_be(ost.get(0).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(1).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(2).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(3).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(4).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(5).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(6).map(|x| x + 0).unwrap_or(0));
  ost_b.push_u32_be(ost.get(7).map(|x| x + 0).unwrap_or(0));
  let ret = Secret.from_bytes(key);
  let out_wipe = Secret.from_bytes(out);
  let ist_wipe = Secret.from_bytes(ist_b);
  let ost_wipe = Secret.from_bytes(ost_b);
  return ret;
}

// ---------------------------------------------------------------------------
// HKDF-SHA-256（ADR 0058 決定 2・3、段 1a）。RFC 5869。
//
// 引数の型について: ADR 0058 決定 2 のとおり `salt: Option<Secret>`
// （所有権を取り、使い終えたら破棄時にゼロ化される）。言語は `Option<&T>` を
// 戻り値の位置にしか許さない（ADR 0012 決定 1）ため、借用の形にはできない。
//
// Extract は任意長の salt と IKM を受け付け、salt の省略（`None`）は
// HashLen（32）バイトのゼロ列として扱う（RFC 5869 §2.2）。公開の
// `hmac_sha256` は鍵 32 バイト以上を要求する（ADR 0024 決定 2）ため
// 使わず、任意長の鍵を扱う内部の `hmac_any_key` を使う。`hmac_sha256` の
// 公開契約と実装は変えない。PRK は `Secret` を 1 つ持つ型に包み、破棄時の
// ゼロ化は中の `Secret` に任せる。表示の性質は持たせない。
//
// 秘密は salt・IKM・PRK・出力。公開は info・out_len・各長さ（ADR 0058
// 決定 3）。ループの回数と添字は out_len と各長さだけから決まる。

pub struct HkdfSha256Prk {
  key: Secret,
}

// 範囲: 任意長の鍵（0 バイトを含む）による HMAC-SHA-256（RFC 2104）。
// ブロック長 64 バイトを超える鍵は SHA-256 で圧縮し、足りなければゼロで
// 詰める。分岐は鍵の長さ（公開）にだけ依存する。
fn hmac_any_key(key: &Bytes, message: &Bytes) -> Bytes
  intent "任意長の鍵で HMAC-SHA-256 を計算する（HKDF の内部用）"
  requires none
  ensures result.byte_len() == 32
  effects none
{
  let mut kb = key.clone();
  if kb.byte_len() > 64 {
    let hashed = sha256(&kb);
    let old_kb_wipe = Secret.from_bytes(kb);
    kb = hashed;
  }
  while kb.byte_len() < 64 {
    kb.push(0);
  }
  let mut ipad = Bytes.new();
  let mut opad = Bytes.new();
  let mut i = 0;
  while i < 64 {
    let b = kb.get(i).map(|x| x + 0).unwrap_or(0);
    ipad.push(b ^ 0x36);
    opad.push(b ^ 0x5C);
    i = i + 1;
  }
  let mut inner = ipad;
  inner.extend(&message);
  let inner_hash = sha256(&inner);
  let mut outer = opad;
  outer.extend(&inner_hash);
  let out = sha256(&outer);
  let kb_wipe = Secret.from_bytes(kb);
  let in_wipe = Secret.from_bytes(inner);
  let out_wipe = Secret.from_bytes(outer);
  let ih_wipe = Secret.from_bytes(inner_hash);
  return out;
}

pub fn hkdf_extract_sha256(salt: Option<Secret>, ikm: &Secret) -> HkdfSha256Prk
  intent "HKDF-SHA-256 の Extract で擬似乱数鍵 PRK を作る"
  requires none
  ensures none
  effects none
{
  // 省略（`None`）は空の鍵として扱う。HMAC は鍵を 64 バイトへゼロ詰めする
  // ので、空の鍵と HashLen 個のゼロは同じ鍵（RFC 5869 §2.2 と同値）。
  // こうすると、salt の有無による分岐が要らない（対象表の規則 R1）。
  let sb = salt.map(|s| s.expose()).unwrap_or(Bytes.new());
  let ikm_b = ikm.expose();
  let prk = hmac_any_key(&sb, &ikm_b);
  let ret = HkdfSha256Prk { key: Secret.from_bytes(prk) };
  let sb_wipe = Secret.from_bytes(sb);
  let ikm_wipe = Secret.from_bytes(ikm_b);
  return ret;
}

pub fn hkdf_expand_sha256(prk: &HkdfSha256Prk, info: &Bytes, out_len: Int) -> Secret
  intent "HKDF-SHA-256 の Expand で出力鍵素材 OKM を作る"
  requires out_len >= 0 && out_len <= 8160
  ensures result.byte_len() == out_len
  effects none
{
  let kb = prk.key.expose();
  let blocks = (out_len + 31) / 32;
  let mut okm = Bytes.new();
  let mut t = Bytes.new();
  let mut n = 1;
  while n <= blocks {
    let mut msg = t.clone();
    msg.extend(&info);
    msg.push(n);
    let next_t = hmac_any_key(&kb, &msg);
    let msg_wipe = Secret.from_bytes(msg);
    let old_t_wipe = Secret.from_bytes(t);
    t = next_t;
    okm.extend(&t);
    n = n + 1;
  }
  let out = okm.slice(0, out_len).unwrap_or(Bytes.new());
  let ret = Secret.from_bytes(out);
  let t_wipe = Secret.from_bytes(t);
  let okm_wipe = Secret.from_bytes(okm);
  let kb_wipe = Secret.from_bytes(kb);
  return ret;
}

// ---------------------------------------------------------------------------
// AES-128-GCM（ADR 0058 決定 2・3、段 1b）。FIPS 197・NIST SP 800-38D。
//
// 公開するのは鍵型 `Aes128GcmKey`・12 バイトの nonce 型 `Nonce96`・誤りの列挙
// `AeadError` と、`aes128_gcm_seal`・`aes128_gcm_open` の 2 関数だけ。AES の
// ブロック演算・鍵展開と GHASH は内部部品で、汎用ブロック API は公開しない。
//
// 定数時間（ADR 0058 決定 3）: S-box は表引きをせず、GF(2^8) の逆元
// （x^254、0 は 0 のまま）とアフィン変換を固定の演算列で計算する。GF(2^8) と
// GF(2^128) の乗算は、ビットごとにマスク（0 か全ビット 1）で足し込むだけで、
// 秘密による分岐・添字・シフト量・除算を持たない。ループの回数と添字はブロック数・
// ラウンド数などの公開の長さだけから決まる。公開なのは、データの長さ、nonce、
// AAD、受信した暗号文とタグ、鍵の長さ。タグの照合は `ct_eq` で全バイトを処理し、
// 成功・失敗の 1 ビットだけを公開する。認証に成功したときだけ平文を復号して返す。
//
// 長さの上限（NIST SP 800-38D §5.2.1.1）: 平文は 2^36 − 32 バイト（カウンタが
// 32 ビットで折り返さない上限）、AAD は 2^61 − 1 バイトまで。超えると
// `InputTooLong`。短すぎる入力（タグ 16 バイト未満）は `InputTooShort`、鍵・nonce の
// 長さ違反は型を作る入口が `InvalidKeyLength`・`InvalidNonceLength` で返す。
//
// nonce の一意性の契約: `seal` は nonce の値の所有権を取る。同じ鍵で同じ nonce を
// 2 回使うと機密性・認証が壊れるため、同一鍵で nonce を重ねないことは呼び出し側
// （TLS 側ではシーケンス番号からの構成）の契約。

pub enum AeadError {
  InvalidKeyLength,
  InvalidNonceLength,
  InputTooShort,
  InputTooLong,
  AuthenticationFailed,
}

pub struct Aes128GcmKey {
  key: Secret,
}

pub struct Nonce96 {
  bytes: Bytes,
}

impl Aes128GcmKey {
  // 範囲: 16 バイトの秘密を鍵として取り込む（所有権を取る）。長さが違えば誤り。
  pub fn from_secret(key: Secret) -> Result<Aes128GcmKey, AeadError>
    intent "16 バイトの秘密から AES-128-GCM の鍵を作る"
    requires none
    ensures none
    effects none
  {
    if key.byte_len() != 16 {
      return Err(AeadError.InvalidKeyLength);
    }
    return Ok(Aes128GcmKey { key: key });
  }
}

impl Nonce96 {
  // 範囲: 12 バイトの nonce（公開の値）を作る。長さが違えば誤り。
  pub fn from_slice(b: &Bytes) -> Result<Nonce96, AeadError>
    intent "12 バイトのバイト列から nonce を作る"
    requires none
    ensures none
    effects none
  {
    if b.byte_len() != 12 {
      return Err(AeadError.InvalidNonceLength);
    }
    return Ok(Nonce96 { bytes: b.clone() });
  }
}

// 範囲: GF(2^8) での 2 倍（xtime）。既約多項式 x^8 + x^4 + x^3 + x + 1。
fn aes_xtime(v: Int) -> Int
  intent "GF(2^8) で 2 を掛ける（定数時間）"
  requires none
  ensures none
  effects none
{
  let hi = (v >> 7) & 1;
  return ((v << 1) & 0xFF) ^ ((0 - hi) & 0x1B);
}

// 範囲: GF(2^8) の乗算。8 回固定で、乗数の各ビットをマスクにして足し込む。
fn aes_gmul(a: Int, b: Int) -> Int
  intent "GF(2^8) で a と b を掛ける（定数時間）"
  requires none
  ensures none
  effects none
{
  let mut p = 0;
  let mut x = a;
  let mut y = b;
  let mut i = 0;
  while i < 8 {
    let m = (0 - (y & 1)) & 0xFF;
    p = p ^ (x & m);
    x = aes_xtime(x);
    y = y >> 1;
    i = i + 1;
  }
  return p;
}

// 範囲: S-box。逆元 x^254（x^2 から x^128 までの積。0 は 0）にアフィン変換を
// かける。表引きはしない。
fn aes_sbox(x: Int) -> Int
  intent "AES の S-box を表引きなしで計算する（定数時間）"
  requires none
  ensures none
  effects none
{
  let x2 = aes_gmul(x, x);
  let x4 = aes_gmul(x2, x2);
  let x8 = aes_gmul(x4, x4);
  let x16 = aes_gmul(x8, x8);
  let x32 = aes_gmul(x16, x16);
  let x64 = aes_gmul(x32, x32);
  let x128 = aes_gmul(x64, x64);
  let mut inv = aes_gmul(x2, x4);
  inv = aes_gmul(inv, x8);
  inv = aes_gmul(inv, x16);
  inv = aes_gmul(inv, x32);
  inv = aes_gmul(inv, x64);
  inv = aes_gmul(inv, x128);
  let r1 = ((inv << 1) | (inv >> 7)) & 0xFF;
  let r2 = ((inv << 2) | (inv >> 6)) & 0xFF;
  let r3 = ((inv << 3) | (inv >> 5)) & 0xFF;
  let r4 = ((inv << 4) | (inv >> 4)) & 0xFF;
  return inv ^ r1 ^ r2 ^ r3 ^ r4 ^ 0x63;
}

// 範囲: 鍵展開。16 バイトの鍵から、11 個のラウンド鍵（16 バイトずつ、計 176 バイト）を
// 並べた一覧を作る。
fn aes_expand_key(key: &Bytes) -> List<Int>
  intent "AES-128 の鍵展開（ラウンド鍵 176 バイトの一覧）を返す"
  requires none
  ensures none
  effects none
{
  let mut w = List.new();
  let mut i = 0;
  while i < 16 {
    w.push(key.get(i).map(|x| x + 0).unwrap_or(0));
    i = i + 1;
  }
  let mut rc = 1;
  let mut n = 4;
  while n < 44 {
    let p = (n - 1) * 4;
    let mut t0 = w.get(p).map(|x| x + 0).unwrap_or(0);
    let mut t1 = w.get(p + 1).map(|x| x + 0).unwrap_or(0);
    let mut t2 = w.get(p + 2).map(|x| x + 0).unwrap_or(0);
    let mut t3 = w.get(p + 3).map(|x| x + 0).unwrap_or(0);
    if n % 4 == 0 {
      let u0 = aes_sbox(t1) ^ rc;
      let u1 = aes_sbox(t2);
      let u2 = aes_sbox(t3);
      let u3 = aes_sbox(t0);
      t0 = u0;
      t1 = u1;
      t2 = u2;
      t3 = u3;
      rc = aes_xtime(rc);
    }
    let q = (n - 4) * 4;
    let n0 = w.get(q).map(|x| x + 0).unwrap_or(0) ^ t0;
    let n1 = w.get(q + 1).map(|x| x + 0).unwrap_or(0) ^ t1;
    let n2 = w.get(q + 2).map(|x| x + 0).unwrap_or(0) ^ t2;
    let n3 = w.get(q + 3).map(|x| x + 0).unwrap_or(0) ^ t3;
    w.push(n0);
    w.push(n1);
    w.push(n2);
    w.push(n3);
    n = n + 1;
  }
  return w;
}

// 範囲: 16 バイトのブロックを 1 つ暗号化する（ラウンド鍵は `aes_expand_key` の結果）。
// 状態の並びは FIPS 197 のとおり（列優先、入力の並びのまま）。
fn aes_encrypt_block(rk: &List<Int>, block: &Bytes) -> Bytes
  intent "AES-128 で 16 バイトのブロックを暗号化する"
  requires none
  ensures result.byte_len() == 16
  effects none
{
  let mut s = List.new();
  let mut i = 0;
  while i < 16 {
    s.push(block.get(i).map(|x| x + 0).unwrap_or(0) ^ rk.get(i).map(|x| x + 0).unwrap_or(0));
    i = i + 1;
  }
  let mut round = 1;
  while round < 11 {
    let mut t = List.new();
    let mut c = 0;
    while c < 4 {
      let mut r = 0;
      while r < 4 {
        let idx = r + 4 * ((c + r) % 4);
        t.push(aes_sbox(s.get(idx).map(|x| x + 0).unwrap_or(0)));
        r = r + 1;
      }
      c = c + 1;
    }
    let mut u = t.clone();
    if round < 10 {
      let mut m = List.new();
      let mut col = 0;
      while col < 4 {
        let a0 = t.get(col * 4).map(|x| x + 0).unwrap_or(0);
        let a1 = t.get(col * 4 + 1).map(|x| x + 0).unwrap_or(0);
        let a2 = t.get(col * 4 + 2).map(|x| x + 0).unwrap_or(0);
        let a3 = t.get(col * 4 + 3).map(|x| x + 0).unwrap_or(0);
        m.push(aes_xtime(a0) ^ aes_xtime(a1) ^ a1 ^ a2 ^ a3);
        m.push(a0 ^ aes_xtime(a1) ^ aes_xtime(a2) ^ a2 ^ a3);
        m.push(a0 ^ a1 ^ aes_xtime(a2) ^ aes_xtime(a3) ^ a3);
        m.push(aes_xtime(a0) ^ a0 ^ a1 ^ a2 ^ aes_xtime(a3));
        col = col + 1;
      }
      u = m;
    }
    let mut next = List.new();
    let mut k = 0;
    while k < 16 {
      next.push(u.get(k).map(|x| x + 0).unwrap_or(0) ^ rk.get(round * 16 + k).map(|x| x + 0).unwrap_or(0));
      k = k + 1;
    }
    s = next;
    round = round + 1;
  }
  let mut out = Bytes.new();
  let mut j = 0;
  while j < 16 {
    out.push(s.get(j).map(|x| x + 0).unwrap_or(0));
    j = j + 1;
  }
  return out;
}

// 範囲: GF(2^128) の乗算（GHASH の「・」）。4 語 × 32 ビットの 128 回固定（除算を使わない二重ループ）で、x の各ビットをマスクに
// して v（h を 1 ビットずつ右へ送ったもの）を足し込む。128 ビットは 32 ビットの 4 語
// （先頭の語が上位）で持つ。簡約定数は 0xE1 を先頭の語の上位へ置く形。
fn ghash_mul(xv: &List<Int>, hv: &List<Int>) -> List<Int>
  intent "GF(2^128) で x と h を掛ける（定数時間）"
  requires none
  ensures none
  effects none
{
  let mut z0 = 0;
  let mut z1 = 0;
  let mut z2 = 0;
  let mut z3 = 0;
  let mut v0 = hv.get(0).map(|x| x + 0).unwrap_or(0);
  let mut v1 = hv.get(1).map(|x| x + 0).unwrap_or(0);
  let mut v2 = hv.get(2).map(|x| x + 0).unwrap_or(0);
  let mut v3 = hv.get(3).map(|x| x + 0).unwrap_or(0);
  let mut wi = 0;
  while wi < 4 {
    let xl = xv.get(wi).map(|x| x + 0).unwrap_or(0);
    let mut bi = 0;
    while bi < 32 {
      let bit = (xl >> (31 - bi)) & 1;
      let m = (0 - bit) & 0xFFFFFFFF;
      z0 = z0 ^ (v0 & m);
      z1 = z1 ^ (v1 & m);
      z2 = z2 ^ (v2 & m);
      z3 = z3 ^ (v3 & m);
      let red = (0 - (v3 & 1)) & 0xE1000000;
      v3 = ((v3 >> 1) | ((v2 & 1) << 31)) & 0xFFFFFFFF;
      v2 = ((v2 >> 1) | ((v1 & 1) << 31)) & 0xFFFFFFFF;
      v1 = ((v1 >> 1) | ((v0 & 1) << 31)) & 0xFFFFFFFF;
      v0 = ((v0 >> 1) ^ red) & 0xFFFFFFFF;
      bi = bi + 1;
    }
    wi = wi + 1;
  }
  let mut out = List.new();
  out.push(z0);
  out.push(z1);
  out.push(z2);
  out.push(z3);
  return out;
}

// 範囲: `data` の `off` バイト目から 16 バイトを、足りない分は 0 で埋めて 4 語にする。
fn ghash_words(data: &Bytes, off: Int) -> List<Int>
  intent "16 バイト（不足は 0 埋め）を 32 ビットの 4 語へ読む"
  requires none
  ensures none
  effects none
{
  let mut out = List.new();
  let mut k = 0;
  while k < 4 {
    let b0 = data.get(off + k * 4).map(|x| x + 0).unwrap_or(0);
    let b1 = data.get(off + k * 4 + 1).map(|x| x + 0).unwrap_or(0);
    let b2 = data.get(off + k * 4 + 2).map(|x| x + 0).unwrap_or(0);
    let b3 = data.get(off + k * 4 + 3).map(|x| x + 0).unwrap_or(0);
    out.push((b0 << 24) | (b1 << 16) | (b2 << 8) | b3);
    k = k + 1;
  }
  return out;
}

// 範囲: GHASH の 1 ブロック分の更新 y = (y ^ blk) ・ h。
fn ghash_step(y: &List<Int>, blk: &List<Int>, hv: &List<Int>) -> List<Int>
  intent "GHASH の状態を 1 ブロック分更新する"
  requires none
  ensures none
  effects none
{
  let mut xr = List.new();
  let mut j = 0;
  while j < 4 {
    xr.push(y.get(j).map(|x| x + 0).unwrap_or(0) ^ blk.get(j).map(|x| x + 0).unwrap_or(0));
    j = j + 1;
  }
  return ghash_mul(&xr, &hv);
}

// 範囲: GHASH(h, aad, ct)。AAD と暗号文をそれぞれ 16 バイトに 0 埋めして
// 順に畳み込み、最後に両方のビット長の 64 ビット並び（長さのブロック）を畳む。
// 結果は 16 バイト。
fn ghash(hv: &List<Int>, aad: &Bytes, ct: &Bytes) -> Bytes
  intent "GHASH を計算する（16 バイト）"
  requires none
  ensures result.byte_len() == 16
  effects none
{
  let mut y = List.new();
  y.push(0);
  y.push(0);
  y.push(0);
  y.push(0);
  let na = (aad.byte_len() + 15) / 16;
  let mut b = 0;
  while b < na {
    let blk = ghash_words(&aad, b * 16);
    y = ghash_step(&y, &blk, &hv);
    b = b + 1;
  }
  let nc = (ct.byte_len() + 15) / 16;
  let mut c = 0;
  while c < nc {
    let blk = ghash_words(&ct, c * 16);
    y = ghash_step(&y, &blk, &hv);
    c = c + 1;
  }
  let abits = aad.byte_len() * 8;
  let cbits = ct.byte_len() * 8;
  let mut lens = List.new();
  lens.push((abits >> 32) & 0xFFFFFFFF);
  lens.push(abits & 0xFFFFFFFF);
  lens.push((cbits >> 32) & 0xFFFFFFFF);
  lens.push(cbits & 0xFFFFFFFF);
  y = ghash_step(&y, &lens, &hv);
  let mut out = Bytes.new();
  out.push_u32_be(y.get(0).map(|x| x + 0).unwrap_or(0));
  out.push_u32_be(y.get(1).map(|x| x + 0).unwrap_or(0));
  out.push_u32_be(y.get(2).map(|x| x + 0).unwrap_or(0));
  out.push_u32_be(y.get(3).map(|x| x + 0).unwrap_or(0));
  return out;
}

// 範囲: CTR モード。カウンタ領域の 32 ビット値はブロック番号 + 2（J0 の次から）。
// `data` の各バイトにキーストリームを XOR する。出力の長さは入力と同じ。
fn gcm_ctr_xor(rk: &List<Int>, nonce: &Bytes, data: &Bytes) -> Bytes
  intent "AES-GCM の CTR 部（カウンタは 2 から）で data へキーストリームを掛ける"
  requires none
  ensures result.byte_len() == data.byte_len()
  effects none
{
  let mut out = Bytes.new();
  let blocks = (data.byte_len() + 15) / 16;
  let mut b = 0;
  while b < blocks {
    let mut cb = nonce.clone();
    cb.push_u32_be(b + 2);
    let ks = aes_encrypt_block(&rk, &cb);
    let mut j = 0;
    while j < 16 {
      let idx = b * 16 + j;
      if idx < data.byte_len() {
        out.push(data.get(idx).map(|x| x + 0).unwrap_or(0) ^ ks.get(j).map(|x| x + 0).unwrap_or(0));
      }
      j = j + 1;
    }
    b = b + 1;
  }
  return out;
}

// 範囲: 認証タグ = GHASH(h, aad, ct) ^ E(K, J0)。h = E(K, 0^128)、J0 = nonce || 0x00000001。
fn gcm_tag(rk: &List<Int>, nonce: &Bytes, aad: &Bytes, ct: &Bytes) -> Bytes
  intent "AES-GCM の認証タグ（16 バイト）を計算する"
  requires none
  ensures result.byte_len() == 16
  effects none
{
  let mut zero = Bytes.new();
  let mut z = 0;
  while z < 16 {
    zero.push(0);
    z = z + 1;
  }
  let hb = aes_encrypt_block(&rk, &zero);
  let hv = ghash_words(&hb, 0);
  let gh = ghash(&hv, &aad, &ct);
  let mut j0 = nonce.clone();
  j0.push_u32_be(1);
  let ek = aes_encrypt_block(&rk, &j0);
  let mut tag = Bytes.new();
  let mut i = 0;
  while i < 16 {
    tag.push(gh.get(i).map(|x| x + 0).unwrap_or(0) ^ ek.get(i).map(|x| x + 0).unwrap_or(0));
    i = i + 1;
  }
  return tag;
}

// 範囲: タグの照合。全バイトを処理する定数時間比較の結果（1 ビット）だけを返す。
fn aes128_gcm_tag_matches(expected: &Bytes, got: &Bytes) -> Bool
  intent "AES-GCM のタグを定数時間で照合する"
  requires none
  ensures none
  effects none
{
  return ct_eq(&expected, &got);
}

pub fn aes128_gcm_seal(key: &Aes128GcmKey, nonce: Nonce96, aad: &Bytes, plaintext: &Secret) -> Result<Bytes, AeadError>
  intent "AES-128-GCM で暗号化し、暗号文にタグ 16 バイトを連結して返す"
  requires none
  ensures none
  effects none
{
  if plaintext.byte_len() > 68719476704 {
    return Err(AeadError.InputTooLong);
  }
  if aad.byte_len() > 2305843009213693951 {
    return Err(AeadError.InputTooLong);
  }
  let kb = key.key.expose();
  let rk = aes_expand_key(&kb);
  let pt = plaintext.expose();
  let ct = gcm_ctr_xor(&rk, &nonce.bytes, &pt);
  let tag = gcm_tag(&rk, &nonce.bytes, &aad, &ct);
  let mut out = ct;
  out.extend(&tag);
  return Ok(out);
}

pub fn aes128_gcm_open(key: &Aes128GcmKey, nonce: &Nonce96, aad: &Bytes, sealed: &Bytes) -> Result<Secret, AeadError>
  intent "AES-128-GCM のタグを検証し、成功したときだけ復号した平文を返す"
  requires none
  ensures none
  effects none
{
  if sealed.byte_len() < 16 {
    return Err(AeadError.InputTooShort);
  }
  let ct_len = sealed.byte_len() - 16;
  if ct_len > 68719476704 {
    return Err(AeadError.InputTooLong);
  }
  if aad.byte_len() > 2305843009213693951 {
    return Err(AeadError.InputTooLong);
  }
  let ct = sealed.slice(0, ct_len).unwrap_or(Bytes.new());
  let got = sealed.slice(ct_len, sealed.byte_len()).unwrap_or(Bytes.new());
  let kb = key.key.expose();
  let rk = aes_expand_key(&kb);
  let want = gcm_tag(&rk, &nonce.bytes, &aad, &ct);
  if aes128_gcm_tag_matches(&want, &got) {
    let pt = gcm_ctr_xor(&rk, &nonce.bytes, &ct);
    return Ok(Secret.from_bytes(pt));
  }
  return Err(AeadError.AuthenticationFailed);
}
